@model SmartRoom.Controllers.RegisterViewModel
@{
    ViewData["Title"] = "Pendaftaran Akun Mahasiswa";
    Layout = null;
}
<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-900">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Daftar Akun — SmartRoom</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; letter-spacing: -0.012em; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
    </style>
</head>
<body class="h-full flex items-center justify-center p-4 antialiased bg-slate-950 text-slate-100">

    <div class="w-full max-w-lg my-8">
        <!-- Brand Header -->
        <div class="text-center mb-6">
            <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-emerald-500 text-slate-950 font-bold mb-2 shadow-lg shadow-emerald-500/25">
                <i data-lucide="user-plus" class="w-5 h-5 text-slate-950"></i>
            </div>
            <h1 class="text-xl font-bold tracking-tight text-white">Pendaftaran Akun Civitas</h1>
            <p class="text-xs text-slate-400 mt-1">Daftar akun untuk melakukan reservasi dan peminjaman ruangan</p>
        </div>

        <!-- Register Card -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl backdrop-blur-xl">
            <form asp-action="Register" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="p-3 rounded-lg bg-rose-950/60 border border-rose-800 text-rose-300 text-xs"></div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold uppercase font-mono tracking-wider text-slate-300 mb-1">
                            Username <span class="text-rose-400">*</span>
                        </label>
                        <input asp-for="Username" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white placeholder-slate-600 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none"
                               placeholder="contoh: reiky123" required />
                        <span asp-validation-for="Username" class="text-rose-400 text-[10px]"></span>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase font-mono tracking-wider text-slate-300 mb-1">
                            Email Kampus <span class="text-rose-400">*</span>
                        </label>
                        <input asp-for="Email" type="email" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white placeholder-slate-600 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none font-mono"
                               placeholder="nama@students.ac.id" required />
                        <span asp-validation-for="Email" class="text-rose-400 text-[10px]"></span>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase font-mono tracking-wider text-slate-300 mb-1">
                        Nama Lengkap <span class="text-rose-400">*</span>
                    </label>
                    <input asp-for="FullName" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white placeholder-slate-600 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none"
                           placeholder="Nama Lengkap Anda" required />
                    <span asp-validation-for="FullName" class="text-rose-400 text-[10px]"></span>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase font-mono tracking-wider text-slate-300 mb-1">
                        Program Studi / Organisasi <span class="text-rose-400">*</span>
                    </label>
                    <input asp-for="Department" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white placeholder-slate-600 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none"
                           placeholder="Contoh: S1 Informatika / BEM Fakultas TI" required />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold uppercase font-mono tracking-wider text-slate-300 mb-1">
                            Kata Sandi <span class="text-rose-400">*</span>
                        </label>
                        <input asp-for="Password" type="password" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white placeholder-slate-600 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none"
                               placeholder="Minimal 6 karakter" required />
                        <span asp-validation-for="Password" class="text-rose-400 text-[10px]"></span>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase font-mono tracking-wider text-slate-300 mb-1">
                            Konfirmasi Sandi <span class="text-rose-400">*</span>
                        </label>
                        <input asp-for="ConfirmPassword" type="password" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white placeholder-slate-600 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none"
                               placeholder="Ulangi sandi" required />
                        <span asp-validation-for="ConfirmPassword" class="text-rose-400 text-[10px]"></span>
                    </div>
                </div>

                <button type="submit" class="w-full py-2.5 px-4 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs tracking-wider uppercase font-mono shadow-lg shadow-emerald-500/20 transition-all flex items-center justify-center gap-2 mt-4">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    <span>Daftarkan Akun</span>
                </button>
            </form>

            <div class="mt-4 text-center text-xs text-slate-400 border-t border-slate-800/80 pt-4">
                Sudah punya akun?
                <a asp-action="Login" class="text-emerald-400 hover:text-emerald-300 font-semibold underline underline-offset-2 ml-1">
                    Kembali ke Login
                </a>
            </div>
        </div>
    </div>

    <script>lucide.createIcons();</script>
</body>
</html>
