@model SmartRoom.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Masuk ke SmartRoom";
    Layout = null;
}
<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Masuk — SmartRoom macOS 27</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- SmartRoom macOS 27 Liquid Glass Design System CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="min-h-full flex items-center justify-center p-4 sm:p-6 antialiased selection:bg-[#007AFF] selection:text-white">

    <div class="w-full max-w-md relative z-10 space-y-6 my-8">
        
        <!-- Brand Header -->
        <div class="text-center space-y-2">
            <a href="/" class="inline-flex items-center gap-2.5 group">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-b from-[#2C2C2E] to-[#1C1C1E] text-white flex items-center justify-center font-bold text-lg shadow-md group-hover:scale-105 transition-transform duration-200">
                    <span class="font-mono">S</span>
                </div>
            </a>
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#1D1D1F]">
                Masuk ke SmartRoom
            </h1>
            <p class="text-xs text-[#515154]">
                Sistem Peminjaman Ruangan &amp; Otentikasi Role-Based Access Control
            </p>
        </div>

        <!-- Liquid Glass Login Card -->
        <div class="liquid-glass-elevated p-6 sm:p-8">
            
            <!-- Toast Feedback -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mb-5 p-3 rounded-2xl bg-[#34C759]/15 border border-[#34C759]/30 text-[#116329] text-xs flex items-center gap-2">
                    <i data-lucide="check-circle" class="w-4 h-4 text-[#34C759] flex-shrink-0"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }

            <form asp-action="Login" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="p-3.5 rounded-2xl bg-[#FF3B30]/15 border border-[#FF3B30]/30 text-[#C91E14] text-xs font-mono"></div>

                <!-- Username Input -->
                <div>
                    <label class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-[#515154] mb-1.5">
                        Username atau Email
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-[#86868B] pointer-events-none">
                            <i data-lucide="user" class="w-4 h-4"></i>
                        </span>
                        <input asp-for="Username" id="inputUsername" 
                               class="liquid-glass-input w-full pl-10 pr-4 py-2.5 text-xs font-mono"
                               placeholder="admin / staff / student" required autofocus />
                    </div>
                </div>

                <!-- Password Input -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-[#515154]">
                            Kata Sandi (Password)
                        </label>
                    </div>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-[#86868B] pointer-events-none">
                            <i data-lucide="lock" class="w-4 h-4"></i>
                        </span>
                        <input asp-for="Password" id="inputPassword" type="password" 
                               class="liquid-glass-input w-full pl-10 pr-10 py-2.5 text-xs font-mono"
                               placeholder="••••••••" required />
                        <button type="button" onclick="togglePassword()" 
                                class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-[#86868B] hover:text-[#1D1D1F]">
                            <i data-lucide="eye" id="eyeIcon" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>

                <!-- Remember Me -->
                <div class="flex items-center justify-between text-xs pt-1">
                    <label class="flex items-center gap-2 cursor-pointer text-[#515154] hover:text-[#1D1D1F]">
                        <input asp-for="RememberMe" type="checkbox" class="w-4 h-4 rounded border-gray-300 text-[#007AFF] focus:ring-[#007AFF]">
                        <span class="text-[11px]">Ingat saya selama 30 hari</span>
                    </label>
                </div>

                <!-- Submit Button (Apple Prominence Pill) -->
                <button type="submit" 
                        class="liquid-btn-primary w-full py-2.5 justify-center mt-2">
                    <i data-lucide="log-in" class="w-4 h-4 text-white"></i>
                    <span>Masuk ke Akun</span>
                </button>
            </form>

            <!-- 1-Click Test Credentials Grid (Apple Segmented Style) -->
            <div class="mt-6 pt-5 border-t border-black/[0.05]">
                <div class="text-[10px] font-mono uppercase tracking-wider text-[#86868B] text-center mb-2.5 font-semibold">
                    Akun Pengujian Demo (1-Klik Isi):
                </div>
                <div class="grid grid-cols-3 gap-2">
                    <button type="button" onclick="fillCreds('admin', 'admin123')" 
                            class="p-2.5 rounded-xl bg-white/60 hover:bg-white border border-white/80 shadow-xs text-left transition-all hover:-translate-y-0.5 group">
                        <div class="text-[10px] font-mono font-bold text-[#C91E14] flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#FF3B30]"></span> Admin
                        </div>
                        <div class="text-[9px] text-[#86868B] font-mono mt-0.5 group-hover:text-[#1D1D1F]">admin123</div>
                    </button>

                    <button type="button" onclick="fillCreds('staff', 'staff123')" 
                            class="p-2.5 rounded-xl bg-white/60 hover:bg-white border border-white/80 shadow-xs text-left transition-all hover:-translate-y-0.5 group">
                        <div class="text-[10px] font-mono font-bold text-[#0062CC] flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#007AFF]"></span> Staff
                        </div>
                        <div class="text-[9px] text-[#86868B] font-mono mt-0.5 group-hover:text-[#1D1D1F]">staff123</div>
                    </button>

                    <button type="button" onclick="fillCreds('student', 'student123')" 
                            class="p-2.5 rounded-xl bg-white/60 hover:bg-white border border-white/80 shadow-xs text-left transition-all hover:-translate-y-0.5 group">
                        <div class="text-[10px] font-mono font-bold text-[#116329] flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#34C759]"></span> Student
                        </div>
                        <div class="text-[9px] text-[#86868B] font-mono mt-0.5 group-hover:text-[#1D1D1F]">student123</div>
                    </button>
                </div>
            </div>

            <!-- Register Link -->
            <div class="mt-4 pt-4 border-t border-black/[0.05] text-center">
                <span class="text-xs text-[#515154]">Belum punya akun civitas?</span>
                <a asp-action="Register" class="text-xs font-semibold text-[#007AFF] hover:underline ml-1">
                    Daftar di sini
                </a>
            </div>
        </div>

        <div class="text-center">
            <a href="/" class="text-xs font-mono text-[#86868B] hover:text-[#1D1D1F] transition-colors inline-flex items-center gap-1.5">
                <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
                <span>Kembali ke Halaman Utama</span>
            </a>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        function fillCreds(u, p) {
            document.getElementById('inputUsername').value = u;
            document.getElementById('inputPassword').value = p;
        }

        function togglePassword() {
            const pwd = document.getElementById('inputPassword');
            const eye = document.getElementById('eyeIcon');
            if (pwd.type === 'password') {
                pwd.type = 'text';
                eye.setAttribute('data-lucide', 'eye-off');
            } else {
                pwd.type = 'password';
                eye.setAttribute('data-lucide', 'eye');
            }
            if (window.lucide) lucide.createIcons();
        }

        document.addEventListener('DOMContentLoaded', function () {
            if (window.lucide) {
                window.lucide.createIcons();
            }
        });
    </script>
</body>
</html>
