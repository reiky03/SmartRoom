@{
    ViewData["Title"] = "Akses Ditolak (403 Forbidden)";
}

<div class="max-w-md mx-auto my-12 text-center">
    <div class="p-8 rounded-2xl bg-white border border-zinc-200/80 shadow-xs">
        <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 border border-rose-200 flex items-center justify-center mx-auto mb-4">
            <i data-lucide="shield-alert" class="w-6 h-6"></i>
        </div>
        <div class="text-[10px] font-mono uppercase text-zinc-400 font-bold tracking-wider mb-1">
            HTTP 403 &bull; AKSES DITOLAK
        </div>
        <h2 class="text-lg font-bold text-zinc-950 tracking-tight mb-2">Halaman Terbatas untuk Administrator</h2>
        <p class="text-xs text-zinc-500 mb-6 leading-relaxed">
            Akun Anda saat ini memiliki peran <strong class="text-zinc-800">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Civitas")</strong> yang tidak memiliki izin untuk mengakses modul persetujuan atau konfigurasi ruangan.
        </p>

        <div class="p-4 rounded-xl bg-zinc-50 border border-zinc-200 text-left mb-6 text-xs text-zinc-600">
            <div class="font-semibold text-zinc-900 mb-1">Ingin Menguji Akses Admin?</div>
            <p class="text-[11px] text-zinc-500 mb-3">Klik tombol cepat di bawah ini untuk langsung beralih ke akun Administrator pengujian:</p>
            
            <form asp-controller="Account" asp-action="QuickSwitch" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="targetRole" value="admin" />
                <button type="submit" class="w-full py-2 px-3 rounded-lg bg-zinc-900 hover:bg-zinc-800 text-white font-mono text-xs font-semibold shadow-xs transition-all flex items-center justify-center gap-2">
                    <span>👑 Beralih ke Admin Sekarang</span>
                </button>
            </form>
        </div>

        <div class="flex items-center justify-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="px-4 py-2 rounded-xl border border-zinc-200 hover:bg-zinc-50 text-xs font-medium text-zinc-700 transition-colors">
                Kembali ke Dashboard
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-500 text-xs font-medium text-white shadow-xs transition-colors">
                    Keluar Akun
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.lucide) {
                window.lucide.createIcons();
            }
        });
    </script>
}