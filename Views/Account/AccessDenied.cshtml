@{
    ViewData["Title"] = "Akses Ditolak (403 Forbidden)";
}

<div class="max-w-md mx-auto my-12 text-center">
    <div class="p-8 rounded-2xl bg-white border border-slate-200 shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 border border-rose-200 flex items-center justify-center mx-auto mb-4">
            <i data-lucide="shield-alert" class="w-6 h-6"></i>
        </div>
        <div class="text-[11px] font-mono uppercase text-slate-400 font-bold tracking-wider mb-1">
            HTTP 403 &bull; AKSES DITOLAK
        </div>
        <h2 class="text-lg font-bold text-slate-900 tracking-tight mb-2">Halaman Terbatas untuk Administrator</h2>
        <p class="text-xs text-slate-500 mb-6 leading-relaxed">
            Akun Anda saat ini memiliki peran <strong class="text-slate-800">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Civitas")</strong> yang tidak memiliki izin untuk mengakses modul persetujuan atau konfigurasi ruangan.
        </p>

        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-left mb-6 text-xs text-slate-600">
            <div class="font-semibold text-slate-800 mb-1">Perlu Hak Akses Admin?</div>
            <p class="text-[11px] text-slate-500 mb-3">Untuk menguji modul Administrator, silakan keluar lalu masuk menggunakan akun Admin:</p>
            <div class="font-mono text-[11px] p-2 rounded bg-white border border-slate-200 text-slate-700">
                Username: <strong class="text-slate-900">admin</strong> &bull; Sandi: <strong class="text-slate-900">admin123</strong>
            </div>
        </div>

        <div class="flex items-center justify-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="px-4 py-2 rounded-lg border border-slate-200 hover:bg-slate-50 text-xs font-semibold text-slate-700 transition-colors">
                Kembali ke Dashboard
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="px-4 py-2 rounded-lg bg-rose-600 hover:bg-rose-500 text-xs font-semibold text-white shadow-sm transition-colors">
                    Keluar &amp; Ganti Akun
                </button>
            </form>
        </div>
    </div>
</div>
