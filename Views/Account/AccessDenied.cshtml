@{
    ViewData["Title"] = "Akses Ditolak (403 Forbidden)";
}

<div class="row justify-content-center py-5 text-center">
    <div class="col-12 col-md-6 col-lg-5">
        <div class="card-minimal p-5 bg-white">
            <span class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle mb-3" style="width: 56px; height: 56px;">
                <i class="bi bi-shield-x fs-2"></i>
            </span>
            <div class="font-mono text-muted small mb-1">HTTP 403 &bull; ROLE-BASED ACCESS CONTROL</div>
            <h4 class="fw-bold text-dark mb-2">Halaman Ini Terbatas untuk Administrator</h4>
            <p class="text-muted small mb-4">
                Peran Anda saat ini tidak memiliki izin yang cukup untuk mengakses halaman manajemen atau tindakan persetujuan ini.
            </p>

            <div class="p-3 bg-light rounded-3 border text-start mb-4">
                <div class="small fw-semibold text-dark mb-1">Ingin menguji fitur ini?</div>
                <div class="small text-muted mb-2">Gunakan 1-Klik Persona Switcher untuk beralih ke akun Administrator:</div>
                <a asp-controller="Account" asp-action="SwitchRole" asp-route-role="Admin" asp-route-returnUrl="@Context.Request.Path"
                   class="btn btn-sm btn-minimal-primary w-100">
                    <i class="bi bi-arrow-repeat me-1"></i> Beralih Jadi Administrator &amp; Lanjutkan
                </a>
            </div>

            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-minimal-secondary px-4">
                    Kembali ke Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
