@{
    ViewData["Title"] = "Akses Ditolak (403 Forbidden)";
}

<div class="max-w-md mx-auto my-12 text-center">
    <div class="liquid-glass-elevated p-8">
        <div class="liquid-squircle-icon bg-[#FF3B30]/15 text-[#FF3B30] mx-auto mb-4 !w-14 !h-14">
            <i data-lucide="shield-alert" class="w-7 h-7"></i>
        </div>
        <div class="text-[10px] font-mono uppercase text-[#86868B] font-bold tracking-wider mb-1">
            HTTP 403 &bull; AKSES DITOLAK
        </div>
        <h2 class="text-xl font-bold text-[#1D1D1F] tracking-tight mb-2">Halaman Terbatas untuk Administrator</h2>
        <p class="text-xs text-[#515154] mb-6 leading-relaxed">
            Akun Anda saat ini memiliki peran <strong class="text-[#1D1D1F]">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Civitas")</strong> yang tidak memiliki izin untuk mengakses modul persetujuan atau konfigurasi ruangan.
        </p>

        <div class="p-4 rounded-2xl bg-white/70 border border-white/80 text-left mb-6 text-xs text-[#515154] shadow-xs">
            <div class="font-bold text-[#1D1D1F] mb-1">Ingin Menguji Akses Administrator?</div>
            <p class="text-[11px] text-[#86868B] mb-3">Klik tombol cepat di bawah ini untuk langsung beralih ke akun Administrator pengujian:</p>
            
            <form asp-controller="Account" asp-action="QuickSwitch" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="targetRole" value="admin" />
                <button type="submit" class="liquid-btn-primary w-full py-2.5 justify-center font-mono text-xs font-semibold">
                    <span>👑 Beralih ke Admin Sekarang</span>
                </button>
            </form>
        </div>

        <div class="flex items-center justify-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="liquid-btn-secondary px-4 py-2 text-xs">
                Kembali ke Dashboard
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="liquid-btn-reject px-4 py-2 text-xs font-medium">
                    Keluar Akun
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.lucide) {
                window.lucide.createIcons();
            }
        });
    </script>
}
