@model SmartRoom.DTOs.DashboardStatsDto
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Welcome & Action Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Dashboard SmartRoom
        </h2>
        <p class="text-muted mb-0">Sistem monitoring peminjaman ruangan kampus &amp; kantor terintegrasi secara real-time.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Bookings" asp-action="Create" class="btn btn-primary rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-plus-circle"></i> Ajukan Peminjaman
        </a>
        <a href="/swagger" target="_blank" class="btn btn-outline-dark rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-terminal"></i> Swagger API
        </a>
    </div>
</div>

<!-- 4 Statistic Cards -->
<div class="row g-3 mb-4">
    <!-- Total Active Rooms -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm border-0 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Ruangan Aktif</span>
                    <h2 class="fw-bold text-dark mb-0 mt-1">@Model.TotalActiveRooms</h2>
                    <span class="small text-success d-inline-flex align-items-center gap-1 mt-1">
                        <i class="bi bi-check-circle-fill"></i> Siap dipesan
                    </span>
                </div>
                <div class="bg-primary-subtle text-primary p-3 rounded-4 fs-3">
                    <i class="bi bi-door-open-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Today's Bookings -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm border-0 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Peminjaman Hari Ini</span>
                    <h2 class="fw-bold text-dark mb-0 mt-1">@Model.TodayBookingsCount</h2>
                    <span class="small text-muted d-inline-flex align-items-center gap-1 mt-1">
                        <i class="bi bi-calendar-event"></i> @DateTime.Now.ToString("dd MMM yyyy")
                    </span>
                </div>
                <div class="bg-info-subtle text-info p-3 rounded-4 fs-3">
                    <i class="bi bi-calendar2-week-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Approval -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm border-0 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Menunggu Approval</span>
                    <h2 class="fw-bold text-warning mb-0 mt-1">@Model.PendingBookingsCount</h2>
                    <span class="small text-warning d-inline-flex align-items-center gap-1 mt-1">
                        <i class="bi bi-hourglass-split"></i> Perlu verifikasi admin
                    </span>
                </div>
                <div class="bg-warning-subtle text-warning p-3 rounded-4 fs-3">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Approved -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm border-0 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Peminjaman Disetujui</span>
                    <h2 class="fw-bold text-success mb-0 mt-1">@Model.ApprovedBookingsCount</h2>
                    <span class="small text-success d-inline-flex align-items-center gap-1 mt-1">
                        <i class="bi bi-shield-fill-check"></i> Jadwal terkonfirmasi
                    </span>
                </div>
                <div class="bg-success-subtle text-success p-3 rounded-4 fs-3">
                    <i class="bi bi-check2-circle"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Today's Schedule Table -->
<div class="card shadow-sm border-0 bg-white">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-clock-fill text-primary me-2"></i>Jadwal Peminjaman Hari Ini
            </h5>
            <small class="text-muted">Daftar agenda peminjaman ruangan yang terjadwal untuk hari ini</small>
        </div>
        <a asp-controller="Bookings" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            Lihat Semua Jadwal <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="card-body p-0">
        @if (Model.TodayBookings.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-custom">
                        <tr>
                            <th class="ps-4">No. Referensi</th>
                            <th>Ruangan</th>
                            <th>Peminjam</th>
                            <th>Tujuan</th>
                            <th>Waktu Peminjaman</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.TodayBookings)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-semibold text-dark font-monospace">@item.BookingReference</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@(item.Room?.Name ?? "Ruangan Tidak Ditemukan")</div>
                                    <small class="text-muted">@(item.Room?.Building ?? "-") (@(item.Room?.RoomCode ?? "-"))</small>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">@item.BorrowerName</div>
                                    <small class="text-muted">@item.BorrowerEmail</small>
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@item.Purpose">
                                        @item.Purpose
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">
                                        <i class="bi bi-clock text-muted me-1"></i>
                                        @item.StartTime.ToString("HH:mm") - @item.EndTime.ToString("HH:mm")
                                    </div>
                                    <small class="text-muted">
                                        Durasi: @((item.EndTime - item.StartTime).TotalHours.ToString("0.#")) jam
                                    </small>
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case BookingStatus.Pending:
                                            <span class="badge badge-status-pending px-3 py-2 rounded-pill">
                                                <i class="bi bi-hourglass-split me-1"></i> Pending
                                            </span>
                                            break;
                                        case BookingStatus.Approved:
                                            <span class="badge badge-status-approved px-3 py-2 rounded-pill">
                                                <i class="bi bi-check-circle-fill me-1"></i> Approved
                                            </span>
                                            break;
                                        case BookingStatus.Rejected:
                                            <span class="badge badge-status-rejected px-3 py-2 rounded-pill">
                                                <i class="bi bi-x-circle-fill me-1"></i> Rejected
                                            </span>
                                            break;
                                        case BookingStatus.Cancelled:
                                            <span class="badge badge-status-cancelled px-3 py-2 rounded-pill">
                                                <i class="bi bi-slash-circle me-1"></i> Cancelled
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (item.Status == BookingStatus.Pending)
                                    {
                                        <a asp-controller="Bookings" asp-action="Manage" asp-route-roomId="@item.RoomId" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            Proses <i class="bi bi-arrow-right"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Selesai</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar2-x text-muted display-4 mb-3 d-block"></i>
                <h6 class="text-dark fw-bold">Belum Ada Peminjaman Hari Ini</h6>
                <p class="text-muted small mb-3">Seluruh ruangan masih tersedia untuk digunakan hari ini.</p>
                <a asp-controller="Bookings" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">
                    <i class="bi bi-plus-lg me-1"></i> Buat Peminjaman Baru
                </a>
            </div>
        }
    </div>
</div>
