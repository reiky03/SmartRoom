@model SmartRoom.DTOs.DashboardStatsDto
@{
    ViewData["Title"] = "Pusat Pengendali Fasilitas";
    var todayStr = DateTime.Now.ToString("dddd, dd MMMM yyyy");
}

<div class="space-y-7" x-data="{ tableFilter: 'all', searchQuery: '', activeTooltip: null }">

    <!-- macOS 27 Hero Header Banner -->
    <div class="liquid-glass-header p-6 sm:p-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="relative z-10">
            <div class="flex items-center gap-2 mb-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-semibold bg-[#34C759]/15 text-[#116329] border border-[#34C759]/30">
                    <span class="w-2 h-2 rounded-full bg-[#34C759] animate-pulse"></span>
                    SISTEM OPERASIONAL AKTIF
                </span>
                <span class="text-[#86868B]">&bull;</span>
                <span class="text-xs font-mono text-[#515154]">@todayStr</span>
            </div>
            <h1 class="text-3xl font-bold tracking-tight text-[#1D1D1F] sm:text-4xl">
                Pusat Pengendali Fasilitas
            </h1>
            <p class="text-sm text-[#515154] mt-1.5 max-w-2xl leading-relaxed">
                Platform reservasi fasilitas kampus modern dengan validasi pencegahan jadwal tumpang tindih (*anti-conflict*) dan alur persetujuan bertingkat berbasis transparansi.
            </p>
        </div>

        <div class="flex items-center gap-3 flex-shrink-0 relative z-10">
            <a asp-controller="Bookings" asp-action="Create" 
               class="liquid-btn-primary">
                <i data-lucide="calendar-plus" class="w-4 h-4 text-white"></i>
                <span>Ajukan Peminjaman</span>
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Bookings" asp-action="Manage" 
                   class="liquid-btn-secondary relative">
                    <i data-lucide="shield-check" class="w-4 h-4 text-[#FF3B30]"></i>
                    <span>Antrean Persetujuan</span>
                    @if (Model.PendingBookingsCount > 0)
                    {
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-[#FF3B30] text-white shadow-xs">
                            @Model.PendingBookingsCount
                        </span>
                    }
                </a>
            }
        </div>
    </div>

    <!-- iOS Dynamic Live Activity Banner (If Pending Bookings Exist) -->
    @if (Model.PendingBookingsCount > 0 && User.IsInRole("Admin"))
    {
        <div class="liquid-banner-pending p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start sm:items-center gap-3.5">
                <div class="liquid-squircle-icon bg-[#FF9500]/20 text-[#7A4500] flex-shrink-0">
                    <i data-lucide="alert-circle" class="w-5 h-5 text-[#FF9500]"></i>
                </div>
                <div>
                    <div class="font-bold text-sm text-[#7A4500]">
                        Ada @Model.PendingBookingsCount Pengajuan Peminjaman Menunggu Keputusan
                    </div>
                    <div class="text-xs text-[#7A4500]/80 mt-0.5">
                        Civitas akademika menunggu verifikasi persetujuan untuk penggunaan sarana &amp; prasarana.
                    </div>
                </div>
            </div>
            <a asp-controller="Bookings" asp-action="Manage" 
               class="liquid-btn-amber self-start sm:self-auto">
                <span>Proses Sekarang</span>
                <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
            </a>
        </div>
    }

    <!-- 4 Apple System KPI Stat Cards (Squircle Bento Grid) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
        
        <!-- Card 1: Active Rooms -->
        <div class="liquid-glass-card p-5 sm:p-6 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-3">
                    <span class="text-[11px] font-mono uppercase tracking-wider text-[#86868B] font-semibold">Ruangan Aktif</span>
                    <div class="liquid-squircle-icon bg-[#007AFF]/12 text-[#007AFF]">
                        <i data-lucide="door-open" class="w-4 h-4"></i>
                    </div>
                </div>
                <div class="flex items-baseline gap-2">
                    <span class="text-3xl sm:text-4xl font-extrabold text-[#1D1D1F] font-mono tracking-tight">@Model.TotalActiveRooms</span>
                    <span class="text-xs text-[#86868B] font-mono">Unit Siap Pakai</span>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-black/[0.05] flex items-center justify-between text-xs">
                <span class="inline-flex items-center gap-1.5 text-[#116329] font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#34C759]"></span> 100% Terverifikasi
                </span>
                <a asp-controller="Rooms" asp-action="Index" class="text-[#515154] hover:text-[#007AFF] font-mono text-[11px] flex items-center gap-0.5 transition-colors">
                    <span>Katalog</span>
                    <i data-lucide="chevron-right" class="w-3 h-3"></i>
                </a>
            </div>
        </div>

        <!-- Card 2: Today's Bookings -->
        <div class="liquid-glass-card p-5 sm:p-6 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-3">
                    <span class="text-[11px] font-mono uppercase tracking-wider text-[#86868B] font-semibold">Agenda Hari Ini</span>
                    <div class="liquid-squircle-icon bg-[#5856D6]/12 text-[#5856D6]">
                        <i data-lucide="calendar" class="w-4 h-4"></i>
                    </div>
                </div>
                <div class="flex items-baseline gap-2">
                    <span class="text-3xl sm:text-4xl font-extrabold text-[#1D1D1F] font-mono tracking-tight">@Model.TodayBookingsCount</span>
                    <span class="text-xs text-[#86868B] font-mono">Sesi Terdaftar</span>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-black/[0.05] flex items-center justify-between text-xs text-[#515154]">
                <span class="font-mono text-[11px]">Rentang 08:00 - 18:00</span>
                <i data-lucide="clock" class="w-3.5 h-3.5 text-[#86868B]"></i>
            </div>
        </div>

        <!-- Card 3: Pending Approvals -->
        <div class="liquid-glass-card p-5 sm:p-6 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-3">
                    <span class="text-[11px] font-mono uppercase tracking-wider text-[#86868B] font-semibold">Menunggu Review</span>
                    <div class="liquid-squircle-icon bg-[#FF9500]/15 text-[#FF9500]">
                        <i data-lucide="hourglass" class="w-4 h-4"></i>
                    </div>
                </div>
                <div class="flex items-baseline gap-2">
                    <span class="text-3xl sm:text-4xl font-extrabold text-[#7A4500] font-mono tracking-tight">@Model.PendingBookingsCount</span>
                    <span class="px-2 py-0.5 rounded-full bg-[#FF9500]/15 text-[#7A4500] font-mono text-[11px] font-bold border border-[#FF9500]/25">
                        Pending
                    </span>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-black/[0.05] flex items-center justify-between text-xs">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Bookings" asp-action="Manage" class="text-[#1D1D1F] hover:text-[#FF3B30] font-semibold flex items-center gap-1 font-mono text-[11px] transition-colors">
                        <span>Review Antrean</span>
                        <i data-lucide="arrow-right" class="w-3 h-3"></i>
                    </a>
                }
                else
                {
                    <span class="text-[#86868B] font-mono text-[11px]">Oleh Administrator</span>
                }
            </div>
        </div>

        <!-- Card 4: Confirmed / Approved -->
        <div class="liquid-glass-card p-5 sm:p-6 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-3">
                    <span class="text-[11px] font-mono uppercase tracking-wider text-[#86868B] font-semibold">Terkonfirmasi</span>
                    <div class="liquid-squircle-icon bg-[#34C759]/15 text-[#34C759]">
                        <i data-lucide="check-check" class="w-4 h-4"></i>
                    </div>
                </div>
                <div class="flex items-baseline gap-2">
                    <span class="text-3xl sm:text-4xl font-extrabold text-[#116329] font-mono tracking-tight">@Model.ApprovedBookingsCount</span>
                    <span class="px-2 py-0.5 rounded-full bg-[#34C759]/15 text-[#116329] font-mono text-[11px] font-bold border border-[#34C759]/25">
                        Approved
                    </span>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-black/[0.05] flex items-center justify-between text-xs text-[#86868B] font-mono text-[11px]">
                <span class="flex items-center gap-1 text-[#116329]">
                    <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
                    <span>Anti-Bentrok Validated</span>
                </span>
                <span class="text-[#86868B]">LINQ Engine</span>
            </div>
        </div>
    </div>

    <!-- Apple Calendar Occupancy Matrix (Gantt Chart 08:00 - 18:00) -->
    <div class="liquid-glass-card p-6 sm:p-7">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <div>
                <div class="flex items-center gap-2.5">
                    <h2 class="text-lg font-bold text-[#1D1D1F] tracking-tight">
                        Matriks Okupansi Ruangan Harian
                    </h2>
                    <span class="liquid-glass-pill px-2.5 py-0.5 text-[10px] font-mono text-[#515154] font-semibold">
                        08:00 — 18:00 WIB
                    </span>
                </div>
                <p class="text-xs text-[#515154] mt-0.5">Visualisasi alokasi jam pakai per ruangan untuk verifikasi slot kosong real-time</p>
            </div>

            <!-- Legend Pills -->
            <div class="flex items-center gap-3 text-[11px] font-mono">
                <span class="inline-flex items-center gap-1.5 text-[#1D1D1F]">
                    <span class="w-2.5 h-2.5 rounded-sm bg-[#34C759]"></span> Disetujui
                </span>
                <span class="inline-flex items-center gap-1.5 text-[#1D1D1F]">
                    <span class="w-2.5 h-2.5 rounded-sm bg-[#FF9500]"></span> Pending
                </span>
                <span class="inline-flex items-center gap-1.5 text-[#86868B]">
                    <span class="w-2.5 h-2.5 rounded-sm bg-black/[0.08]"></span> Kosong
                </span>
            </div>
        </div>

        <!-- Matrix Timeline Grid -->
        <div class="overflow-x-auto pb-2">
            <div class="min-w-[760px]">
                
                <!-- Hour Headers (08:00 to 18:00) with Hairline Dashed Borders -->
                <div class="flex text-[11px] font-mono text-[#86868B] mb-2.5 pl-[230px]">
                    @for (int h = 8; h <= 17; h++)
                    {
                        <div class="flex-1 border-l border-black/[0.08] pl-2 text-left select-none font-medium">
                            @($"{h:D2}:00")
                        </div>
                    }
                </div>

                <!-- Room Rows -->
                @{
                    var roomsGrouped = Model.TodayBookings
                        .Where(b => b.Room != null)
                        .GroupBy(b => b.Room!)
                        .ToList();
                }

                @if (roomsGrouped.Any())
                {
                    <div class="space-y-3.5">
                        @foreach (var group in roomsGrouped)
                        {
                            var room = group.Key;
                            <div class="flex items-center group/row">
                                <!-- Room Identifier Left Column -->
                                <div class="w-[230px] flex-shrink-0 pr-4">
                                    <div class="font-bold text-xs text-[#1D1D1F] truncate" title="@room.Name">@room.Name</div>
                                    <div class="text-[10px] font-mono text-[#86868B] flex items-center gap-1.5 mt-0.5">
                                        <span class="liquid-glass-pill px-1.5 py-0.2 font-semibold">@room.RoomCode</span>
                                        <span>&bull;</span>
                                        <span>@room.Capacity Kursi</span>
                                    </div>
                                </div>

                                <!-- Timeline Runway Track -->
                                <div class="relative flex-1 h-10 bg-white/60 rounded-xl border border-black/[0.07] overflow-hidden shadow-inner">
                                    <!-- Hairline Dashed Hourly Guidelines -->
                                    <div class="absolute inset-0 flex pointer-events-none">
                                        @for (int i = 0; i < 10; i++)
                                        {
                                            <div class="flex-1 border-r border-dashed border-black/[0.07]"></div>
                                        }
                                    </div>

                                    <!-- Render Booked Slot Blocks as Apple Calendar Glass Event Pills -->
                                    @foreach (var b in group)
                                    {
                                        if (b.Status != SmartRoom.Models.Enums.BookingStatus.Rejected && b.Status != SmartRoom.Models.Enums.BookingStatus.Cancelled)
                                        {
                                            var dayStart = DateTime.Today.AddHours(8);
                                            var totalMinutes = 10 * 60; // 600 mins
                                            var startMin = Math.Max(0, (b.StartTime - dayStart).TotalMinutes);
                                            var durationMin = (b.EndTime - b.StartTime).TotalMinutes;
                                            var leftPct = (startMin / totalMinutes) * 100;
                                            var widthPct = Math.Min(100 - leftPct, (durationMin / totalMinutes) * 100);

                                            var isApproved = b.Status == SmartRoom.Models.Enums.BookingStatus.Approved;
                                            var eventPillClass = isApproved ? "event-pill-approved" : "event-pill-pending";

                                            <div class="absolute inset-y-1 px-2.5 flex items-center justify-between text-[11px] font-mono font-medium truncate @eventPillClass z-10"
                                                 style="left: @leftPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%; width: @widthPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;"
                                                 x-on:mouseenter="activeTooltip = '@b.BookingReference'"
                                                 x-on:mouseleave="activeTooltip = null">
                                                <div class="truncate flex items-center gap-1.5">
                                                    <span class="font-bold">@b.StartTime.ToString("HH:mm")-@b.EndTime.ToString("HH:mm")</span>
                                                    <span class="opacity-80 truncate hidden lg:inline">(@b.BorrowerName)</span>
                                                </div>
                                            </div>

                                            <!-- Dynamic Floating Glass Popover Tooltip -->
                                            <div x-show="activeTooltip === '@b.BookingReference'" x-cloak
                                                 class="fixed z-50 p-3.5 bg-[#1D1D1F]/95 backdrop-blur-xl text-white rounded-2xl shadow-2xl text-xs max-w-xs pointer-events-none transform -translate-y-full -mt-2 font-sans border border-white/20"
                                                 style="left: max(16px, min(calc(@leftPct% + 230px), calc(100vw - 320px)));">
                                                <div class="flex items-center justify-between gap-3 mb-1.5">
                                                    <span class="font-mono text-[10px] text-white/70">@b.BookingReference</span>
                                                    <span class="px-2 py-0.5 rounded-full text-[9px] font-mono font-bold uppercase @(isApproved ? "bg-[#34C759]/25 text-[#34C759]" : "bg-[#FF9500]/25 text-[#FF9500]")">
                                                        @b.Status
                                                    </span>
                                                </div>
                                                <div class="font-bold text-white text-sm">@b.BorrowerName</div>
                                                <div class="text-[11px] text-white/70 font-mono mt-0.5">@b.StartTime.ToString("HH:mm") — @b.EndTime.ToString("HH:mm") WIB</div>
                                                <div class="text-[11px] text-white/80 mt-1.5 line-clamp-2">@b.Purpose</div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="py-12 text-center text-xs text-[#86868B] font-mono border-t border-black/[0.05]">
                        <i data-lucide="calendar-check" class="w-8 h-8 mx-auto mb-2 opacity-30 text-[#007AFF]"></i>
                        <span>Tidak ada aktivitas jadwal peminjaman pada hari ini. Semua ruangan bebas dipesan.</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Filterable Schedule Table & Feed (macOS 27 Liquid Glass Container) -->
    <div class="liquid-glass-card overflow-hidden">
        
        <!-- Table Toolbar: Segmented Control Tabs + Search Bar -->
        <div class="p-5 sm:p-6 border-b border-black/[0.06] flex flex-col md:flex-row md:items-center justify-between gap-4">
            
            <!-- Segmented Filter Tabs -->
            <div class="liquid-segmented-control text-xs font-medium text-[#515154] w-fit">
                <button type="button" x-on:click="tableFilter = 'all'" 
                        :class="tableFilter === 'all' ? 'active' : ''"
                        class="liquid-segmented-item">
                    Semua (@Model.TodayBookings.Count())
                </button>
                <button type="button" x-on:click="tableFilter = 'Approved'" 
                        :class="tableFilter === 'Approved' ? 'active' : ''"
                        class="liquid-segmented-item flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#34C759]"></span>
                    Disetujui (@Model.TodayBookings.Count(b => b.Status == SmartRoom.Models.Enums.BookingStatus.Approved))
                </button>
                <button type="button" x-on:click="tableFilter = 'Pending'" 
                        :class="tableFilter === 'Pending' ? 'active' : ''"
                        class="liquid-segmented-item flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#FF9500]"></span>
                    Pending (@Model.TodayBookings.Count(b => b.Status == SmartRoom.Models.Enums.BookingStatus.Pending))
                </button>
                <button type="button" x-on:click="tableFilter = 'Rejected'" 
                        :class="tableFilter === 'Rejected' ? 'active' : ''"
                        class="liquid-segmented-item flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#FF3B30]"></span>
                    Ditolak (@Model.TodayBookings.Count(b => b.Status == SmartRoom.Models.Enums.BookingStatus.Rejected))
                </button>
            </div>

            <!-- Instant Search Input with Spotlight Style -->
            <div class="relative w-full md:w-72">
                <i data-lucide="search" class="w-4 h-4 text-[#86868B] absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                <input type="text" x-model="searchQuery" 
                       placeholder="Cari peminjam, kode, agenda..." 
                       class="liquid-glass-input w-full pl-9 pr-3.5 py-2 text-xs font-mono" />
            </div>
        </div>

        <!-- Table View -->
        @if (Model.TodayBookings.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-white/40 border-b border-black/[0.06] text-[11px] font-mono uppercase tracking-wider text-[#86868B]">
                            <th class="py-3.5 px-6">Referensi</th>
                            <th class="py-3.5 px-6">Ruangan</th>
                            <th class="py-3.5 px-6">Pemohon</th>
                            <th class="py-3.5 px-6">Agenda / Keperluan</th>
                            <th class="py-3.5 px-6">Jadwal Sesi</th>
                            <th class="py-3.5 px-6">Status</th>
                            <th class="py-3.5 px-6 text-right">Tindakan</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-black/[0.04] text-xs text-[#515154]">
                        @foreach (var b in Model.TodayBookings)
                        {
                            <tr class="hover:bg-white/50 transition-colors"
                                x-show="(tableFilter === 'all' || tableFilter === '@b.Status.ToString()') && 
                                        ('@b.BookingReference.ToLowerInvariant()'.includes(searchQuery.toLowerCase()) || 
                                         '@b.BorrowerName.ToLowerInvariant()'.includes(searchQuery.toLowerCase()) || 
                                         '@(b.Room?.Name.ToLowerInvariant() ?? "")'.includes(searchQuery.toLowerCase()) ||
                                         '@b.Purpose.ToLowerInvariant()'.includes(searchQuery.toLowerCase()))">
                                
                                <!-- Reference Code with 1-click copy -->
                                <td class="py-4 px-6 font-mono">
                                    <div class="flex items-center gap-1.5">
                                        <span class="font-bold text-[#1D1D1F]">@b.BookingReference</span>
                                        <button type="button" onclick="navigator.clipboard.writeText('@b.BookingReference')" 
                                                class="text-[#86868B] hover:text-[#007AFF] p-0.5 rounded transition-colors" title="Salin ID Referensi">
                                            <i data-lucide="copy" class="w-3 h-3"></i>
                                        </button>
                                    </div>
                                    <div class="text-[10px] text-[#86868B] font-mono mt-0.5">@b.CreatedAt.ToString("HH:mm") WIB</div>
                                </td>

                                <!-- Room -->
                                <td class="py-4 px-6">
                                    <div class="font-bold text-[#1D1D1F]">@(b.Room?.Name ?? "-")</div>
                                    <div class="text-[11px] font-mono text-[#86868B] flex items-center gap-1 mt-0.5">
                                        <span class="liquid-glass-pill px-1.5 py-0.2 text-[10px] font-semibold">@(b.Room?.RoomCode ?? "-")</span>
                                        <span>&bull;</span>
                                        <span>@(b.Room?.Building ?? "-")</span>
                                    </div>
                                </td>

                                <!-- Borrower -->
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-7 h-7 rounded-full bg-[#1D1D1F] text-white font-mono text-[10px] font-bold flex items-center justify-center shadow-xs">
                                            @(b.BorrowerName.Length >= 2 ? b.BorrowerName[..2].ToUpperInvariant() : "SR")
                                        </div>
                                        <div>
                                            <div class="font-semibold text-[#1D1D1F]">@b.BorrowerName</div>
                                            <div class="text-[11px] text-[#86868B] font-mono">@b.BorrowerEmail</div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Purpose -->
                                <td class="py-4 px-6 max-w-xs truncate" title="@b.Purpose">
                                    <span class="text-[#1D1D1F] font-medium">@b.Purpose</span>
                                </td>

                                <!-- Schedule -->
                                <td class="py-4 px-6 font-mono">
                                    <div class="font-bold text-[#1D1D1F]">
                                        @b.StartTime.ToString("HH:mm") — @b.EndTime.ToString("HH:mm")
                                    </div>
                                    <div class="text-[11px] text-[#86868B] mt-0.5">
                                        Durasi @((b.EndTime - b.StartTime).TotalHours.ToString("0.#")) Jam
                                    </div>
                                </td>

                                <!-- Status Badge -->
                                <td class="py-4 px-6">
                                    @switch (b.Status)
                                    {
                                        case SmartRoom.Models.Enums.BookingStatus.Approved:
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-semibold bg-[#34C759]/15 text-[#116329] border border-[#34C759]/30">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#34C759]"></span> Approved
                                            </span>
                                            break;
                                        case SmartRoom.Models.Enums.BookingStatus.Pending:
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-semibold bg-[#FF9500]/15 text-[#7A4500] border border-[#FF9500]/30">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#FF9500]"></span> Pending
                                            </span>
                                            break;
                                        case SmartRoom.Models.Enums.BookingStatus.Rejected:
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-semibold bg-[#FF3B30]/15 text-[#C91E14] border border-[#FF3B30]/30">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#FF3B30]"></span> Rejected
                                            </span>
                                            break;
                                        default:
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-semibold bg-black/[0.05] text-[#515154] border border-black/[0.07]">
                                                Cancelled
                                            </span>
                                            break;
                                    }
                                </td>

                                <!-- Actions -->
                                <td class="py-4 px-6 text-right font-mono">
                                    @if (b.Status == SmartRoom.Models.Enums.BookingStatus.Pending && User.IsInRole("Admin"))
                                    {
                                        <a asp-controller="Bookings" asp-action="Manage" asp-route-roomId="@b.RoomId" 
                                           class="liquid-btn-amber py-1 px-3 text-[11px] inline-flex items-center gap-1">
                                            <span>Review</span>
                                            <i data-lucide="arrow-right" class="w-3 h-3"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Bookings" asp-action="Index" 
                                           class="inline-flex items-center gap-1 text-[#86868B] hover:text-[#007AFF] text-[11px] transition-colors">
                                            <span>Detail</span>
                                            <i data-lucide="chevron-right" class="w-3 h-3"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="py-14 text-center text-[#86868B]">
                <i data-lucide="calendar" class="w-10 h-10 mx-auto mb-2 opacity-30 text-[#007AFF]"></i>
                <div class="text-xs font-semibold text-[#1D1D1F]">Belum ada peminjaman aktif untuk hari ini</div>
                <div class="text-[11px] text-[#86868B] mt-0.5">Semua ruangan bebas dipesan civitas akademika.</div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.lucide) {
                window.lucide.createIcons();
            }
        });
    </script>
}
