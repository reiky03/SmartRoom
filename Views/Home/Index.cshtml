@model SmartRoom.DTOs.DashboardStatsDto
@{
    ViewData["Title"] = "Dashboard";
    var todayStr = DateTime.Now.ToString("dddd, dd MMMM yyyy");
}

<!-- Welcome / Header Section -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-slate-200">
    <div>
        <div class="flex items-center gap-2 text-xs font-mono text-slate-500 mb-1">
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-semibold">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> LIVE SYSTEM
            </span>
            <span>&bull;</span>
            <span>@todayStr</span>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">
            SmartRoom Operations Dashboard
        </h1>
        <p class="text-xs text-slate-500 mt-0.5">Monitoring peminjaman ruangan kampus, jadwal terisi, dan status alur persetujuan</p>
    </div>

    <div class="flex items-center gap-2">
        <a asp-controller="Bookings" asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold shadow-sm shadow-emerald-600/20 transition-all">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span>Ajukan Peminjaman</span>
        </a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Bookings" asp-action="Manage" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold border border-slate-200 shadow-sm transition-all">
                <i data-lucide="shield-check" class="w-4 h-4 text-rose-500"></i>
                <span>Antrean Approval (@Model.PendingBookingsCount)</span>
            </a>
        }
    </div>
</div>

<!-- 4 Modern Stat Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <!-- Stat 1: Ruangan Aktif -->
    <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-sm hover:border-slate-300 transition-all">
        <div class="flex items-center justify-between text-slate-500 mb-3">
            <span class="text-xs font-mono uppercase tracking-wider font-semibold">Ruangan Aktif</span>
            <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <i data-lucide="door-open" class="w-4 h-4"></i>
            </div>
        </div>
        <div class="flex items-baseline gap-2">
            <span class="text-3xl font-extrabold text-slate-900 font-mono tracking-tight">@Model.TotalActiveRooms</span>
            <span class="text-xs text-slate-500">unit siap pakai</span>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="text-emerald-600 font-medium flex items-center gap-1">
                <i data-lucide="check" class="w-3.5 h-3.5"></i> Siap dipesan
            </span>
            <a asp-controller="Rooms" asp-action="Index" class="text-slate-400 hover:text-slate-700 transition-colors">
                Katalog &rarr;
            </a>
        </div>
    </div>

    <!-- Stat 2: Jadwal Hari Ini -->
    <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-sm hover:border-slate-300 transition-all">
        <div class="flex items-center justify-between text-slate-500 mb-3">
            <span class="text-xs font-mono uppercase tracking-wider font-semibold">Agenda Hari Ini</span>
            <div class="w-8 h-8 rounded-lg bg-sky-50 text-sky-600 flex items-center justify-center">
                <i data-lucide="calendar" class="w-4 h-4"></i>
            </div>
        </div>
        <div class="flex items-baseline gap-2">
            <span class="text-3xl font-extrabold text-slate-900 font-mono tracking-tight">@Model.TodayBookingsCount</span>
            <span class="text-xs text-slate-500">sesi terjadwal</span>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span>Tanggal @DateTime.Now.ToString("dd/MM/yyyy")</span>
            <i data-lucide="activity" class="w-3.5 h-3.5 text-sky-500"></i>
        </div>
    </div>

    <!-- Stat 3: Menunggu Approval -->
    <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-sm hover:border-slate-300 transition-all border-l-4 border-l-amber-500">
        <div class="flex items-center justify-between text-slate-500 mb-3">
            <span class="text-xs font-mono uppercase tracking-wider font-semibold text-amber-700">Menunggu Approval</span>
            <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
                <i data-lucide="clock" class="w-4 h-4"></i>
            </div>
        </div>
        <div class="flex items-baseline gap-2">
            <span class="text-3xl font-extrabold text-amber-600 font-mono tracking-tight">@Model.PendingBookingsCount</span>
            <span class="text-xs text-amber-700 font-semibold px-2 py-0.5 rounded-full bg-amber-50 border border-amber-200">Pending</span>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Bookings" asp-action="Manage" class="text-amber-700 hover:text-amber-800 font-semibold flex items-center gap-1">
                    <span>Proses Sekarang</span>
                    <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                </a>
            }
            else
            {
                <span class="text-slate-400">Verifikasi admin fasilitas</span>
            }
        </div>
    </div>

    <!-- Stat 4: Disetujui -->
    <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-sm hover:border-slate-300 transition-all border-l-4 border-l-emerald-500">
        <div class="flex items-center justify-between text-slate-500 mb-3">
            <span class="text-xs font-mono uppercase tracking-wider font-semibold text-emerald-700">Terkonfirmasi</span>
            <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <i data-lucide="badge-check" class="w-4 h-4"></i>
            </div>
        </div>
        <div class="flex items-baseline gap-2">
            <span class="text-3xl font-extrabold text-emerald-600 font-mono tracking-tight">@Model.ApprovedBookingsCount</span>
            <span class="text-xs text-emerald-700 font-semibold px-2 py-0.5 rounded-full bg-emerald-50 border border-emerald-200">Disetujui</span>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
            <span>Bebas bentrok jadwal</span>
            <i data-lucide="check-check" class="w-3.5 h-3.5 text-emerald-500"></i>
        </div>
    </div>
</div>

<!-- Interactive Visual Timeline (Occupancy Matrix 08:00 - 18:00) -->
<div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-sm mb-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
        <div>
            <h2 class="text-base font-bold text-slate-900 tracking-tight flex items-center gap-2">
                <i data-lucide="bar-chart-horizontal" class="w-5 h-5 text-emerald-600"></i>
                <span>Visualisasi Keterisian Ruangan Hari Ini</span>
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">Pemetaan slot waktu (08:00 — 18:00) untuk mengecek okupansi dan slot kosong secara visual</p>
        </div>
        <div class="flex items-center gap-4 text-xs font-mono">
            <span class="inline-flex items-center gap-1.5 text-slate-600">
                <span class="w-2.5 h-2.5 rounded bg-emerald-500"></span> Disetujui (Approved)
            </span>
            <span class="inline-flex items-center gap-1.5 text-slate-600">
                <span class="w-2.5 h-2.5 rounded bg-amber-500"></span> Menunggu (Pending)
            </span>
            <span class="inline-flex items-center gap-1.5 text-slate-400">
                <span class="w-2.5 h-2.5 rounded bg-slate-200"></span> Kosong
            </span>
        </div>
    </div>

    <!-- Timeline Container -->
    <div class="overflow-x-auto pb-2">
        <div class="min-w-[720px]">
            <!-- Timeline Hours Header -->
            <div class="flex text-[11px] font-mono text-slate-400 mb-2" style="margin-left: 200px;">
                @for (int h = 8; h <= 17; h++)
                {
                    <div class="flex-1 border-l border-dashed border-slate-200 pl-1 text-left">
                        @($"{h:D2}:00")
                    </div>
                }
            </div>

            <!-- Grouped by Room Rows -->
            @{
                var roomsGrouped = Model.TodayBookings
                    .Where(b => b.Room != null)
                    .GroupBy(b => b.Room!)
                    .ToList();
            }

            @if (roomsGrouped.Any())
            {
                @foreach (var group in roomsGrouped)
                {
                    var room = group.Key;
                    <div class="flex items-center py-2.5 border-t border-slate-100 hover:bg-slate-50/60 transition-colors">
                        <!-- Room Label -->
                        <div class="w-[200px] flex-shrink-0 pr-4">
                            <div class="font-semibold text-xs text-slate-900 truncate" title="@room.Name">@room.Name</div>
                            <div class="text-[10px] font-mono text-slate-400">@room.RoomCode &bull; @room.Capacity Kursi</div>
                        </div>

                        <!-- Bar Runway -->
                        <div class="relative flex-1 h-8 bg-slate-100/90 rounded-lg border border-slate-200 overflow-hidden">
                            <!-- Background Grid Lines -->
                            <div class="absolute inset-0 flex pointer-events-none">
                                @for (int i = 0; i < 10; i++)
                                {
                                    <div class="flex-1 border-r border-dashed border-slate-200/80"></div>
                                }
                            </div>

                            <!-- Occupied Slots -->
                            @foreach (var b in group)
                            {
                                var dayStart = DateTime.Today.AddHours(8);
                                var totalMinutes = 10 * 60; // 10 hours * 60 min = 600 min
                                var startMin = Math.Max(0, (b.StartTime - dayStart).TotalMinutes);
                                var durationMin = (b.EndTime - b.StartTime).TotalMinutes;
                                var leftPct = (startMin / totalMinutes) * 100;
                                var widthPct = Math.Min(100 - leftPct, (durationMin / totalMinutes) * 100);

                                if (b.Status != SmartRoom.Models.Enums.BookingStatus.Rejected && b.Status != SmartRoom.Models.Enums.BookingStatus.Cancelled)
                                {
                                    var barColor = b.Status == SmartRoom.Models.Enums.BookingStatus.Approved 
                                        ? "bg-emerald-500 text-white shadow-sm" 
                                        : "bg-amber-500 text-white shadow-sm";

                                    <div class="absolute inset-y-1 rounded-md px-2 flex items-center text-[10px] font-mono font-semibold truncate @barColor transition-all"
                                         style="left: @leftPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%; width: @widthPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;"
                                         title="@b.BookingReference: @b.BorrowerName (@b.StartTime.ToString("HH:mm") - @b.EndTime.ToString("HH:mm")) — @b.Purpose">
                                        <span>@b.StartTime.ToString("HH:mm")-@b.EndTime.ToString("HH:mm")</span>
                                        <span class="opacity-80 ml-1.5 font-normal truncate hidden md:inline">@b.BorrowerName</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="py-8 text-center text-xs text-slate-400 font-mono border-t border-slate-100">
                    Belum ada jadwal terisi untuk hari ini. Semua ruangan masih sepenuhnya kosong.
                </div>
            }
        </div>
    </div>
</div>

<!-- Today's Schedule Table -->
<div class="rounded-2xl bg-white border border-slate-200/80 shadow-sm overflow-hidden">
    <div class="p-5 border-b border-slate-200/80 flex items-center justify-between">
        <div>
            <h3 class="text-sm font-bold text-slate-900 tracking-tight">Daftar Peminjaman Hari Ini</h3>
            <p class="text-xs text-slate-500 mt-0.5">Rincian peminjam, jam pelaksanaan, dan status persetujuan</p>
        </div>
        <a asp-controller="Bookings" asp-action="Index" class="text-xs font-semibold text-slate-600 hover:text-slate-900 inline-flex items-center gap-1 transition-colors">
            <span>Lihat Semua</span>
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </a>
    </div>

    @if (Model.TodayBookings.Any())
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/80 border-b border-slate-200/80 text-[11px] font-mono uppercase tracking-wider text-slate-500">
                        <th class="py-3 px-5">Referensi</th>
                        <th class="py-3 px-5">Ruangan</th>
                        <th class="py-3 px-5">Peminjam</th>
                        <th class="py-3 px-5">Agenda</th>
                        <th class="py-3 px-5">Waktu</th>
                        <th class="py-3 px-5">Status</th>
                        <th class="py-3 px-5 text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-xs text-slate-700">
                    @foreach (var b in Model.TodayBookings)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="py-3.5 px-5 font-mono font-semibold text-slate-900">
                                @b.BookingReference
                            </td>
                            <td class="py-3.5 px-5">
                                <div class="font-semibold text-slate-900">@(b.Room?.Name ?? "-")</div>
                                <div class="text-[11px] font-mono text-slate-400">@(b.Room?.Building ?? "-") (@(b.Room?.RoomCode ?? "-"))</div>
                            </td>
                            <td class="py-3.5 px-5">
                                <div class="font-medium text-slate-900">@b.BorrowerName</div>
                                <div class="text-[11px] text-slate-400">@b.BorrowerEmail</div>
                            </td>
                            <td class="py-3.5 px-5 max-w-xs truncate" title="@b.Purpose">
                                @b.Purpose
                            </td>
                            <td class="py-3.5 px-5 font-mono">
                                <div class="font-semibold text-slate-800">
                                    @b.StartTime.ToString("HH:mm") — @b.EndTime.ToString("HH:mm")
                                </div>
                                <div class="text-[11px] text-slate-400">Durasi @((b.EndTime - b.StartTime).TotalHours.ToString("0.#")) Jam</div>
                            </td>
                            <td class="py-3.5 px-5">
                                @switch (b.Status)
                                {
                                    case SmartRoom.Models.Enums.BookingStatus.Pending:
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Pending
                                        </span>
                                        break;
                                    case SmartRoom.Models.Enums.BookingStatus.Approved:
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Approved
                                        </span>
                                        break;
                                    case SmartRoom.Models.Enums.BookingStatus.Rejected:
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Rejected
                                        </span>
                                        break;
                                    case SmartRoom.Models.Enums.BookingStatus.Cancelled:
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                                            Cancelled
                                        </span>
                                        break;
                                }
                            </td>
                            <td class="py-3.5 px-5 text-right font-mono">
                                @if (b.Status == SmartRoom.Models.Enums.BookingStatus.Pending && User.IsInRole("Admin"))
                                {
                                    <a asp-controller="Bookings" asp-action="Manage" asp-route-roomId="@b.RoomId" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-[11px] font-medium transition-colors">
                                        <span>Proses</span>
                                        <i data-lucide="arrow-right" class="w-3 h-3"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-slate-300">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="py-12 text-center text-slate-400">
            <i data-lucide="calendar-x" class="w-8 h-8 mx-auto mb-2 opacity-30"></i>
            <div class="text-xs font-medium text-slate-600">Belum ada peminjaman aktif untuk hari ini</div>
            <div class="text-[11px] text-slate-400 mt-0.5">Semua ruangan bebas dipesan.</div>
        </div>
    }
</div>

@section Scripts {
    <script>lucide.createIcons();</script>
}
