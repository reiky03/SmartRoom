@using System.Security.Claims
<!DOCTYPE html>
<html lang="id" class="h-full bg-[#FAFAFA]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SmartRoom</title>

    <!-- Google Fonts: Plus Jakarta Sans, Instrument Serif & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS (Tailwind Play CDN with custom theme tokens) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        canvas: '#FAFAFA',
                        surface: '#FFFFFF',
                        borderSubtle: '#E4E4E7',
                        textPrimary: '#09090B',
                        textSecondary: '#71717A',
                        textMuted: '#A1A1AA',
                        accent: '#18181B',
                    }
                }
            }
        }
    </script>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>

    <style>
        [x-cloak] { display: none !important; }
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            letter-spacing: -0.018em;
            background-color: #FAFAFA;
            color: #09090B;
        }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
        .bg-grid-pattern {
            background-image: radial-gradient(rgba(0, 0, 0, 0.04) 1px, transparent 1px);
            background-size: 24px 24px;
        }
        /* Custom scrollbar for clean UI */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #FAFAFA;
        }
        ::-webkit-scrollbar-thumb {
            background: #D4D4D8;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #A1A1AA;
        }
    </style>
</head>
<body class="min-h-full flex flex-col antialiased selection:bg-zinc-900 selection:text-white" x-data="{ mobileMenuOpen: false }">

    <!-- Ambient Subtle Radial Glow -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
        <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-gradient-to-b from-zinc-200/40 via-zinc-100/20 to-transparent blur-3xl opacity-60"></div>
    </div>

    <!-- Main Navigation Header (Modulify / Linear Style Sticky Header) -->
    <header class="sticky top-0 z-40 w-full bg-[#FAFAFA]/85 backdrop-blur-md border-b border-zinc-200/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 gap-4">
                
                <!-- Left: Brand Logo & Navigation Links -->
                <div class="flex items-center gap-8">
                    <!-- Brand -->
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5 text-zinc-900 group">
                        <div class="w-8 h-8 rounded-lg bg-zinc-900 text-white flex items-center justify-center font-bold text-sm shadow-sm group-hover:scale-105 transition-transform duration-200">
                            <span class="font-mono tracking-tighter">S</span>
                        </div>
                        <div class="flex items-baseline gap-1.5">
                            <span class="font-bold text-base tracking-tight text-zinc-900">SmartRoom</span>
                            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-mono text-zinc-500 bg-zinc-100 border border-zinc-200/80 font-medium">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> v2.4
                            </span>
                        </div>
                    </a>

                    <!-- Desktop Nav Links (Clean Segmented Style) -->
                    <nav class="hidden md:flex items-center gap-1 bg-zinc-100/80 p-1 rounded-xl border border-zinc-200/60 text-xs font-medium text-zinc-600">
                        <a asp-controller="Home" asp-action="Index" 
                           class="px-3 py-1.5 rounded-lg transition-all @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "bg-white text-zinc-900 shadow-sm font-semibold" : "hover:text-zinc-900 hover:bg-white/50")">
                            Dashboard
                        </a>
                        <a asp-controller="Rooms" asp-action="Index" 
                           class="px-3 py-1.5 rounded-lg transition-all @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Rooms" ? "bg-white text-zinc-900 shadow-sm font-semibold" : "hover:text-zinc-900 hover:bg-white/50")">
                            Katalog Ruangan
                        </a>
                        <a asp-controller="Bookings" asp-action="Index" 
                           class="px-3 py-1.5 rounded-lg transition-all @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Bookings" && ViewContext.RouteData.Values["Action"]?.ToString() != "Manage" ? "bg-white text-zinc-900 shadow-sm font-semibold" : "hover:text-zinc-900 hover:bg-white/50")">
                            Jadwal Peminjaman
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Bookings" asp-action="Manage" 
                               class="px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Bookings" && ViewContext.RouteData.Values["Action"]?.ToString() == "Manage" ? "bg-white text-zinc-900 shadow-sm font-semibold" : "hover:text-zinc-900 hover:bg-white/50")">
                                <span>Approval Queue</span>
                                <span class="px-1.5 py-0.2 rounded text-[10px] font-mono bg-zinc-900 text-white font-bold">Admin</span>
                            </a>
                        }
                    </nav>
                </div>

                <!-- Right: Action CTA & User Menu -->
                <div class="flex items-center gap-2.5">
                    
                    <!-- Swagger Doc Link -->
                    <a href="/swagger" target="_blank" 
                       class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 transition-colors border border-transparent hover:border-zinc-200">
                        <i data-lucide="terminal" class="w-3.5 h-3.5 text-zinc-500"></i>
                        <span>API Docs</span>
                        <i data-lucide="arrow-up-right" class="w-3 h-3 text-zinc-400"></i>
                    </a>

                    <!-- Primary Booking Button -->
                    <a asp-controller="Bookings" asp-action="Create" 
                       class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-medium shadow-sm transition-all active:scale-[0.98]">
                        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                        <span>Pinjam Ruangan</span>
                    </a>

                    <!-- User Account / RBAC Dropdown -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var role = User.FindFirstValue(ClaimTypes.Role) ?? "Student";
                        var initials = User.FindFirst("AvatarInitials")?.Value ?? "SR";
                        var roleBadgeClass = role switch {
                            "Admin" => "bg-rose-50 text-rose-700 border-rose-200/80",
                            "Staff" => "bg-blue-50 text-blue-700 border-blue-200/80",
                            _ => "bg-emerald-50 text-emerald-700 border-emerald-200/80"
                        };

                        <div class="relative" x-data="{ userMenu: false }">
                            <button x-on:click="userMenu = !userMenu" 
                                    class="flex items-center gap-2 p-1.5 pl-2 rounded-xl border border-zinc-200/80 bg-white hover:bg-zinc-50 transition-colors shadow-sm">
                                <div class="w-6 h-6 rounded-md bg-zinc-100 text-zinc-800 font-mono text-[11px] font-bold flex items-center justify-center border border-zinc-200">
                                    @initials
                                </div>
                                <div class="hidden lg:flex flex-col text-left">
                                    <span class="text-xs font-semibold text-zinc-800 leading-none">@User.Identity.Name</span>
                                </div>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold border @roleBadgeClass">
                                    @role
                                </span>
                                <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-zinc-400"></i>
                            </button>

                            <!-- Profile Flyout -->
                            <div x-show="userMenu" x-on:click.outside="userMenu = false" x-cloak
                                 class="absolute right-0 mt-2 w-72 bg-white rounded-xl shadow-xl border border-zinc-200/80 py-2 text-xs text-zinc-700 z-50">
                                
                                <!-- User Information Header -->
                                <div class="px-4 py-2.5 border-b border-zinc-100">
                                    <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-wider mb-1">Akun Masuk</div>
                                    <div class="font-bold text-zinc-900 text-sm">@User.Identity.Name</div>
                                    <div class="text-zinc-500 font-mono text-[11px] truncate">@User.FindFirstValue(ClaimTypes.Email)</div>
                                    <div class="mt-1.5 flex items-center gap-1.5">
                                        <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold border @roleBadgeClass">
                                            Peran: @role
                                        </span>
                                        <span class="text-[10px] text-zinc-400 font-mono">&bull; @User.FindFirst("Department")?.Value</span>
                                    </div>
                                </div>

                                <!-- Quick RBAC Switcher for Evaluation / Testing -->
                                <div class="px-4 py-2 border-b border-zinc-100 bg-zinc-50/50">
                                    <div class="text-[10px] font-mono uppercase tracking-wider text-zinc-400 font-semibold mb-2">
                                        Ganti Role Pengujian (1-Klik)
                                    </div>
                                    <div class="grid grid-cols-3 gap-1.5">
                                        <!-- Switch to Admin -->
                                        <form asp-controller="Account" asp-action="QuickSwitch" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="targetRole" value="admin" />
                                            <button type="submit" class="w-full py-1.5 px-2 rounded-lg text-[10px] font-mono font-semibold transition-all text-center @(role == "Admin" ? "bg-rose-100 text-rose-800 border border-rose-300 shadow-xs" : "bg-white text-zinc-600 border border-zinc-200 hover:bg-zinc-100")">
                                                👑 Admin
                                            </button>
                                        </form>

                                        <!-- Switch to Staff -->
                                        <form asp-controller="Account" asp-action="QuickSwitch" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="targetRole" value="staff" />
                                            <button type="submit" class="w-full py-1.5 px-2 rounded-lg text-[10px] font-mono font-semibold transition-all text-center @(role == "Staff" ? "bg-blue-100 text-blue-800 border border-blue-300 shadow-xs" : "bg-white text-zinc-600 border border-zinc-200 hover:bg-zinc-100")">
                                                👔 Staff
                                            </button>
                                        </form>

                                        <!-- Switch to Student -->
                                        <form asp-controller="Account" asp-action="QuickSwitch" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="targetRole" value="student" />
                                            <button type="submit" class="w-full py-1.5 px-2 rounded-lg text-[10px] font-mono font-semibold transition-all text-center @(role == "Student" ? "bg-emerald-100 text-emerald-800 border border-emerald-300 shadow-xs" : "bg-white text-zinc-600 border border-zinc-200 hover:bg-zinc-100")">
                                                🎓 Student
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <!-- Logout Action -->
                                <div class="px-2 pt-1">
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="w-full text-left px-3 py-2 rounded-lg text-rose-600 hover:bg-rose-50 flex items-center gap-2 transition-colors font-medium">
                                            <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
                                            <span>Keluar dari Akun</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" 
                           class="px-3 py-2 rounded-lg text-xs font-semibold text-zinc-700 hover:bg-zinc-100 border border-zinc-200/80 transition-colors">
                            Masuk
                        </a>
                    }

                    <!-- Mobile Menu Hamburger -->
                    <button x-on:click="mobileMenuOpen = !mobileMenuOpen" class="md:hidden p-2 rounded-lg text-zinc-600 hover:bg-zinc-100">
                        <i data-lucide="menu" class="w-5 h-5"></i>
                    </button>
                </div>
            </div>

            <!-- Mobile Navigation Drawer -->
            <div x-show="mobileMenuOpen" x-cloak class="md:hidden py-3 border-t border-zinc-200/80 space-y-1">
                <a asp-controller="Home" asp-action="Index" class="block px-3 py-2 rounded-lg text-xs font-medium text-zinc-700 hover:bg-zinc-100">
                    Dashboard
                </a>
                <a asp-controller="Rooms" asp-action="Index" class="block px-3 py-2 rounded-lg text-xs font-medium text-zinc-700 hover:bg-zinc-100">
                    Katalog Ruangan
                </a>
                <a asp-controller="Bookings" asp-action="Index" class="block px-3 py-2 rounded-lg text-xs font-medium text-zinc-700 hover:bg-zinc-100">
                    Jadwal Peminjaman
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Bookings" asp-action="Manage" class="block px-3 py-2 rounded-lg text-xs font-medium text-zinc-700 hover:bg-zinc-100">
                        Approval Queue (Admin)
                    </a>
                }
                <a href="/swagger" target="_blank" class="block px-3 py-2 rounded-lg text-xs font-mono text-zinc-500 hover:bg-zinc-100">
                    API Docs (Swagger) &rarr;
                </a>
            </div>
        </div>
    </header>

    <!-- Main App Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 relative z-10">
        <!-- Toast / Flash Feedback Banner -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 p-3.5 rounded-xl bg-[#EDF3EC] border border-[#BBF7D0] text-[#166534] flex items-center justify-between text-xs font-medium shadow-xs">
                <div class="flex items-center gap-2.5">
                    <i data-lucide="check-circle-2" class="w-4 h-4 text-[#166534] flex-shrink-0"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-[#166534]/70 hover:text-[#166534] p-1">
                    <i data-lucide="x" class="w-3.5 h-3.5"></i>
                </button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-6 p-3.5 rounded-xl bg-[#FEE2E2] border border-[#FECACA] text-[#991B1B] flex items-center justify-between text-xs font-medium shadow-xs">
                <div class="flex items-center gap-2.5">
                    <i data-lucide="alert-circle" class="w-4 h-4 text-[#991B1B] flex-shrink-0"></i>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-[#991B1B]/70 hover:text-[#991B1B] p-1">
                    <i data-lucide="x" class="w-3.5 h-3.5"></i>
                </button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Sleek Minimalist Footer -->
    <footer class="mt-auto border-t border-zinc-200/80 bg-white/50 py-6 text-xs text-zinc-500">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-2">
                <span class="font-bold text-zinc-900">SmartRoom</span>
                <span>&bull;</span>
                <span>Campus &amp; Office Facility Reservation System</span>
            </div>
            <div class="flex items-center gap-4 font-mono text-[11px] text-zinc-500">
                <a href="/swagger" target="_blank" class="hover:text-zinc-900 transition-colors">Swagger API</a>
                <span>&bull;</span>
                <span class="text-zinc-700">ASP.NET Core 8 &bull; EF Core 8 &bull; RBAC</span>
            </div>
        </div>
    </footer>

    <!-- Initialize Lucide Icons -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.lucide) {
                window.lucide.createIcons();
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>