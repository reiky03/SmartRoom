@using System.Security.Claims
<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SmartRoom</title>

    <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Tailwind CSS (Tailwind Play CDN with custom config) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                            900: '#064e3b',
                        }
                    }
                }
            }
        }
    </script>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Alpine.js for lightweight reactivity -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>

    <style>
        [x-cloak] { display: none !important; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; letter-spacing: -0.012em; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
    </style>
</head>
<body class="h-full antialiased text-slate-800 flex" x-data="{ sidebarOpen: false, profileDropdown: false }">

    <!-- Mobile Sidebar Backdrop -->
    <div x-show="sidebarOpen" x-cloak 
         class="fixed inset-0 z-40 bg-slate-900/60 backdrop-blur-sm lg:hidden transition-opacity"
         x-on:click="sidebarOpen = false"></div>

    <!-- Sidebar Navigation -->
    <aside :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full'" 
           class="fixed inset-y-0 left-0 z-50 w-64 bg-slate-900 text-slate-300 flex flex-col transition-transform duration-200 ease-in-out lg:translate-x-0 lg:static lg:inset-auto lg:flex-shrink-0">
        
        <!-- App Brand -->
        <div class="h-16 flex items-center justify-between px-6 border-b border-slate-800">
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5 text-white no-underline">
                <div class="w-8 h-8 rounded-lg bg-emerald-500 text-slate-950 flex items-center justify-center font-bold shadow-md shadow-emerald-500/20">
                    <i data-lucide="building-2" class="w-4 h-4 text-white"></i>
                </div>
                <div class="flex flex-col">
                    <span class="font-bold text-base tracking-tight text-white leading-none">SmartRoom</span>
                    <span class="text-[10px] text-emerald-400 font-mono tracking-wider mt-1 uppercase">Campus Booking</span>
                </div>
            </a>
            <button x-on:click="sidebarOpen = false" class="lg:hidden text-slate-400 hover:text-white p-1 rounded">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <!-- Navigation Links -->
        <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
            <div class="px-3 pb-2 text-[11px] font-semibold text-slate-400 uppercase tracking-wider font-mono">
                Menu Utama
            </div>

            <a asp-controller="Home" asp-action="Index" 
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "bg-slate-800 text-white shadow-sm border border-slate-700/60 font-semibold" : "text-slate-400 hover:bg-slate-800/60 hover:text-white")">
                <i data-lucide="layout-dashboard" class="w-4 h-4 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "text-emerald-400" : "")"></i>
                <span>Dashboard</span>
            </a>

            <a asp-controller="Rooms" asp-action="Index" 
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Rooms" ? "bg-slate-800 text-white shadow-sm border border-slate-700/60 font-semibold" : "text-slate-400 hover:bg-slate-800/60 hover:text-white")">
                <i data-lucide="door-open" class="w-4 h-4 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Rooms" ? "text-emerald-400" : "")"></i>
                <span>Katalog Ruangan</span>
            </a>

            <a asp-controller="Bookings" asp-action="Index" 
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Bookings" && ViewContext.RouteData.Values["Action"]?.ToString() != "Manage" ? "bg-slate-800 text-white shadow-sm border border-slate-700/60 font-semibold" : "text-slate-400 hover:bg-slate-800/60 hover:text-white")">
                <i data-lucide="calendar" class="w-4 h-4 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Bookings" && ViewContext.RouteData.Values["Action"]?.ToString() != "Manage" ? "text-emerald-400" : "")"></i>
                <span>Jadwal Peminjaman</span>
            </a>

            @if (User.IsInRole("Admin"))
            {
                <div class="pt-5 px-3 pb-2 text-[11px] font-semibold text-slate-400 uppercase tracking-wider font-mono flex items-center justify-between">
                    <span>Manajemen Admin</span>
                    <span class="px-1.5 py-0.5 rounded text-[9px] bg-rose-500/20 text-rose-300 border border-rose-500/30">RBAC</span>
                </div>

                <a asp-controller="Bookings" asp-action="Manage" 
                   class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Bookings" && ViewContext.RouteData.Values["Action"]?.ToString() == "Manage" ? "bg-slate-800 text-white shadow-sm border border-slate-700/60 font-semibold" : "text-slate-400 hover:bg-slate-800/60 hover:text-white")">
                    <div class="flex items-center gap-3">
                        <i data-lucide="shield-check" class="w-4 h-4 text-rose-400"></i>
                        <span>Approval Antrean</span>
                    </div>
                    <span class="px-1.5 py-0.5 text-xs font-mono font-semibold bg-amber-400/20 text-amber-300 rounded border border-amber-400/30">Admin</span>
                </a>

                <a asp-controller="Rooms" asp-action="Create" 
                   class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-slate-400 hover:bg-slate-800/60 hover:text-white">
                    <i data-lucide="plus-circle" class="w-4 h-4 text-slate-400"></i>
                    <span>Tambah Ruangan</span>
                </a>
            }

            <div class="pt-5 px-3 pb-2 text-[11px] font-semibold text-slate-400 uppercase tracking-wider font-mono">
                Developer &amp; API
            </div>

            <a href="/swagger" target="_blank" 
               class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-slate-400 hover:bg-slate-800/60 hover:text-white">
                <div class="flex items-center gap-3">
                    <i data-lucide="code-2" class="w-4 h-4 text-sky-400"></i>
                    <span>Swagger OpenAPI</span>
                </div>
                <i data-lucide="external-link" class="w-3.5 h-3.5 text-slate-500"></i>
            </a>
        </nav>

        <!-- Current User Profile Footer in Sidebar -->
        <div class="p-3 border-t border-slate-800 bg-slate-950/40">
            @if (User.Identity?.IsAuthenticated == true)
            {
                var role = User.FindFirstValue(ClaimTypes.Role) ?? "Student";
                var initials = User.FindFirst("AvatarInitials")?.Value ?? "SR";
                var dept = User.FindFirst("Department")?.Value ?? "Civitas";

                <div class="flex items-center justify-between p-2 rounded-lg bg-slate-900 border border-slate-800">
                    <div class="flex items-center gap-2.5 overflow-hidden">
                        <div class="w-8 h-8 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center font-bold text-xs font-mono flex-shrink-0">
                            @initials
                        </div>
                        <div class="truncate">
                            <div class="text-xs font-semibold text-white truncate">@User.Identity.Name</div>
                            <div class="text-[11px] text-slate-400 truncate">@dept</div>
                        </div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 flex-shrink-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="p-1.5 text-slate-400 hover:text-rose-400 rounded hover:bg-slate-800 transition-colors" title="Keluar / Logout">
                            <i data-lucide="log-out" class="w-4 h-4"></i>
                        </button>
                    </form>
                </div>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="flex items-center justify-center gap-2 w-full py-2 px-3 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold transition-colors shadow">
                    <i data-lucide="log-in" class="w-4 h-4"></i>
                    <span>Masuk ke Akun</span>
                </a>
            }
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0 overflow-y-auto">
        <!-- Top Navbar -->
        <header class="h-16 bg-white border-b border-slate-200/80 sticky top-0 z-30 px-4 lg:px-8 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <button x-on:click="sidebarOpen = true" class="lg:hidden p-2 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-lg">
                    <i data-lucide="menu" class="w-5 h-5"></i>
                </button>
                <div class="hidden sm:flex items-center gap-2 text-xs text-slate-400 font-mono">
                    <span>SISTEM INFORMASI PEMINJAMAN RUANGAN</span>
                    <span>/</span>
                    <span class="text-slate-700 font-semibold">@ViewData["Title"]</span>
                </div>
            </div>

            <!-- Right Actions -->
            <div class="flex items-center gap-3">
                <a asp-controller="Bookings" asp-action="Create" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-sm transition-all">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    <span>Pinjam Ruangan</span>
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    var role = User.FindFirstValue(ClaimTypes.Role) ?? "Student";
                    var roleColor = role == "Admin" ? "bg-rose-50 text-rose-700 border-rose-200" : (role == "Staff" ? "bg-blue-50 text-blue-700 border-blue-200" : "bg-emerald-50 text-emerald-700 border-emerald-200");

                    <div class="relative" x-data="{ open: false }">
                        <button x-on:click="open = !open" class="flex items-center gap-2.5 p-1.5 rounded-lg hover:bg-slate-100 transition-colors">
                            <span class="px-2 py-0.5 rounded text-[11px] font-mono font-semibold border @roleColor">
                                @role
                            </span>
                            <span class="text-xs font-medium text-slate-700 hidden md:inline">@User.Identity.Name</span>
                            <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400"></i>
                        </button>

                        <div x-show="open" x-on:click.outside="open = false" x-cloak
                             class="absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-lg border border-slate-200/80 py-1.5 text-xs text-slate-700 z-50">
                            <div class="px-3 py-2 border-b border-slate-100">
                                <div class="font-semibold text-slate-900">@User.Identity.Name</div>
                                <div class="text-[11px] text-slate-500 font-mono truncate">@User.FindFirstValue(ClaimTypes.Email)</div>
                            </div>
                            <div class="px-3 py-1.5 text-[10px] uppercase font-mono text-slate-400 font-semibold tracking-wider">
                                Role Akses: @role
                            </div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="w-full text-left px-3 py-2 text-rose-600 hover:bg-rose-50 flex items-center gap-2 transition-colors">
                                    <i data-lucide="log-out" class="w-4 h-4"></i>
                                    <span>Keluar (Logout)</span>
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="text-xs font-semibold px-3 py-2 rounded-lg text-slate-700 hover:bg-slate-100 border border-slate-200">
                        Masuk
                    </a>
                }
            </div>
        </header>

        <!-- Main Workspace Body -->
        <main class="flex-1 p-4 lg:p-8 max-w-7xl w-full mx-auto">
            <!-- Toast / Flash Messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-start gap-3 shadow-sm">
                    <i data-lucide="check-circle" class="w-5 h-5 text-emerald-600 flex-shrink-0 mt-0.5"></i>
                    <div class="flex-1 text-sm font-medium">@TempData["SuccessMessage"]</div>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 flex items-start gap-3 shadow-sm">
                    <i data-lucide="alert-octagon" class="w-5 h-5 text-rose-600 flex-shrink-0 mt-0.5"></i>
                    <div class="flex-1 text-sm font-medium">@TempData["ErrorMessage"]</div>
                </div>
            }

            @RenderBody()
        </main>

        <!-- Modern Clean Footer -->
        <footer class="mt-auto py-4 px-4 lg:px-8 bg-white border-t border-slate-200 text-xs text-slate-500 flex flex-col sm:flex-row items-center justify-between gap-3">
            <div class="flex items-center gap-2">
                <span class="font-bold text-slate-800">SmartRoom</span>
                <span>&bull;</span>
                <span>ASP.NET Core 8 &bull; EF Core 8 &bull; Enterprise RBAC</span>
            </div>
            <div class="flex items-center gap-4 font-mono text-[11px]">
                <a href="/swagger" target="_blank" class="hover:text-slate-900 transition-colors">REST API Docs</a>
                <span>&bull;</span>
                <span class="text-emerald-600 font-semibold">PostgreSQL / SQLite Ready</span>
            </div>
        </footer>
    </div>

    <!-- Initialize Lucide Icons -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.lucide) {
                window.lucide.createIcons();
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
