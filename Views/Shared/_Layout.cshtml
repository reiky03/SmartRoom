<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartRoom Booking</title>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        :root {
            --bs-body-font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            --bs-primary: #2563eb;
            --bs-primary-rgb: 37, 99, 235;
        }
        body {
            background-color: #f8fafc;
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-brand-badge {
            font-size: 0.68rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }
        .card {
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .table-custom th {
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
            background-color: #f1f5f9;
        }
        .badge-status-pending {
            background-color: #fef3c7;
            color: #b45309;
            border: 1px solid #fde68a;
        }
        .badge-status-approved {
            background-color: #dcfce7;
            color: #15803d;
            border: 1px solid #bbf7d0;
        }
        .badge-status-rejected {
            background-color: #fee2e2;
            color: #b91c1c;
            border: 1px solid #fecaca;
        }
        .badge-status-cancelled {
            background-color: #f1f5f9;
            color: #475569;
            border: 1px solid #e2e8f0;
        }
        footer {
            margin-top: auto;
            border-top: 1px solid #e2e8f0;
            background: #ffffff;
        }
    </style>
</head>
<body>
    <!-- Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-2 px-3 shadow-sm sticky-top">
            <div class="container-fluid max-w-7xl">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white fs-5" asp-controller="Home" asp-action="Index">
                    <span class="bg-primary text-white p-2 rounded-3 d-inline-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-building-check"></i>
                    </span>
                    <span>SmartRoom</span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle navbar-brand-badge">.NET 8</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link text-white-50 px-3 rounded-pill @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active text-white bg-secondary bg-opacity-25 fw-semibold" : "")" 
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 px-3 rounded-pill @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Rooms" ? "active text-white bg-secondary bg-opacity-25 fw-semibold" : "")" 
                               asp-controller="Rooms" asp-action="Index">
                                <i class="bi bi-door-open me-1"></i> Manajemen Ruangan
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 px-3 rounded-pill @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Bookings" && ViewContext.RouteData.Values["Action"]?.ToString() != "Manage" ? "active text-white bg-secondary bg-opacity-25 fw-semibold" : "")" 
                               asp-controller="Bookings" asp-action="Index">
                                <i class="bi bi-calendar-check me-1"></i> Peminjaman
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 px-3 rounded-pill @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Bookings" && ViewContext.RouteData.Values["Action"]?.ToString() == "Manage" ? "active text-white bg-secondary bg-opacity-25 fw-semibold" : "")" 
                               asp-controller="Bookings" asp-action="Manage">
                                <i class="bi bi-shield-check me-1"></i> Panel Approval
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                        <a href="/swagger" target="_blank" class="btn btn-sm btn-outline-info rounded-pill px-3 d-inline-flex align-items-center gap-1 shadow-sm">
                            <i class="bi bi-code-slash"></i>
                            <span class="fw-semibold">Swagger API Docs</span>
                            <i class="bi bi-box-arrow-up-right fs-xs"></i>
                        </a>
                        <a asp-controller="Bookings" asp-action="Create" class="btn btn-sm btn-primary rounded-pill px-3 d-inline-flex align-items-center gap-1 shadow-sm">
                            <i class="bi bi-plus-lg"></i>
                            <span class="fw-semibold">Ajukan Pinjam</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Container -->
    <main role="main" class="flex-grow-1 py-4">
        <div class="container-fluid px-md-4 max-w-7xl">
            <!-- Toast / Flash Messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4 d-flex align-items-center" role="alert">
                    <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4 d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="py-3 text-muted">
        <div class="container-fluid px-md-4 max-w-7xl d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <span class="small">&copy; @DateTime.Now.Year <strong>SmartRoom</strong> &bull; Campus & Office Room Booking System</span>
            <div class="d-flex align-items-center gap-3 small">
                <span class="badge bg-secondary-subtle text-secondary border">ASP.NET Core 8 MVC + REST API</span>
                <a href="/swagger" class="text-decoration-none text-muted"><i class="bi bi-braces"></i> OpenAPI</a>
                <a href="https://github.com" target="_blank" class="text-decoration-none text-muted"><i class="bi bi-github"></i> Repository</a>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
