@using System.Security.Claims
<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SmartRoom</title>

    <!-- Google Fonts: SF Pro / Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS (Play CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['-apple-system', 'BlinkMacSystemFont', 'SF Pro Display', 'SF Pro Text', 'Inter', 'sans-serif'],
                        mono: ['SF Mono', 'JetBrains Mono', 'monospace'],
                    }
                }
            }
        }
    </script>

    <!-- SmartRoom macOS 27 Liquid Glass Design System CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>

    <style>
        [x-cloak] { display: none !important; }
    </style>
</head>
<body class="min-h-full flex flex-col antialiased selection:bg-[#007AFF] selection:text-white" x-data="{ mobileMenuOpen: false }">

    <!-- macOS 27 Floating Glass Pill Top Navigation Bar -->
    <div class="sticky top-3.5 z-50 px-4 sm:px-6 lg:px-8 max-w-[1320px] mx-auto w-full pointer-events-none">
        <header class="liquid-glass-navbar px-4 sm:px-6 py-2.5 flex items-center justify-between gap-4 pointer-events-auto">
            
            <!-- Left: Brand Logo -->
            <div class="flex items-center gap-6">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5 text-[#1D1D1F] group">
                    <div class="w-8 h-8 rounded-xl bg-gradient-to-b from-[#2C2C2E] to-[#1C1C1E] text-white flex items-center justify-center font-bold text-sm shadow-sm group-hover:scale-105 transition-transform duration-200">
                        <span class="font-mono">S</span>
                    </div>
                    <div class="flex items-baseline gap-1.5">
                        <span class="font-bold text-base tracking-tight text-[#1D1D1F]">SmartRoom</span>
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-[#34C759]/15 text-[#116329] border border-[#34C759]/30">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#34C759] animate-pulse"></span> v2.7
                        </span>
                    </div>
                </a>

                <!-- Center: macOS 27 Segmented Control Navigation -->
                <nav class="hidden md:flex items-center liquid-segmented-control">
                    <a asp-controller="Home" asp-action="Index" 
                       class="liquid-segmented-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                        <span>Overview</span>
                    </a>
                    
                    <a asp-controller="Rooms" asp-action="Index" 
                       class="liquid-segmented-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Rooms" ? "active" : "")">
                        <span>Katalog Ruangan</span>
                    </a>

                    <a asp-controller="Bookings" asp-action="Index" 
                       class="liquid-segmented-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Bookings" && ViewContext.RouteData.Values["Action"]?.ToString() != "Manage" ? "active" : "")">
                        <span>Jadwal Peminjaman</span>
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Bookings" asp-action="Manage" 
                           class="liquid-segmented-item flex items-center gap-1.5 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Bookings" && ViewContext.RouteData.Values["Action"]?.ToString() == "Manage" ? "active" : "")">
                            <span>Persetujuan</span>
                            <span class="px-1.5 py-0.2 rounded-full text-[10px] font-mono bg-[#FF3B30] text-white font-bold shadow-xs">
                                Admin
                            </span>
                        </a>
                    }
                </nav>
            </div>

            <!-- Right: Action CTA & User Menu -->
            <div class="flex items-center gap-3">
                
                <!-- OpenAPI Spec Pill -->
                <a href="/swagger" target="_blank" 
                   class="hidden lg:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-mono text-[#515154] hover:text-[#1D1D1F] liquid-glass-subtle transition-all">
                    <i data-lucide="terminal" class="w-3.5 h-3.5 text-[#86868B]"></i>
                    <span>OpenAPI</span>
                    <i data-lucide="arrow-up-right" class="w-3 h-3 text-[#86868B]"></i>
                </a>

                <!-- Primary Booking Button (Apple Prominence Pill) -->
                <a asp-controller="Bookings" asp-action="Create" 
                   class="liquid-btn-primary">
                    <i data-lucide="plus" class="w-4 h-4 text-white"></i>
                    <span>Pinjam Ruangan</span>
                </a>

                <!-- User Account / RBAC Dropdown -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var role = User.FindFirstValue(ClaimTypes.Role) ?? "Student";
                    var initials = User.FindFirst("AvatarInitials")?.Value ?? "SR";
                    var roleBadgeClass = role switch {
                        "Admin" => "bg-[#FF3B30]/15 text-[#C91E14] border-[#FF3B30]/30",
                        "Staff" => "bg-[#007AFF]/15 text-[#0062CC] border-[#007AFF]/30",
                        _ => "bg-[#34C759]/15 text-[#116329] border-[#34C759]/30"
                    };

                    <div class="relative" x-data="{ userMenu: false }">
                        <button x-on:click="userMenu = !userMenu" 
                                class="flex items-center gap-2 p-1 pl-1.5 pr-2 rounded-full liquid-glass-subtle hover:bg-white transition-all shadow-sm">
                            <div class="w-7 h-7 rounded-full bg-[#1D1D1F] text-white font-mono text-[11px] font-bold flex items-center justify-center shadow-xs">
                                @initials
                            </div>
                            <div class="hidden sm:flex flex-col text-left">
                                <span class="text-xs font-semibold text-[#1D1D1F] leading-none">@User.Identity.Name?.Split(' ')[0]</span>
                            </div>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold border @roleBadgeClass">
                                @role
                            </span>
                            <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-[#86868B]"></i>
                        </button>

                        <!-- Profile Flyout (Liquid Glass Elevated Dialog) -->
                        <div x-show="userMenu" x-on:click.outside="userMenu = false" x-cloak
                             class="absolute right-0 mt-3 w-76 bg-white/90 backdrop-blur-2xl rounded-2xl shadow-2xl border border-white p-3.5 text-xs text-[#515154] z-50 space-y-3">
                            
                            <!-- User Information Header -->
                            <div class="p-3 rounded-xl bg-black/[0.03] border border-black/[0.04] space-y-1">
                                <div class="text-[10px] font-mono text-[#86868B] uppercase tracking-wider font-semibold">Akun Terautentikasi</div>
                                <div class="font-bold text-[#1D1D1F] text-sm">@User.Identity.Name</div>
                                <div class="text-[#86868B] font-mono text-[11px] truncate">@User.FindFirstValue(ClaimTypes.Email)</div>
                                <div class="pt-1 flex items-center gap-1.5 text-[10px] text-[#515154] font-mono">
                                    <span class="w-1.5 h-1.5 rounded-full bg-[#34C759]"></span>
                                    <span>@User.FindFirst("Department")?.Value</span>
                                </div>
                            </div>

                            <!-- Quick RBAC Switcher for Evaluation / Testing -->
                            <div class="p-3 bg-black/[0.03] rounded-xl border border-black/[0.04]">
                                <div class="text-[10px] font-mono uppercase tracking-wider text-[#86868B] font-semibold mb-2 flex items-center justify-between">
                                    <span>Uji Hak Peran (RBAC):</span>
                                    <i data-lucide="sparkles" class="w-3.5 h-3.5 text-[#007AFF]"></i>
                                </div>
                                <div class="grid grid-cols-3 gap-1.5">
                                    <!-- Switch to Admin -->
                                    <form asp-controller="Account" asp-action="QuickSwitch" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="targetRole" value="admin" />
                                        <button type="submit" class="w-full py-1.5 px-2 rounded-lg text-[10px] font-mono font-semibold transition-all text-center @(role == "Admin" ? "bg-[#FF3B30] text-white shadow-xs" : "bg-white text-[#515154] border border-black/[0.06] hover:bg-black/[0.04]")">
                                            Admin
                                        </button>
                                    </form>

                                    <!-- Switch to Staff -->
                                    <form asp-controller="Account" asp-action="QuickSwitch" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="targetRole" value="staff" />
                                        <button type="submit" class="w-full py-1.5 px-2 rounded-lg text-[10px] font-mono font-semibold transition-all text-center @(role == "Staff" ? "bg-[#007AFF] text-white shadow-xs" : "bg-white text-[#515154] border border-black/[0.06] hover:bg-black/[0.04]")">
                                            Staff
                                        </button>
                                    </form>

                                    <!-- Switch to Student -->
                                    <form asp-controller="Account" asp-action="QuickSwitch" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="targetRole" value="student" />
                                        <button type="submit" class="w-full py-1.5 px-2 rounded-lg text-[10px] font-mono font-semibold transition-all text-center @(role == "Student" ? "bg-[#34C759] text-white shadow-xs" : "bg-white text-[#515154] border border-black/[0.06] hover:bg-black/[0.04]")">
                                            Mhs
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <!-- Logout Action -->
                            <div class="pt-1 border-t border-black/[0.06]">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="w-full text-left px-3 py-2 rounded-lg text-[#FF3B30] hover:bg-[#FF3B30]/10 flex items-center gap-2 transition-colors font-semibold text-xs cursor-pointer">
                                        <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
                                        <span>Keluar Akun (Logout)</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" 
                       class="px-4 py-2 rounded-full text-xs font-semibold text-[#1D1D1F] liquid-glass-subtle hover:bg-white transition-all shadow-xs">
                        Masuk Portal &rarr;
                    </a>
                }

                <!-- Mobile Menu Hamburger -->
                <button x-on:click="mobileMenuOpen = !mobileMenuOpen" class="md:hidden p-2 rounded-full liquid-glass-subtle text-[#515154] hover:text-[#1D1D1F]">
                    <i data-lucide="menu" class="w-5 h-5"></i>
                </button>
            </div>
        </header>

        <!-- Mobile Navigation Drawer -->
        <div x-show="mobileMenuOpen" x-cloak class="md:hidden mt-2 p-3 rounded-2xl bg-white/90 backdrop-blur-2xl border border-white shadow-xl space-y-1 pointer-events-auto">
            <a asp-controller="Home" asp-action="Index" class="block px-3.5 py-2.5 rounded-xl text-xs font-medium text-[#1D1D1F] hover:bg-black/[0.04]">
                Overview Dashboard
            </a>
            <a asp-controller="Rooms" asp-action="Index" class="block px-3.5 py-2.5 rounded-xl text-xs font-medium text-[#1D1D1F] hover:bg-black/[0.04]">
                Katalog Ruangan
            </a>
            <a asp-controller="Bookings" asp-action="Index" class="block px-3.5 py-2.5 rounded-xl text-xs font-medium text-[#1D1D1F] hover:bg-black/[0.04]">
                Jadwal Peminjaman
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Bookings" asp-action="Manage" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-medium text-[#1D1D1F] hover:bg-black/[0.04]">
                    <span>Antrean Persetujuan</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-[#FF3B30] text-white font-bold">Admin</span>
                </a>
            }
            <a href="/swagger" target="_blank" class="block px-3.5 py-2.5 rounded-xl text-xs font-mono text-[#007AFF] hover:bg-black/[0.04]">
                OpenAPI Spec &rarr;
            </a>
        </div>
    </div>

    <!-- Main App Container -->
    <main class="flex-1 max-w-[1320px] w-full mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-14 relative z-10">
        
        <!-- Flash Feedback Banners (iOS Glass Feedback) -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 p-4 rounded-2xl bg-[#34C759]/15 border border-[#34C759]/35 text-[#116329] backdrop-blur-md flex items-center justify-between text-xs font-medium shadow-sm">
                <div class="flex items-center gap-2.5">
                    <i data-lucide="check-circle-2" class="w-4 h-4 text-[#34C759] flex-shrink-0"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-[#116329]/70 hover:text-[#116329] p-1">
                    <i data-lucide="x" class="w-3.5 h-3.5"></i>
                </button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-6 p-4 rounded-2xl bg-[#FF3B30]/15 border border-[#FF3B30]/35 text-[#C91E14] backdrop-blur-md flex items-center justify-between text-xs font-medium shadow-sm">
                <div class="flex items-center gap-2.5">
                    <i data-lucide="alert-circle" class="w-4 h-4 text-[#FF3B30] flex-shrink-0"></i>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-[#C91E14]/70 hover:text-[#C91E14] p-1">
                    <i data-lucide="x" class="w-3.5 h-3.5"></i>
                </button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- macOS 27 Sleek Glass Footer -->
    <footer class="mt-auto border-t border-white/60 bg-white/40 backdrop-blur-md py-6 text-xs text-[#86868B]">
        <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-2">
                <span class="font-bold text-[#1D1D1F]">SmartRoom</span>
                <span>&bull;</span>
                <span>macOS 27 Liquid Glass Reservation Architecture</span>
            </div>
            <div class="flex items-center gap-4 font-mono text-[11px] text-[#86868B]">
                <a href="/swagger" target="_blank" class="hover:text-[#007AFF] transition-colors flex items-center gap-1">
                    <span>OpenAPI Spec</span>
                    <span class="w-1.5 h-1.5 rounded-full bg-[#34C759]"></span>
                </a>
                <span>&bull;</span>
                <span class="text-[#515154]">ASP.NET Core 8 &bull; EF Core &bull; SQLite</span>
            </div>
        </div>
    </footer>

    <!-- Initialize Lucide Icons -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.lucide) {
                window.lucide.createIcons();
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
