@{
    ViewData["Title"] = "Terjadi Kesalahan";
}

<div class="max-w-md mx-auto my-16 text-center">
    <div class="p-8 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 border border-amber-200 flex items-center justify-center mx-auto mb-4">
            <i data-lucide="alert-triangle" class="w-6 h-6"></i>
        </div>
        <h2 class="text-lg font-bold text-slate-900 tracking-tight mb-2">Terjadi Gangguan Sistem</h2>
        <p class="text-xs text-slate-500 mb-6">
            Permintaan Anda tidak dapat diproses saat ini. Silakan coba beberapa saat lagi atau kembali ke dashboard.
        </p>
        <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-sm transition-all">
            <i data-lucide="home" class="w-4 h-4"></i>
            <span>Kembali ke Beranda</span>
        </a>
    </div>
</div>

@section Scripts {
    <script>lucide.createIcons();</script>
}
