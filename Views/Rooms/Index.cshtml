@model IEnumerable<SmartRoom.Models.Room>
@{
    ViewData["Title"] = "Katalog Ruangan";
    bool? currentFilter = ViewBag.CurrentFilter;
}

<!-- Page Header -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-6 border-b border-slate-200">
    <div>
        <div class="text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1">Inventaris Sarana &amp; Fasilitas</div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Katalog &amp; Manajemen Ruangan</h1>
        <p class="text-xs text-slate-500 mt-0.5">Daftar ruangan sidang, auditorium, laboratorium, dan kapasitas resmi kampus</p>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-sm transition-all">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span>Tambah Ruangan Baru</span>
        </a>
    }
</div>

<!-- Filter Tabs -->
<div class="flex items-center gap-1.5 p-1 rounded-xl bg-slate-200/60 w-fit mb-6 text-xs font-medium">
    <a asp-action="Index" class="px-3.5 py-1.5 rounded-lg transition-colors @(currentFilter == null ? "bg-white text-slate-900 shadow-sm font-semibold" : "text-slate-600 hover:text-slate-900")">
        Semua (@Model.Count())
    </a>
    <a asp-action="Index" asp-route-isActive="true" class="px-3.5 py-1.5 rounded-lg transition-colors @(currentFilter == true ? "bg-white text-slate-900 shadow-sm font-semibold" : "text-slate-600 hover:text-slate-900")">
        Aktif Saja (@Model.Count(r => r.IsActive))
    </a>
    <a asp-action="Index" asp-route-isActive="false" class="px-3.5 py-1.5 rounded-lg transition-colors @(currentFilter == false ? "bg-white text-slate-900 shadow-sm font-semibold" : "text-slate-600 hover:text-slate-900")">
        Nonaktif (@Model.Count(r => !r.IsActive))
    </a>
</div>

<!-- Rooms Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    @if (Model.Any())
    {
        @foreach (var room in Model)
        {
            <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-sm flex flex-col justify-between hover:border-slate-300 transition-all @(!room.IsActive ? "opacity-75" : "")">
                <div>
                    <!-- Header with Code & Status -->
                    <div class="flex items-center justify-between mb-3">
                        <span class="px-2.5 py-1 rounded-md bg-slate-100 text-slate-800 font-mono text-[11px] font-bold border border-slate-200">
                            @room.RoomCode
                        </span>
                        @if (room.IsActive)
                        {
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Aktif
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-500 border border-slate-200">
                                Nonaktif
                            </span>
                        }
                    </div>

                    <!-- Room Title & Building -->
                    <h3 class="text-base font-bold text-slate-900 tracking-tight mb-1">@room.Name</h3>
                    <div class="flex items-center gap-1.5 text-xs text-slate-500 mb-4">
                        <i data-lucide="map-pin" class="w-3.5 h-3.5 text-slate-400"></i>
                        <span>@room.Building</span>
                    </div>

                    <!-- Capacity Pill -->
                    <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between text-xs mb-4">
                        <span class="text-slate-500">Kapasitas Maksimal</span>
                        <span class="font-mono font-bold text-slate-900 flex items-center gap-1">
                            <i data-lucide="users" class="w-3.5 h-3.5 text-emerald-600"></i>
                            @room.Capacity Orang
                        </span>
                    </div>

                    <!-- Facilities -->
                    <div class="mb-4">
                        <div class="text-[10px] font-mono uppercase tracking-wider text-slate-400 font-semibold mb-2">Fasilitas Ruangan</div>
                        <div class="flex flex-wrap gap-1.5">
                            @if (!string.IsNullOrWhiteSpace(room.Facilities))
                            {
                                @foreach (var f in room.Facilities.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <span class="px-2 py-0.5 rounded-md bg-slate-100/80 text-slate-600 text-[11px] border border-slate-200/60">
                                        @f
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-xs text-slate-400 italic">Tidak ada keterangan fasilitas</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Footer Actions: Role Separated! -->
                <div class="pt-4 border-t border-slate-100 flex items-center justify-between mt-auto">
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="flex items-center gap-2">
                            <a asp-action="Edit" asp-route-id="@room.Id" class="px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 text-xs font-semibold text-slate-700 transition-colors inline-flex items-center gap-1.5">
                                <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                                <span>Edit</span>
                            </a>
                            <form asp-action="ToggleStatus" asp-route-id="@room.Id" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 text-xs font-semibold @(room.IsActive ? "text-amber-700" : "text-emerald-700") transition-colors inline-flex items-center gap-1.5">
                                    <i data-lucide="power" class="w-3.5 h-3.5"></i>
                                    <span>@(room.IsActive ? "Nonaktifkan" : "Aktifkan")</span>
                                </button>
                            </form>
                        </div>
                        <form asp-action="Delete" asp-route-id="@room.Id" method="post" class="m-0"
                              onsubmit="return confirm('Hapus ruangan @room.Name?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="p-1.5 rounded-lg hover:bg-rose-50 text-slate-400 hover:text-rose-600 transition-colors" title="Hapus Ruangan">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </form>
                    }
                    else
                    {
                        <!-- Civitas / Student / Staff direct booking button -->
                        <a asp-controller="Bookings" asp-action="Create" asp-route-roomId="@room.Id" 
                           class="w-full py-2 px-3 rounded-lg text-center text-xs font-semibold transition-all @(room.IsActive ? "bg-slate-900 hover:bg-slate-800 text-white shadow-sm" : "bg-slate-100 text-slate-400 pointer-events-none") flex items-center justify-center gap-2">
                            <i data-lucide="calendar-plus" class="w-4 h-4"></i>
                            <span>Ajukan Peminjaman Ruangan Ini</span>
                        </a>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-span-full py-16 text-center bg-white rounded-2xl border border-slate-200 p-8">
            <i data-lucide="door-closed" class="w-12 h-12 text-slate-300 mx-auto mb-3"></i>
            <h3 class="text-sm font-bold text-slate-800 mb-1">Tidak Ada Ruangan</h3>
            <p class="text-xs text-slate-500 mb-4">Belum ada inventaris ruangan dengan filter yang dipilih.</p>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-emerald-600 text-white text-xs font-semibold hover:bg-emerald-500">
                    <i data-lucide="plus" class="w-4 h-4"></i> Tambah Ruangan Baru
                </a>
            }
        </div>
    }
</div>

@section Scripts {
    <script>lucide.createIcons();</script>
}
