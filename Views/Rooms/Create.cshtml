@model SmartRoom.Models.Room
@{
    ViewData["Title"] = "Pendaftaran Ruangan Baru";
}

<div class="row justify-content-center py-2">
    <div class="col-12 col-md-8 col-lg-7">
        <div class="d-flex align-items-center gap-2 mb-3">
            <a asp-action="Index" class="btn btn-sm btn-minimal-secondary py-1 px-2">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h4 class="fw-bold text-dark mb-0 tracking-tight">Tambah Ruangan Baru</h4>
                <small class="text-muted">Akses Khusus Administrator &bull; Sarana &amp; Prasarana</small>
            </div>
        </div>

        <div class="card-minimal p-4 bg-white">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2.5 small rounded-2 mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="RoomCode" class="form-label small fw-semibold text-secondary">Kode Ruangan <span class="text-danger">*</span></label>
                        <input asp-for="RoomCode" class="form-control font-mono" placeholder="R-SIDANG-01" required />
                        <span asp-validation-for="RoomCode" class="text-danger small"></span>
                        <div class="form-text font-mono" style="font-size: 0.72rem;">Harus unik dalam sistem.</div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Capacity" class="form-label small fw-semibold text-secondary">Kapasitas (Orang) <span class="text-danger">*</span></label>
                        <input asp-for="Capacity" type="number" min="1" max="1000" class="form-control font-mono" placeholder="40" required />
                        <span asp-validation-for="Capacity" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Name" class="form-label small fw-semibold text-secondary">Nama Ruangan <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Ruang Sidang Utama Lt. 2" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Building" class="form-label small fw-semibold text-secondary">Lokasi / Gedung <span class="text-danger">*</span></label>
                        <input asp-for="Building" class="form-control" placeholder="Gedung Fakultas TI" required />
                        <span asp-validation-for="Building" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Facilities" class="form-label small fw-semibold text-secondary">Daftar Fasilitas Ruangan</label>
                        <textarea asp-for="Facilities" rows="3" class="form-control" placeholder="Proyektor 4K, AC, Sound System, Smart TV, Papan Tulis"></textarea>
                        <span asp-validation-for="Facilities" class="text-danger small"></span>
                        <div class="form-text" style="font-size: 0.72rem;">Pisahkan tiap fasilitas dengan tanda koma.</div>
                    </div>

                    <div class="col-12">
                        <div class="p-3 bg-light rounded-2 border d-flex align-items-center justify-content-between">
                            <div>
                                <div class="fw-semibold small text-dark">Status Operasional Aktif</div>
                                <div class="text-muted" style="font-size: 0.72rem;">Jika aktif, ruangan dapat langsung dipesan oleh mahasiswa dan staf.</div>
                            </div>
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive" checked>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 mt-4 pt-3 border-top d-flex align-items-center justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-minimal-secondary">Batal</a>
                        <button type="submit" class="btn btn-minimal-primary">
                            <i class="bi bi-check2 me-1"></i> Simpan Ruangan
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
