@model SmartRoom.Models.Room
@{
    ViewData["Title"] = "Tambah Ruangan";
}

<div class="max-w-2xl mx-auto my-4 space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3 pb-6 border-b border-zinc-200/80">
        <a asp-action="Index" class="p-2 rounded-xl border border-zinc-200 bg-white hover:bg-zinc-50 text-zinc-600 transition-colors shadow-xs">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
        </a>
        <div>
            <div class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider font-semibold">Administrator Desk</div>
            <h1 class="text-xl font-bold tracking-tight text-zinc-950">Tambah Ruangan Baru</h1>
            <p class="text-xs text-zinc-500 mt-0.5">Daftarkan ruang rapat, seminar, atau laboratorium ke dalam inventaris sistem</p>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-2xl border border-zinc-200/80 p-6 sm:p-8 shadow-xs">
        <form asp-action="Create" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-3 rounded-xl bg-[#FEE2E2] border border-[#FECACA] text-[#991B1B] text-xs"></div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="RoomCode" class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-zinc-700 mb-1.5">
                        Kode Ruangan <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="RoomCode" class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-zinc-900 text-xs font-mono focus:bg-white focus:border-zinc-900 focus:outline-none transition-all"
                           placeholder="Contoh: R-SIDANG-01" required />
                    <span asp-validation-for="RoomCode" class="text-rose-500 text-[10px]"></span>
                </div>

                <div>
                    <label asp-for="Capacity" class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-zinc-700 mb-1.5">
                        Kapasitas Kursi <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="Capacity" type="number" min="1" max="1000" class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-zinc-900 text-xs font-mono focus:bg-white focus:border-zinc-900 focus:outline-none transition-all"
                           placeholder="50" required />
                    <span asp-validation-for="Capacity" class="text-rose-500 text-[10px]"></span>
                </div>
            </div>

            <div>
                <label asp-for="Name" class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-zinc-700 mb-1.5">
                    Nama Ruangan <span class="text-rose-500">*</span>
                </label>
                <input asp-for="Name" class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-zinc-900 text-xs focus:bg-white focus:border-zinc-900 focus:outline-none transition-all"
                       placeholder="Contoh: Ruang Sidang Utama Lt. 2" required />
                <span asp-validation-for="Name" class="text-rose-500 text-[10px]"></span>
            </div>

            <div>
                <label asp-for="Building" class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-zinc-700 mb-1.5">
                    Gedung / Lokasi <span class="text-rose-500">*</span>
                </label>
                <input asp-for="Building" class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-zinc-900 text-xs focus:bg-white focus:border-zinc-900 focus:outline-none transition-all"
                       placeholder="Contoh: Gedung Fakultas Teknik Informatika" required />
                <span asp-validation-for="Building" class="text-rose-500 text-[10px]"></span>
            </div>

            <div>
                <label asp-for="Facilities" class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-zinc-700 mb-1.5">
                    Fasilitas Ruangan (Pisahkan dengan koma)
                </label>
                <textarea asp-for="Facilities" rows="3" class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-zinc-900 text-xs focus:bg-white focus:border-zinc-900 focus:outline-none transition-all"
                          placeholder="Proyektor 4K, Smart TV 75 Inch, AC Split, Sound System, Podium"></textarea>
                <span asp-validation-for="Facilities" class="text-rose-500 text-[10px]"></span>
            </div>

            <!-- Active Status Toggle -->
            <div class="p-4 rounded-xl bg-zinc-50 border border-zinc-200/80 flex items-center justify-between">
                <div>
                    <div class="text-xs font-semibold text-zinc-900">Status Operasional Aktif</div>
                    <div class="text-[11px] text-zinc-500 mt-0.5">Jika aktif, ruangan langsung siap untuk dipilih pada formulir peminjaman.</div>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" asp-for="IsActive" class="sr-only peer" checked>
                    <div class="w-11 h-6 bg-zinc-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-zinc-900"></div>
                </label>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-zinc-100">
                <a asp-action="Index" class="px-4 py-2.5 rounded-xl border border-zinc-200 text-xs font-medium text-zinc-700 hover:bg-zinc-50 transition-colors">
                    Batal
                </a>
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-medium shadow-xs transition-all active:scale-[0.98]">
                    Simpan Ruangan Baru
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.lucide) {
                window.lucide.createIcons();
            }
        });
    </script>
}