@model SmartRoom.Models.Room
@{
    ViewData["Title"] = "Tambah Ruangan Baru";
}

<div class="max-w-2xl mx-auto my-4 space-y-7">
    
    <!-- macOS 27 Header -->
    <div class="liquid-glass-header p-6 sm:p-7 flex items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <a asp-action="Index" class="liquid-glass-pill p-2.5 hover:bg-white text-[#1D1D1F] transition-all shadow-sm">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
            </a>
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-[#007AFF]/12 text-[#0062CC] border border-[#007AFF]/25">
                        ADMINISTRATOR DESK
                    </span>
                    <span class="text-[#86868B]">&bull;</span>
                    <span class="text-xs font-mono text-[#515154]">Registrasi Inventaris</span>
                </div>
                <h1 class="text-2xl font-bold tracking-tight text-[#1D1D1F]">Tambah Ruangan Baru</h1>
                <p class="text-xs text-[#515154] mt-0.5">Daftarkan ruang rapat, seminar, atau laboratorium ke dalam inventaris kampus</p>
            </div>
        </div>
    </div>

    <!-- Liquid Glass Form Card -->
    <div class="liquid-glass-elevated p-6 sm:p-8">
        <form asp-action="Create" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-3.5 rounded-2xl bg-[#FF3B30]/15 border border-[#FF3B30]/30 text-[#C91E14] text-xs font-mono"></div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="RoomCode" class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-[#515154] mb-1.5">
                        Kode Ruangan <span class="text-[#FF3B30]">*</span>
                    </label>
                    <input asp-for="RoomCode" class="liquid-glass-input w-full px-4 py-2.5 text-xs font-mono font-bold"
                           placeholder="Contoh: R-SIDANG-01" required />
                    <span asp-validation-for="RoomCode" class="text-[#FF3B30] text-[10px] font-mono"></span>
                </div>

                <div>
                    <label asp-for="Capacity" class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-[#515154] mb-1.5">
                        Kapasitas Kursi <span class="text-[#FF3B30]">*</span>
                    </label>
                    <input asp-for="Capacity" type="number" min="1" max="1000" class="liquid-glass-input w-full px-4 py-2.5 text-xs font-mono font-bold"
                           placeholder="50" required />
                    <span asp-validation-for="Capacity" class="text-[#FF3B30] text-[10px] font-mono"></span>
                </div>
            </div>

            <div>
                <label asp-for="Name" class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-[#515154] mb-1.5">
                    Nama Ruangan <span class="text-[#FF3B30]">*</span>
                </label>
                <input asp-for="Name" class="liquid-glass-input w-full px-4 py-2.5 text-xs"
                       placeholder="Contoh: Ruang Sidang Utama Lt. 2" required />
                <span asp-validation-for="Name" class="text-[#FF3B30] text-[10px] font-mono"></span>
            </div>

            <div>
                <label asp-for="Building" class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-[#515154] mb-1.5">
                    Gedung / Lokasi Kampus <span class="text-[#FF3B30]">*</span>
                </label>
                <input asp-for="Building" class="liquid-glass-input w-full px-4 py-2.5 text-xs"
                       placeholder="Contoh: Gedung Fakultas Teknik Informatika" required />
                <span asp-validation-for="Building" class="text-[#FF3B30] text-[10px] font-mono"></span>
            </div>

            <div>
                <label asp-for="Facilities" class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-[#515154] mb-1.5">
                    Fasilitas Ruangan (Pisahkan dengan tanda koma)
                </label>
                <textarea asp-for="Facilities" rows="3" class="liquid-glass-input w-full px-4 py-2.5 text-xs"
                          placeholder="Proyektor 4K, Smart TV 75 Inch, AC Split, Sound System, Podium Digital"></textarea>
                <span asp-validation-for="Facilities" class="text-[#FF3B30] text-[10px] font-mono"></span>
            </div>

            <!-- iOS Smooth Active Status Toggle Switch -->
            <div class="p-4 rounded-2xl bg-white/70 border border-white/80 shadow-xs flex items-center justify-between">
                <div>
                    <div class="text-xs font-bold text-[#1D1D1F]">Status Operasional Aktif</div>
                    <div class="text-[11px] text-[#515154] mt-0.5">Jika aktif, ruangan langsung siap untuk dipilih pada formulir peminjaman.</div>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" asp-for="IsActive" class="sr-only peer" checked>
                    <div class="w-11 h-6 bg-black/15 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#34C759]"></div>
                </label>
            </div>

            <div class="flex items-center justify-end gap-3 pt-5 border-t border-black/[0.05]">
                <a asp-action="Index" class="liquid-btn-secondary px-5 py-2.5 text-xs">
                    Batal
                </a>
                <button type="submit" class="liquid-btn-primary px-6 py-2.5 text-xs flex items-center gap-2">
                    <i data-lucide="plus" class="w-4 h-4 text-white"></i>
                    <span>Simpan Ruangan Baru</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.lucide) {
                window.lucide.createIcons();
            }
        });
    </script>
}
