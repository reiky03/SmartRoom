@model SmartRoom.Models.Room
@{
    ViewData["Title"] = "Perbarui Data Ruangan";
}

<div class="row justify-content-center py-2">
    <div class="col-12 col-md-8 col-lg-7">
        <div class="d-flex align-items-center gap-2 mb-3">
            <a asp-action="Index" class="btn btn-sm btn-minimal-secondary py-1 px-2">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h4 class="fw-bold text-dark mb-0 tracking-tight">Edit Ruangan: @Model.Name</h4>
                <small class="text-muted font-mono">@Model.RoomCode &bull; Administrator Only</small>
            </div>
        </div>

        <div class="card-minimal p-4 bg-white">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2.5 small rounded-2 mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="RoomCode" class="form-label small fw-semibold text-secondary">Kode Ruangan</label>
                        <input asp-for="RoomCode" class="form-control font-mono" required />
                        <span asp-validation-for="RoomCode" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Capacity" class="form-label small fw-semibold text-secondary">Kapasitas (Orang)</label>
                        <input asp-for="Capacity" type="number" min="1" max="1000" class="form-control font-mono" required />
                        <span asp-validation-for="Capacity" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Name" class="form-label small fw-semibold text-secondary">Nama Ruangan</label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Building" class="form-label small fw-semibold text-secondary">Lokasi / Gedung</label>
                        <input asp-for="Building" class="form-control" required />
                        <span asp-validation-for="Building" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Facilities" class="form-label small fw-semibold text-secondary">Daftar Fasilitas</label>
                        <textarea asp-for="Facilities" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="Facilities" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="p-3 bg-light rounded-2 border d-flex align-items-center justify-content-between">
                            <div>
                                <div class="fw-semibold small text-dark">Status Operasional Aktif</div>
                                <div class="text-muted" style="font-size: 0.72rem;">Jika dimatikan, ruangan tidak akan muncul di daftar pilihan formulir peminjaman.</div>
                            </div>
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive">
                            </div>
                        </div>
                    </div>

                    <div class="col-12 mt-4 pt-3 border-top d-flex align-items-center justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-minimal-secondary">Batal</a>
                        <button type="submit" class="btn btn-minimal-primary">
                            <i class="bi bi-check2 me-1"></i> Simpan Perubahan
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
