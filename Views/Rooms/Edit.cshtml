@model SmartRoom.Models.Room
@{
    ViewData["Title"] = "Edit Ruangan";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-7">
        <div class="d-flex align-items-center gap-2 mb-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-circle">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h3 class="fw-bold text-dark mb-0">Edit Ruangan: @Model.Name</h3>
        </div>

        <div class="card shadow-sm border-0 bg-white">
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="RoomCode" class="form-label fw-semibold small"></label>
                            <input asp-for="RoomCode" class="form-control" />
                            <span asp-validation-for="RoomCode" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Capacity" class="form-label fw-semibold small"></label>
                            <div class="input-group">
                                <input asp-for="Capacity" type="number" min="1" class="form-control" />
                                <span class="input-group-text bg-light">Orang</span>
                            </div>
                            <span asp-validation-for="Capacity" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Name" class="form-label fw-semibold small"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Building" class="form-label fw-semibold small"></label>
                            <input asp-for="Building" class="form-control" />
                            <span asp-validation-for="Building" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Facilities" class="form-label fw-semibold small"></label>
                            <textarea asp-for="Facilities" rows="3" class="form-control"></textarea>
                            <span asp-validation-for="Facilities" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive">
                                <label class="form-check-label fw-semibold" asp-for="IsActive">
                                    Status Ruangan Aktif
                                </label>
                            </div>
                        </div>

                        <div class="col-12 mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Batal</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                <i class="bi bi-save me-1"></i> Simpan Perubahan
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
