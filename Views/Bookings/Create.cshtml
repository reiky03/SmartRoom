@model SmartRoom.DTOs.CreateBookingDto
@{
    ViewData["Title"] = "Ajukan Peminjaman Ruangan";
}

<div class="max-w-2xl mx-auto my-4" x-data="bookingApp()">
    <div class="flex items-center gap-3 mb-6">
        <a asp-action="Index" class="p-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
        </a>
        <div>
            <h1 class="text-xl font-bold tracking-tight text-slate-900">Formulir Peminjaman Ruangan</h1>
            <p class="text-xs text-slate-500">Pencegahan Double-Booking Terintegrasi &bull; Verifikasi Alur Persetujuan</p>
        </div>
    </div>

    @if (ViewBag.ConflictAlert != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 flex items-start gap-3 shadow-sm">
            <i data-lucide="alert-octagon" class="w-5 h-5 text-rose-600 flex-shrink-0 mt-0.5"></i>
            <div>
                <div class="font-bold text-xs">Jadwal Bentrok Terdeteksi!</div>
                <div class="text-xs text-rose-700 mt-0.5">@ViewBag.ConflictAlert</div>
            </div>
        </div>
    }

    <div class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 shadow-sm">
        <form asp-action="Create" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-xs"></div>

            <!-- Room Picker -->
            <div>
                <label asp-for="RoomId" class="block text-xs font-mono uppercase tracking-wider font-semibold text-slate-700 mb-1.5">
                    Pilih Ruangan <span class="text-rose-500">*</span>
                </label>
                <select asp-for="RoomId" id="selectRoom" x-model="selectedRoom" x-on:change="fetchAvailability()"
                        class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-slate-900 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none" asp-items="ViewBag.Rooms" required>
                    <option value="">— Silakan Pilih Ruangan —</option>
                </select>
                <span asp-validation-for="RoomId" class="text-rose-500 text-[10px]"></span>
            </div>

            <!-- Borrower Info -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="BorrowerName" class="block text-xs font-mono uppercase tracking-wider font-semibold text-slate-700 mb-1.5">
                        Nama Pemohon <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="BorrowerName" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-slate-900 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none"
                           placeholder="Nama Lengkap Pemohon / Organisasi" required />
                    <span asp-validation-for="BorrowerName" class="text-rose-500 text-[10px]"></span>
                </div>

                <div>
                    <label asp-for="BorrowerEmail" class="block text-xs font-mono uppercase tracking-wider font-semibold text-slate-700 mb-1.5">
                        Email Kontak <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="BorrowerEmail" type="email" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-slate-900 text-xs font-mono focus:ring-2 focus:ring-emerald-500 focus:outline-none"
                           placeholder="nama@kampus.ac.id" required />
                    <span asp-validation-for="BorrowerEmail" class="text-rose-500 text-[10px]"></span>
                </div>
            </div>

            <!-- Purpose -->
            <div>
                <label asp-for="Purpose" class="block text-xs font-mono uppercase tracking-wider font-semibold text-slate-700 mb-1.5">
                    Agenda / Tujuan Peminjaman <span class="text-rose-500">*</span>
                </label>
                <textarea asp-for="Purpose" rows="2" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-slate-900 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none"
                          placeholder="Contoh: Sidang Terbuka Tugas Akhir / Workshop Praktikum Jaringan Komputer" required></textarea>
                <span asp-validation-for="Purpose" class="text-rose-500 text-[10px]"></span>
            </div>

            <!-- Timeslots -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="StartTime" class="block text-xs font-mono uppercase tracking-wider font-semibold text-slate-700 mb-1.5">
                        Waktu Mulai <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="StartTime" id="inputStartTime" x-model="startTime" x-on:change="fetchAvailability()" type="datetime-local" 
                           class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-slate-900 text-xs font-mono focus:ring-2 focus:ring-emerald-500 focus:outline-none"
                           value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")" required />
                    <span asp-validation-for="StartTime" class="text-rose-500 text-[10px]"></span>
                </div>

                <div>
                    <label asp-for="EndTime" class="block text-xs font-mono uppercase tracking-wider font-semibold text-slate-700 mb-1.5">
                        Waktu Selesai <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="EndTime" id="inputEndTime" type="datetime-local"
                           class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-slate-900 text-xs font-mono focus:ring-2 focus:ring-emerald-500 focus:outline-none"
                           value="@Model.EndTime.ToString("yyyy-MM-ddTHH:mm")" required />
                    <span asp-validation-for="EndTime" class="text-rose-500 text-[10px]"></span>
                </div>
            </div>

            <!-- Interactive Live Slot Availability Indicator -->
            <div x-show="showSlots" x-cloak class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-[11px] font-mono uppercase tracking-wider font-bold text-slate-700 flex items-center gap-1.5">
                        <i data-lucide="clock" class="w-3.5 h-3.5 text-emerald-600"></i>
                        <span>Slot Terisi Pada Tanggal Terpilih:</span>
                    </span>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white border border-slate-200 text-slate-500" x-text="dateLabel"></span>
                </div>

                <template x-if="isLoading">
                    <div class="text-xs text-slate-400 font-mono flex items-center gap-2 py-1">
                        <i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i>
                        <span>Mengecek ketersediaan jam ruangan...</span>
                    </div>
                </template>

                <template x-if="!isLoading && slots.length > 0">
                    <div class="space-y-1.5 pt-1">
                        <template x-for="slot in slots" :key="slot.bookingReference">
                            <div class="flex items-center justify-between p-2 rounded-lg bg-white border border-slate-200 text-xs">
                                <div class="flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full" :class="slot.status === 'Approved' ? 'bg-emerald-500' : 'bg-amber-500'"></span>
                                    <span class="font-mono font-bold text-slate-900" x-text="formatTime(slot.startTime) + ' — ' + formatTime(slot.endTime)"></span>
                                    <span class="text-slate-500 truncate" x-text="'(' + slot.borrowerName + ')'"></span>
                                </div>
                                <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold"
                                      :class="slot.status === 'Approved' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-amber-50 text-amber-700 border border-amber-200'"
                                      x-text="slot.status"></span>
                            </div>
                        </template>
                    </div>
                </template>

                <template x-if="!isLoading && slots.length === 0">
                    <div class="text-xs text-emerald-700 font-medium flex items-center gap-1.5 py-1">
                        <i data-lucide="check-circle" class="w-4 h-4 text-emerald-600"></i>
                        <span>Seluruh slot jam pada tanggal ini masih bebas dan tersedia.</span>
                    </div>
                </template>
            </div>

            <!-- Validation Note -->
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 text-slate-500 text-xs">
                <div class="font-semibold text-slate-700 mb-1 font-mono uppercase text-[10px]">Aturan Otomatis Backend:</div>
                <ul class="list-disc list-inside space-y-0.5 text-[11px]">
                    <li>Durasi sewa minimal <strong>30 menit</strong> dan maksimal <strong>8 jam</strong>.</li>
                    <li>Sistem menolak otomatis jika jadwal beririsan dengan jadwal <code>Pending</code> atau <code>Approved</code>.</li>
                </ul>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <a asp-action="Index" class="px-4 py-2.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
                    Batal
                </a>
                <button type="submit" class="px-5 py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold shadow-sm transition-all flex items-center gap-1.5">
                    <i data-lucide="send" class="w-4 h-4"></i>
                    <span>Kirim Pengajuan</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function bookingApp() {
            return {
                selectedRoom: '@Model.RoomId' || '',
                startTime: '@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")',
                showSlots: false,
                isLoading: false,
                dateLabel: '',
                slots: [],
                init() {
                    if (this.selectedRoom && this.startTime) {
                        this.fetchAvailability();
                    }
                },
                async fetchAvailability() {
                    if (!this.selectedRoom || !this.startTime) {
                        this.showSlots = false;
                        return;
                    }
                    const dateStr = this.startTime.split('T')[0];
                    this.dateLabel = dateStr;
                    this.showSlots = true;
                    this.isLoading = true;

                    try {
                        const res = await fetch(`/api/rooms/${this.selectedRoom}/availability?date=${dateStr}`);
                        if (res.ok) {
                            const data = await res.json();
                            this.slots = data.bookedSlots || [];
                        }
                    } catch (e) {
                        console.error('Error fetching availability:', e);
                    } finally {
                        this.isLoading = false;
                        this.$nextTick(() => { lucide.createIcons(); });
                    }
                },
                formatTime(isoString) {
                    const d = new Date(isoString);
                    return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                }
            }
        }
    </script>
}
