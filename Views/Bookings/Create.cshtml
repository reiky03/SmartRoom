@model SmartRoom.DTOs.CreateBookingDto
@{
    ViewData["Title"] = "Formulir Pengajuan Peminjaman";
}

<div class="row justify-content-center py-2">
    <div class="col-12 col-lg-8">
        <div class="d-flex align-items-center gap-2 mb-3">
            <a asp-action="Index" class="btn btn-sm btn-minimal-secondary py-1 px-2">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h4 class="fw-bold text-dark mb-0 tracking-tight">Pengajuan Peminjaman Ruangan</h4>
                <small class="text-muted">Pencegahan Double-Booking Otomatis &bull; Verifikasi Alur Persetujuan</small>
            </div>
        </div>

        @if (ViewBag.ConflictAlert != null)
        {
            <div class="alert alert-danger card-minimal p-3 mb-4 d-flex align-items-start gap-2.5" style="background-color: #fff1f2; border-color: #fecdd3;">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5 mt-0.5"></i>
                <div>
                    <div class="fw-bold small text-danger-emphasis">Jadwal Bentrok Terdeteksi</div>
                    <div class="small text-danger-emphasis">@ViewBag.ConflictAlert</div>
                </div>
            </div>
        }

        <div class="card-minimal p-4 bg-white mb-4">
            <form asp-action="Create" method="post" id="bookingForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2.5 small rounded-2 mb-3"></div>

                <div class="row g-3">
                    <!-- Room Selection -->
                    <div class="col-12">
                        <label asp-for="RoomId" class="form-label small fw-semibold text-secondary">Pilih Ruangan <span class="text-danger">*</span></label>
                        <select asp-for="RoomId" class="form-select form-select-md" asp-items="ViewBag.Rooms" id="selectRoom" required>
                            <option value="">— Silakan Pilih Ruangan —</option>
                        </select>
                        <span asp-validation-for="RoomId" class="text-danger small"></span>
                    </div>

                    <!-- Borrower Identity -->
                    <div class="col-md-6">
                        <label asp-for="BorrowerName" class="form-label small fw-semibold text-secondary">Nama Lengkap Pemohon <span class="text-danger">*</span></label>
                        <input asp-for="BorrowerName" class="form-control" placeholder="Nama Anda / UKM / Departemen" required />
                        <span asp-validation-for="BorrowerName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="BorrowerEmail" class="form-label small fw-semibold text-secondary">Email Kontak Pemohon <span class="text-danger">*</span></label>
                        <input asp-for="BorrowerEmail" type="email" class="form-control font-mono" placeholder="email@kampus.ac.id" required />
                        <span asp-validation-for="BorrowerEmail" class="text-danger small"></span>
                    </div>

                    <!-- Purpose -->
                    <div class="col-12">
                        <label asp-for="Purpose" class="form-label small fw-semibold text-secondary">Agenda / Tujuan Penggunaan <span class="text-danger">*</span></label>
                        <textarea asp-for="Purpose" rows="2" class="form-control" placeholder="Contoh: Sidang Tugas Akhir, Workshop Pemrograman, Rapat Koordinasi Fakultas" required></textarea>
                        <span asp-validation-for="Purpose" class="text-danger small"></span>
                    </div>

                    <!-- Time Slots -->
                    <div class="col-md-6">
                        <label asp-for="StartTime" class="form-label small fw-semibold text-secondary">Waktu Mulai <span class="text-danger">*</span></label>
                        <input asp-for="StartTime" type="datetime-local" class="form-control font-mono" id="inputStartTime"
                               value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")" required />
                        <span asp-validation-for="StartTime" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EndTime" class="form-label small fw-semibold text-secondary">Waktu Selesai <span class="text-danger">*</span></label>
                        <input asp-for="EndTime" type="datetime-local" class="form-control font-mono" id="inputEndTime"
                               value="@Model.EndTime.ToString("yyyy-MM-ddTHH:mm")" required />
                        <span asp-validation-for="EndTime" class="text-danger small"></span>
                    </div>

                    <!-- Real-time Slot Availability Inspector -->
                    <div class="col-12" id="slotInspector" style="display: none;">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="font-mono text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">
                                    <i class="bi bi-clock-history me-1 text-primary"></i>Status Slot Terisi Pada Tanggal Terpilih:
                                </span>
                                <span class="badge bg-white text-dark border font-mono" id="slotDateLabel" style="font-size: 0.7rem;"></span>
                            </div>
                            <div id="slotFeedback" class="small text-muted font-mono">
                                Memeriksa ketersediaan jadwal...
                            </div>
                        </div>
                    </div>

                    <!-- Business Rules Info -->
                    <div class="col-12">
                        <div class="p-3 rounded-2 border bg-light text-muted small" style="font-size: 0.78rem;">
                            <div class="fw-semibold text-dark mb-1 font-mono text-uppercase" style="font-size: 0.7rem;">
                                <i class="bi bi-shield-check me-1 text-primary"></i>Validasi Otomatis Sistem:
                            </div>
                            <ul class="mb-0 ps-3">
                                <li>Durasi peminjaman: minimal <strong>30 menit</strong>, maksimal <strong>8 jam</strong>.</li>
                                <li>Pencegahan bentrok aktif: jika beririsan dengan jadwal <code>Pending</code> atau <code>Approved</code>, pengajuan otomatis ditolak.</li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-12 mt-4 pt-3 border-top d-flex align-items-center justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-minimal-secondary">Batal</a>
                        <button type="submit" class="btn btn-minimal-primary" id="btnSubmit">
                            <i class="bi bi-send me-1"></i> Kirim Pengajuan Peminjaman
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selectRoom = document.getElementById('selectRoom');
            const inputStartTime = document.getElementById('inputStartTime');
            const inputEndTime = document.getElementById('inputEndTime');
            const slotInspector = document.getElementById('slotInspector');
            const slotFeedback = document.getElementById('slotFeedback');
            const slotDateLabel = document.getElementById('slotDateLabel');

            async function checkAvailability() {
                const roomId = selectRoom.value;
                const startVal = inputStartTime.value;
                if (!roomId || !startVal) {
                    slotInspector.style.display = 'none';
                    return;
                }

                const dateStr = startVal.split('T')[0];
                slotDateLabel.textContent = dateStr;
                slotInspector.style.display = 'block';
                slotFeedback.innerHTML = '<span class="text-muted"><i class="bi bi-hourglass me-1"></i>Mengecek server...</span>';

                try {
                    const res = await fetch(`/api/rooms/${roomId}/availability?date=${dateStr}`);
                    if (!res.ok) return;
                    const data = await res.json();

                    if (data.bookedSlots && data.bookedSlots.length > 0) {
                        let html = '<div class="d-flex flex-wrap gap-1.5 mt-1">';
                        data.bookedSlots.forEach(slot => {
                            const start = new Date(slot.startTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                            const end = new Date(slot.endTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                            const badgeBg = slot.status === 'Approved' ? 'badge-soft-approved' : 'badge-soft-pending';
                            html += `<span class="badge-pill-soft ${badgeBg}" style="font-size: 0.72rem;">
                                <i class="bi bi-lock-fill"></i> ${start} — ${end} (${slot.borrowerName})
                            </span>`;
                        });
                        html += '</div>';
                        slotFeedback.innerHTML = html;
                    } else {
                        slotFeedback.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Semua jam tersedia bebas pada tanggal ini.</span>';
                    }
                } catch (err) {
                    console.error('Availability check error:', err);
                }
            }

            selectRoom.addEventListener('change', checkAvailability);
            inputStartTime.addEventListener('change', checkAvailability);
            if (selectRoom.value && inputStartTime.value) {
                checkAvailability();
            }
        });
    </script>
}
