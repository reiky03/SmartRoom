@model SmartRoom.DTOs.CreateBookingDto
@{
    ViewData["Title"] = "Ajukan Peminjaman Ruangan";
}

<div class="space-y-6" x-data="bookingApp()">
    
    <!-- Header -->
    <div class="flex items-center gap-3 pb-6 border-b border-zinc-200/80">
        <a asp-action="Index" class="p-2 rounded-xl border border-zinc-200 bg-white hover:bg-zinc-50 text-zinc-600 transition-colors shadow-xs">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
        </a>
        <div>
            <div class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider font-semibold">Reservasi &bull; Self-Service Civitas</div>
            <h1 class="text-2xl font-bold tracking-tight text-zinc-950">Formulir Peminjaman Ruangan</h1>
            <p class="text-xs text-zinc-500 mt-0.5">Pencegahan Double-Booking LINQ Otomatis &bull; Verifikasi Alur Persetujuan</p>
        </div>
    </div>

    <!-- Conflict Warning Alert (Server Side) -->
    @if (ViewBag.ConflictAlert != null)
    {
        <div class="p-4 rounded-xl bg-[#FEE2E2] border border-[#FECACA] text-[#991B1B] flex items-start gap-3 shadow-xs">
            <i data-lucide="alert-octagon" class="w-5 h-5 text-[#991B1B] flex-shrink-0 mt-0.5"></i>
            <div>
                <div class="font-bold text-xs">Jadwal Bentrok Terdeteksi!</div>
                <div class="text-xs text-[#991B1B]/90 mt-0.5">@ViewBag.ConflictAlert</div>
            </div>
        </div>
    }

    <!-- 2-Column Modular Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- Left Column: The Form (7 cols) -->
        <div class="lg:col-span-7 bg-white rounded-2xl border border-zinc-200/80 p-6 sm:p-8 shadow-xs">
            <form asp-action="Create" method="post" class="space-y-5">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="p-3 rounded-xl bg-[#FEE2E2] border border-[#FECACA] text-[#991B1B] text-xs"></div>

                <!-- Room Selection -->
                <div>
                    <label asp-for="RoomId" class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-zinc-700 mb-1.5">
                        Pilih Ruangan <span class="text-rose-500">*</span>
                    </label>
                    <select asp-for="RoomId" id="selectRoom" x-model="selectedRoom" x-on:change="fetchAvailability()"
                            class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-zinc-900 text-xs focus:bg-white focus:border-zinc-900 focus:outline-none transition-all font-sans" 
                            asp-items="ViewBag.Rooms" required>
                        <option value="">— Silakan Pilih Ruangan —</option>
                    </select>
                    <span asp-validation-for="RoomId" class="text-rose-500 text-[10px]"></span>
                </div>

                <!-- Borrower Info Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="BorrowerName" class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-zinc-700 mb-1.5">
                            Nama Pemohon <span class="text-rose-500">*</span>
                        </label>
                        <input asp-for="BorrowerName" 
                               value="@(string.IsNullOrEmpty(Model.BorrowerName) && User.Identity?.IsAuthenticated == true ? User.Identity.Name : Model.BorrowerName)"
                               class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-zinc-900 text-xs focus:bg-white focus:border-zinc-900 focus:outline-none transition-all"
                               placeholder="Nama Pemohon / Organisasi" required />
                        <span asp-validation-for="BorrowerName" class="text-rose-500 text-[10px]"></span>
                    </div>

                    <div>
                        <label asp-for="BorrowerEmail" class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-zinc-700 mb-1.5">
                            Email Kontak <span class="text-rose-500">*</span>
                        </label>
                        <input asp-for="BorrowerEmail" type="email"
                               value="@(string.IsNullOrEmpty(Model.BorrowerEmail) && User.Identity?.IsAuthenticated == true ? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value : Model.BorrowerEmail)"
                               class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-zinc-900 text-xs font-mono focus:bg-white focus:border-zinc-900 focus:outline-none transition-all"
                               placeholder="nama@kampus.ac.id" required />
                        <span asp-validation-for="BorrowerEmail" class="text-rose-500 text-[10px]"></span>
                    </div>
                </div>

                <!-- Purpose -->
                <div>
                    <label asp-for="Purpose" class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-zinc-700 mb-1.5">
                        Agenda / Keperluan Peminjaman <span class="text-rose-500">*</span>
                    </label>
                    <textarea asp-for="Purpose" rows="3" 
                              class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-zinc-900 text-xs focus:bg-white focus:border-zinc-900 focus:outline-none transition-all"
                              placeholder="Contoh: Sidang Terbuka Tugas Akhir / Workshop Praktikum Jaringan Komputer" required></textarea>
                    <span asp-validation-for="Purpose" class="text-rose-500 text-[10px]"></span>
                </div>

                <!-- Timeslots -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="StartTime" class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-zinc-700 mb-1.5">
                            Waktu Mulai <span class="text-rose-500">*</span>
                        </label>
                        <input asp-for="StartTime" id="inputStartTime" x-model="startTime" x-on:change="fetchAvailability()" type="datetime-local" 
                               class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-zinc-900 text-xs font-mono focus:bg-white focus:border-zinc-900 focus:outline-none transition-all"
                               value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")" required />
                        <span asp-validation-for="StartTime" class="text-rose-500 text-[10px]"></span>
                    </div>

                    <div>
                        <label asp-for="EndTime" class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-zinc-700 mb-1.5">
                            Waktu Selesai <span class="text-rose-500">*</span>
                        </label>
                        <input asp-for="EndTime" id="inputEndTime" type="datetime-local"
                               class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-zinc-900 text-xs font-mono focus:bg-white focus:border-zinc-900 focus:outline-none transition-all"
                               value="@Model.EndTime.ToString("yyyy-MM-ddTHH:mm")" required />
                        <span asp-validation-for="EndTime" class="text-rose-500 text-[10px]"></span>
                    </div>
                </div>

                <!-- Submit Button Bar -->
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-zinc-100">
                    <a asp-action="Index" class="px-4 py-2.5 rounded-xl border border-zinc-200 text-xs font-medium text-zinc-700 hover:bg-zinc-50 transition-colors">
                        Batal
                    </a>
                    <button type="submit" 
                            class="px-5 py-2.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-medium shadow-xs transition-all active:scale-[0.98] flex items-center gap-1.5">
                        <i data-lucide="send" class="w-3.5 h-3.5"></i>
                        <span>Kirim Pengajuan</span>
                    </button>
                </div>
            </form>
        </div>

        <!-- Right Column: Live Availability & Conflict Inspector (5 cols) -->
        <div class="lg:col-span-5 space-y-4">
            
            <!-- Real-Time Slot Inspector Card -->
            <div class="bg-white rounded-2xl border border-zinc-200/80 p-6 shadow-xs">
                <div class="flex items-center justify-between pb-3 border-b border-zinc-100 mb-3">
                    <div class="flex items-center gap-2">
                        <i data-lucide="activity" class="w-4 h-4 text-zinc-700"></i>
                        <span class="text-xs font-bold text-zinc-900 tracking-tight">Status Ketersediaan Slot</span>
                    </div>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-100 border border-zinc-200 text-zinc-600 font-semibold" 
                          x-text="dateLabel || 'Pilih Tanggal'"></span>
                </div>

                <!-- If room or date not yet selected -->
                <div x-show="!selectedRoom" class="py-8 text-center text-zinc-400 text-xs font-mono">
                    <i data-lucide="door-open" class="w-8 h-8 mx-auto mb-2 opacity-30"></i>
                    <span>Pilih ruangan pada form untuk melihat ketersediaan slot jam.</span>
                </div>

                <!-- Loading State -->
                <div x-show="selectedRoom && isLoading" x-cloak class="py-8 text-center text-zinc-500 text-xs font-mono flex items-center justify-center gap-2">
                    <i data-lucide="loader-2" class="w-4 h-4 animate-spin text-zinc-700"></i>
                    <span>Memverifikasi slot ketersediaan...</span>
                </div>

                <!-- Loaded Slot List -->
                <div x-show="selectedRoom && !isLoading" x-cloak class="space-y-3">
                    <template x-if="slots.length > 0">
                        <div>
                            <div class="text-[11px] font-mono text-zinc-500 mb-2 font-medium">Slot terisi pada tanggal ini:</div>
                            <div class="space-y-2">
                                <template x-for="slot in slots" :key="slot.bookingReference">
                                    <div class="p-2.5 rounded-xl border text-xs flex items-center justify-between"
                                         :class="slot.status === 'Approved' ? 'bg-[#EDF3EC] border-[#BBF7D0] text-[#166534]' : 'bg-[#FEF9C3] border-[#FEF08A] text-[#854D0E]'">
                                        <div class="flex items-center gap-2">
                                            <span class="w-1.5 h-1.5 rounded-full" :class="slot.status === 'Approved' ? 'bg-[#166534]' : 'bg-[#854D0E]'"></span>
                                            <span class="font-mono font-bold" x-text="formatTime(slot.startTime) + ' — ' + formatTime(slot.endTime)"></span>
                                            <span class="text-[11px] opacity-80 truncate max-w-[120px]" x-text="'(' + slot.borrowerName + ')'"></span>
                                        </div>
                                        <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold" x-text="slot.status"></span>
                                    </div>
                                </template>
                            </div>
                        </div>
                    </template>

                    <template x-if="slots.length === 0">
                        <div class="p-4 rounded-xl bg-[#EDF3EC] border border-[#BBF7D0] text-[#166534] text-xs flex items-start gap-2.5">
                            <i data-lucide="check-circle" class="w-4 h-4 text-[#166534] flex-shrink-0 mt-0.5"></i>
                            <div>
                                <div class="font-bold">Seluruh Slot Tersedia!</div>
                                <div class="text-[11px] text-[#166534]/90 mt-0.5">Tidak ada jadwal booking lain pada tanggal ini. Anda bebas memilih jam.</div>
                            </div>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Business Rule Specifications -->
            <div class="bg-white rounded-2xl border border-zinc-200/80 p-5 shadow-xs space-y-3 text-xs text-zinc-600">
                <div class="text-[11px] font-mono uppercase tracking-wider text-zinc-400 font-semibold flex items-center gap-1.5">
                    <i data-lucide="shield-alert" class="w-3.5 h-3.5 text-zinc-600"></i>
                    <span>Ketentuan Validasi Backend</span>
                </div>
                <ul class="space-y-2 text-[11px] leading-relaxed">
                    <li class="flex items-start gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-zinc-900 mt-1.5 flex-shrink-0"></span>
                        <span><strong>Rentang Durasi:</strong> Minimal 30 menit dan maksimal 8 jam dalam satu pengajuan.</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-zinc-900 mt-1.5 flex-shrink-0"></span>
                        <span><strong>Anti Tumpang Tindih:</strong> Sistem otomatis menolak jadwal jika beririsan menit dengan booking berstatus <code>Approved</code> atau <code>Pending</code>.</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-zinc-900 mt-1.5 flex-shrink-0"></span>
                        <span><strong>Persetujuan:</strong> Pengajuan akan masuk ke antrean administrator untuk diverifikasi.</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function bookingApp() {
            return {
                selectedRoom: '@Model.RoomId' || '',
                startTime: '@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")',
                isLoading: false,
                dateLabel: '',
                slots: [],
                init() {
                    if (this.selectedRoom && this.startTime) {
                        this.fetchAvailability();
                    }
                },
                async fetchAvailability() {
                    if (!this.selectedRoom || !this.startTime) {
                        this.slots = [];
                        return;
                    }
                    const dateStr = this.startTime.split('T')[0];
                    this.dateLabel = dateStr;
                    this.isLoading = true;

                    try {
                        const res = await fetch(`/api/rooms/${this.selectedRoom}/availability?date=${dateStr}`);
                        if (res.ok) {
                            const data = await res.json();
                            this.slots = data.bookedSlots || [];
                        }
                    } catch (e) {
                        console.error('Error fetching availability:', e);
                    } finally {
                        this.isLoading = false;
                        this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
                    }
                },
                formatTime(isoString) {
                    const d = new Date(isoString);
                    return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                }
            }
        }
    </script>
}