@model IEnumerable<SmartRoom.Models.Booking>
@{
    ViewData["Title"] = "Panel Approval Administrator";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge-pill-soft badge-role-admin font-mono" style="font-size: 0.7rem;">
                <i class="bi bi-shield-check"></i> HAK AKSES KHUSUS ADMINISTRATOR
            </span>
            <span class="text-muted small">&bull;</span>
            <span class="text-muted small font-mono">@Model.Count(b => b.Status == SmartRoom.Models.Enums.BookingStatus.Pending) MENUNGGU</span>
        </div>
        <h2 class="fw-bold text-dark mb-0 tracking-tight" style="font-size: 1.65rem;">
            Persetujuan &amp; Verifikasi Peminjaman
        </h2>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-minimal-secondary d-inline-flex align-items-center gap-1.5">
            <i class="bi bi-list-ul"></i>
            <span>Semua Jadwal</span>
        </a>
    </div>
</div>

<!-- Filter Box -->
<div class="card-minimal p-3 bg-white mb-4">
    <form method="get" asp-action="Manage" class="row g-2 align-items-end">
        <div class="col-12 col-md-5">
            <label class="form-label font-mono text-muted small mb-1" style="font-size: 0.72rem;">FILTER RUANGAN</label>
            <select name="roomId" class="form-select form-select-sm" asp-items="ViewBag.Rooms">
                <option value="">— Semua Ruangan —</option>
            </select>
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label font-mono text-muted small mb-1" style="font-size: 0.72rem;">FILTER STATUS</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">— Semua Status —</option>
                <option value="0" selected="@(ViewBag.CurrentStatus?.ToString() == "Pending")">Menunggu Persetujuan (Pending)</option>
                <option value="1" selected="@(ViewBag.CurrentStatus?.ToString() == "Approved")">Disetujui (Approved)</option>
                <option value="2" selected="@(ViewBag.CurrentStatus?.ToString() == "Rejected")">Ditolak (Rejected)</option>
            </select>
        </div>
        <div class="col-12 col-md-3 d-flex gap-1.5">
            <button type="submit" class="btn btn-sm btn-minimal-primary w-100 py-1.5">
                <i class="bi bi-funnel me-1"></i> Terapkan
            </button>
            <a asp-action="Manage" class="btn btn-sm btn-minimal-secondary py-1.5 px-2.5" title="Reset">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Approval Table -->
<div class="card-minimal bg-white overflow-hidden">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table-minimal">
                <thead>
                    <tr>
                        <th>No. Referensi</th>
                        <th>Ruangan &amp; Lokasi</th>
                        <th>Pemohon</th>
                        <th>Agenda &amp; Jadwal Waktu</th>
                        <th>Status</th>
                        <th class="text-end">Tindakan Admin</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr class="@(b.Status == SmartRoom.Models.Enums.BookingStatus.Pending ? "bg-amber-50-subtle" : "")">
                            <td>
                                <span class="font-mono fw-semibold text-dark">@b.BookingReference</span>
                                <div class="text-muted font-mono" style="font-size: 0.7rem;">@b.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td>
                                <div class="fw-medium text-dark">@(b.Room?.Name ?? $"Ruangan #{b.RoomId}")</div>
                                <div class="text-muted font-mono" style="font-size: 0.72rem;">@(b.Room?.RoomCode ?? "-") &bull; @(b.Room?.Building ?? "-")</div>
                            </td>
                            <td>
                                <div class="fw-medium text-dark">@b.BorrowerName</div>
                                <div class="text-muted small" style="font-size: 0.75rem;">@b.BorrowerEmail</div>
                            </td>
                            <td>
                                <div class="fw-medium text-dark mb-1">@b.Purpose</div>
                                <div class="font-mono text-muted" style="font-size: 0.75rem;">
                                    <i class="bi bi-calendar-event me-1"></i>@b.StartTime.ToString("dd MMM yyyy")
                                    &bull;
                                    <i class="bi bi-clock me-1"></i>@b.StartTime.ToString("HH:mm") — @b.EndTime.ToString("HH:mm")
                                </div>
                                @if (!string.IsNullOrWhiteSpace(b.AdminNotes))
                                {
                                    <div class="mt-1 p-1 px-2 rounded bg-light border small text-muted font-mono" style="font-size: 0.72rem;">
                                        Catatan: @b.AdminNotes
                                    </div>
                                }
                            </td>
                            <td>
                                @switch (b.Status)
                                {
                                    case SmartRoom.Models.Enums.BookingStatus.Pending:
                                        <span class="badge-pill-soft badge-soft-pending">
                                            <i class="bi bi-hourglass-split"></i> Pending
                                        </span>
                                        break;
                                    case SmartRoom.Models.Enums.BookingStatus.Approved:
                                        <span class="badge-pill-soft badge-soft-approved">
                                            <i class="bi bi-check2"></i> Approved
                                        </span>
                                        break;
                                    case SmartRoom.Models.Enums.BookingStatus.Rejected:
                                        <span class="badge-pill-soft badge-soft-rejected">
                                            <i class="bi bi-x"></i> Rejected
                                        </span>
                                        break;
                                    case SmartRoom.Models.Enums.BookingStatus.Cancelled:
                                        <span class="badge-pill-soft badge-soft-cancelled">
                                            Cancelled
                                        </span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <!-- Approve Action -->
                                    @if (b.Status != SmartRoom.Models.Enums.BookingStatus.Approved)
                                    {
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@b.Id" />
                                            <input type="hidden" name="status" value="@((int)SmartRoom.Models.Enums.BookingStatus.Approved)" />
                                            <input type="hidden" name="adminNotes" value="Disetujui oleh Administrator Sarana & Prasarana." />
                                            <button type="submit" class="btn btn-sm btn-minimal-primary py-1 px-2.5" style="font-size: 0.78rem;"
                                                    onclick="return confirm('Setujui pengajuan peminjaman @b.BookingReference?');">
                                                <i class="bi bi-check-lg me-1"></i> Setujui
                                            </button>
                                        </form>
                                    }

                                    <!-- Reject Action Modal Trigger -->
                                    @if (b.Status != SmartRoom.Models.Enums.BookingStatus.Rejected)
                                    {
                                        <button type="button" class="btn btn-sm btn-minimal-secondary py-1 px-2.5 text-danger" style="font-size: 0.78rem;"
                                                data-bs-toggle="modal" data-bs-target="#rejectModal-@b.Id">
                                            <i class="bi bi-x-lg me-1"></i> Tolak
                                        </button>
                                    }
                                </div>

                                <!-- Reject Modal -->
                                <div class="modal fade text-start" id="rejectModal-@b.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content card-minimal p-2 border-0 shadow">
                                            <form asp-action="UpdateStatus" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@b.Id" />
                                                <input type="hidden" name="status" value="@((int)SmartRoom.Models.Enums.BookingStatus.Rejected)" />

                                                <div class="modal-header border-bottom pb-2">
                                                    <h6 class="modal-title fw-bold text-dark font-mono text-uppercase" style="font-size: 0.85rem;">
                                                        Konfirmasi Penolakan Pengajuan
                                                    </h6>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body py-3">
                                                    <div class="small text-muted mb-2">
                                                        Pengajuan <strong>@b.BookingReference</strong> oleh <strong>@b.BorrowerName</strong>.
                                                    </div>
                                                    <div>
                                                        <label class="form-label small fw-semibold text-secondary">Alasan Penolakan <span class="text-danger">*</span></label>
                                                        <textarea name="adminNotes" rows="3" class="form-control" placeholder="Contoh: Ruangan dialokasikan untuk pemeliharaan teknis darurat." required></textarea>
                                                    </div>
                                                </div>

                                                <div class="modal-footer border-top pt-2">
                                                    <button type="button" class="btn btn-minimal-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                                                    <button type="submit" class="btn btn-sm btn-danger px-3 py-1.5" style="border-radius: 0.5rem; font-size: 0.82rem;">
                                                        Tolak Pengajuan
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="py-5 text-center text-muted">
            <i class="bi bi-shield-check display-6 text-muted mb-2 d-block opacity-25"></i>
            <h6 class="fw-bold text-dark">Antrean Bersih</h6>
            <p class="text-muted small mb-0">Tidak ada pengajuan yang membutuhkan verifikasi admin saat ini.</p>
        </div>
    }
</div>
