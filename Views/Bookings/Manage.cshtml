@model IEnumerable<SmartRoom.Models.Booking>
@{
    ViewData["Title"] = "Panel Approval Administrator";
    var pendingCount = Model.Count(b => b.Status == SmartRoom.Models.Enums.BookingStatus.Pending);
}

<div class="space-y-6" x-data="{ rejectModalOpen: false, rejectBookingId: 0, rejectBookingRef: '', rejectBorrower: '' }">
    
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-zinc-200/80">
        <div>
            <div class="flex items-center gap-2 mb-1.5">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium bg-rose-50 text-rose-700 border border-rose-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-600"></span>
                    ROLE ADMINISTRATOR
                </span>
                <span class="text-zinc-300">&bull;</span>
                <span class="text-xs font-mono text-zinc-500">@pendingCount Menunggu Verifikasi</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-950">
                Panel Persetujuan Peminjaman
            </h1>
            <p class="text-xs sm:text-sm text-zinc-500 mt-1 max-w-xl">
                Tinjau pengajuan jadwal ruangan, verifikasi keperluan civitas, dan tentukan status persetujuan atau penolakan disertai catatan.
            </p>
        </div>

        <a asp-action="Index" 
           class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-zinc-200 bg-white hover:bg-zinc-50 text-xs font-medium text-zinc-700 shadow-xs transition-colors flex-shrink-0">
            <i data-lucide="calendar" class="w-4 h-4 text-zinc-500"></i>
            <span>Semua Jadwal</span>
        </a>
    </div>

    <!-- Filter Card -->
    <div class="bg-white border border-zinc-200/80 rounded-2xl p-5 shadow-xs">
        <form method="get" asp-action="Manage" class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 items-end">
            <div>
                <label class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-zinc-600 mb-1.5">Filter Ruangan</label>
                <select name="roomId" class="w-full px-3 py-2 rounded-xl bg-zinc-50 border border-zinc-200 text-xs text-zinc-800 focus:bg-white focus:border-zinc-900 focus:outline-none transition-all" asp-items="ViewBag.Rooms">
                    <option value="">— Semua Ruangan —</option>
                </select>
            </div>
            <div>
                <label class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-zinc-600 mb-1.5">Status Peminjaman</label>
                <select name="status" class="w-full px-3 py-2 rounded-xl bg-zinc-50 border border-zinc-200 text-xs text-zinc-800 focus:bg-white focus:border-zinc-900 focus:outline-none transition-all">
                    <option value="">— Semua Status —</option>
                    <option value="0" selected="@(ViewBag.CurrentStatus?.ToString() == "Pending")">Menunggu Persetujuan (Pending)</option>
                    <option value="1" selected="@(ViewBag.CurrentStatus?.ToString() == "Approved")">Disetujui (Approved)</option>
                    <option value="2" selected="@(ViewBag.CurrentStatus?.ToString() == "Rejected")">Ditolak (Rejected)</option>
                </select>
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" 
                        class="flex-1 py-2 px-3 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-medium transition-all active:scale-[0.98] flex items-center justify-center gap-1.5">
                    <i data-lucide="filter" class="w-3.5 h-3.5"></i>
                    <span>Terapkan Filter</span>
                </button>
                <a asp-action="Manage" class="p-2 rounded-xl border border-zinc-200 hover:bg-zinc-50 text-zinc-600 transition-colors" title="Reset Filter">
                    <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Review Queue Table -->
    <div class="bg-white border border-zinc-200/80 rounded-2xl overflow-hidden shadow-xs">
        @if (Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-zinc-50/75 border-b border-zinc-200/80 text-[11px] font-mono uppercase tracking-wider text-zinc-500">
                            <th class="py-3 px-5">Referensi</th>
                            <th class="py-3 px-5">Ruangan</th>
                            <th class="py-3 px-5">Pemohon</th>
                            <th class="py-3 px-5">Agenda &amp; Jadwal</th>
                            <th class="py-3 px-5">Status</th>
                            <th class="py-3 px-5 text-right">Tindakan Admin</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-100 text-xs text-zinc-700">
                        @foreach (var b in Model)
                        {
                            var isPending = b.Status == SmartRoom.Models.Enums.BookingStatus.Pending;
                            <tr class="hover:bg-zinc-50/70 transition-colors @(isPending ? "bg-amber-50/20" : "")">
                                <!-- Reference -->
                                <td class="py-3.5 px-5 font-mono">
                                    <div class="flex items-center gap-1.5">
                                        <span class="font-bold text-zinc-900">@b.BookingReference</span>
                                        <button type="button" onclick="navigator.clipboard.writeText('@b.BookingReference')" 
                                                class="text-zinc-400 hover:text-zinc-900 p-0.5 rounded transition-colors" title="Salin ID Referensi">
                                            <i data-lucide="copy" class="w-3 h-3"></i>
                                        </button>
                                    </div>
                                    <div class="text-[10px] text-zinc-400 font-mono">@b.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>

                                <!-- Room -->
                                <td class="py-3.5 px-5">
                                    <div class="font-semibold text-zinc-900">@(b.Room?.Name ?? $"Ruangan #{b.RoomId}")</div>
                                    <div class="text-[11px] font-mono text-zinc-400">@(b.Room?.RoomCode ?? "-") &bull; @(b.Room?.Building ?? "-")</div>
                                </td>

                                <!-- Borrower -->
                                <td class="py-3.5 px-5">
                                    <div class="font-medium text-zinc-900">@b.BorrowerName</div>
                                    <div class="text-[11px] text-zinc-400 font-mono">@b.BorrowerEmail</div>
                                </td>

                                <!-- Purpose & Timeslot -->
                                <td class="py-3.5 px-5">
                                    <div class="font-medium text-zinc-900 max-w-xs truncate" title="@b.Purpose">@b.Purpose</div>
                                    <div class="font-mono text-zinc-500 text-[11px] mt-0.5 flex items-center gap-1">
                                        <i data-lucide="clock" class="w-3 h-3 text-zinc-400"></i>
                                        <span>@b.StartTime.ToString("dd MMM yyyy HH:mm") — @b.EndTime.ToString("HH:mm")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(b.AdminNotes))
                                    {
                                        <div class="mt-1 p-1 px-2 rounded bg-zinc-100 text-zinc-600 text-[10px] font-mono border border-zinc-200/80">
                                            Catatan: @b.AdminNotes
                                        </div>
                                    }
                                </td>

                                <!-- Status Badge -->
                                <td class="py-3.5 px-5">
                                    @switch (b.Status)
                                    {
                                        case SmartRoom.Models.Enums.BookingStatus.Approved:
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium bg-[#EDF3EC] text-[#166534] border border-[#BBF7D0]">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#166534]"></span> Approved
                                            </span>
                                            break;
                                        case SmartRoom.Models.Enums.BookingStatus.Pending:
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium bg-[#FEF9C3] text-[#854D0E] border border-[#FEF08A]">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#854D0E]"></span> Pending
                                            </span>
                                            break;
                                        case SmartRoom.Models.Enums.BookingStatus.Rejected:
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium bg-[#FEE2E2] text-[#991B1B] border border-[#FECACA]">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#991B1B]"></span> Rejected
                                            </span>
                                            break;
                                        default:
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium bg-zinc-100 text-zinc-600 border border-zinc-200">
                                                Cancelled
                                            </span>
                                            break;
                                    }
                                </td>

                                <!-- Admin Action Buttons -->
                                <td class="py-3.5 px-5 text-right font-mono">
                                    <div class="flex items-center justify-end gap-1.5">
                                        @if (b.Status != SmartRoom.Models.Enums.BookingStatus.Approved)
                                        {
                                            <form asp-action="UpdateStatus" method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@b.Id" />
                                                <input type="hidden" name="status" value="@((int)SmartRoom.Models.Enums.BookingStatus.Approved)" />
                                                <button type="submit" 
                                                        class="px-2.5 py-1.5 rounded-lg bg-[#EDF3EC] hover:bg-[#DCFCE7] text-[#166534] border border-[#BBF7D0] text-[11px] font-semibold transition-colors flex items-center gap-1 shadow-xs">
                                                    <i data-lucide="check" class="w-3.5 h-3.5"></i>
                                                    <span>Setujui</span>
                                                </button>
                                            </form>
                                        }

                                        @if (b.Status != SmartRoom.Models.Enums.BookingStatus.Rejected)
                                        {
                                            <button type="button" 
                                                    x-on:click="rejectModalOpen = true; rejectBookingId = @b.Id; rejectBookingRef = '@b.BookingReference'; rejectBorrower = '@b.BorrowerName';"
                                                    class="px-2.5 py-1.5 rounded-lg bg-[#FEE2E2] hover:bg-[#FECACA] text-[#991B1B] border border-[#FECACA] text-[11px] font-semibold transition-colors flex items-center gap-1 shadow-xs">
                                                <i data-lucide="x" class="w-3.5 h-3.5"></i>
                                                <span>Tolak</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="py-16 text-center text-zinc-400">
                <i data-lucide="shield-check" class="w-10 h-10 mx-auto mb-2 text-[#166534] opacity-50"></i>
                <div class="text-xs font-semibold text-zinc-700">Semua Permohonan Selesai Diproses</div>
                <div class="text-[11px] text-zinc-400 mt-0.5">Tidak ada antrean yang membutuhkan persetujuan saat ini.</div>
            </div>
        }
    </div>

    <!-- Reject Modal Sheet -->
    <div x-show="rejectModalOpen" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-950/50 backdrop-blur-sm">
        <div x-on:click.outside="rejectModalOpen = false" class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-zinc-200">
            <form asp-action="UpdateStatus" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" :value="rejectBookingId" />
                <input type="hidden" name="status" value="@((int)SmartRoom.Models.Enums.BookingStatus.Rejected)" />

                <div class="flex items-center justify-between pb-3 border-b border-zinc-100">
                    <div class="flex items-center gap-2">
                        <div class="w-7 h-7 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center">
                            <i data-lucide="x-circle" class="w-4 h-4"></i>
                        </div>
                        <h3 class="text-sm font-bold text-zinc-950">Tolak Pengajuan Peminjaman</h3>
                    </div>
                    <button type="button" x-on:click="rejectModalOpen = false" class="p-1 rounded text-zinc-400 hover:text-zinc-600">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>

                <div class="text-xs text-zinc-600">
                    Menolak peminjaman referensi <strong class="text-zinc-900 font-mono" x-text="rejectBookingRef"></strong> oleh <strong class="text-zinc-900" x-text="rejectBorrower"></strong>.
                </div>

                <div>
                    <label class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-zinc-700 mb-1.5">
                        Alasan Penolakan <span class="text-rose-500">*</span>
                    </label>
                    <textarea name="adminNotes" rows="3" 
                              class="w-full px-3 py-2 rounded-xl bg-zinc-50 border border-zinc-200 text-xs text-zinc-800 focus:bg-white focus:border-zinc-900 focus:outline-none transition-all"
                              placeholder="Contoh: Ruangan dialokasikan untuk evaluasi mendesak rektorat." required></textarea>
                </div>

                <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-zinc-100">
                    <button type="button" x-on:click="rejectModalOpen = false" 
                            class="px-3.5 py-2 rounded-xl border border-zinc-200 text-xs font-medium text-zinc-600 hover:bg-zinc-50 transition-colors">
                        Batal
                    </button>
                    <button type="submit" 
                            class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-500 text-white text-xs font-medium shadow-xs transition-colors">
                        Konfirmasi Penolakan
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.lucide) {
                window.lucide.createIcons();
            }
        });
    </script>
}