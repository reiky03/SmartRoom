@model IEnumerable<SmartRoom.Models.Booking>
@{
    ViewData["Title"] = "Panel Approval Admin";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-shield-check text-primary me-2"></i>Panel Approval Peminjaman Ruangan
        </h2>
        <p class="text-muted mb-0">Verifikasi, setujui, atau tolak permohonan peminjaman ruangan dari pemohon.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-list-ul me-1"></i> Semua Peminjaman
        </a>
    </div>
</div>

<!-- Filter Tabs -->
<div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="Manage" class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
                <label class="form-label small text-muted mb-1">Filter Ruangan</label>
                <select name="roomId" class="form-select form-select-sm" asp-items="ViewBag.Rooms">
                    <option value="">-- Semua Ruangan --</option>
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Filter Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">-- Semua Status --</option>
                    <option value="0" selected="@(ViewBag.CurrentStatus?.ToString() == "Pending")">Menunggu Persetujuan (Pending)</option>
                    <option value="1" selected="@(ViewBag.CurrentStatus?.ToString() == "Approved")">Disetujui (Approved)</option>
                    <option value="2" selected="@(ViewBag.CurrentStatus?.ToString() == "Rejected")">Ditolak (Rejected)</option>
                </select>
            </div>
            <div class="col-12 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary rounded-pill w-100">
                    <i class="bi bi-funnel me-1"></i> Terapkan
                </button>
                <a asp-action="Manage" class="btn btn-sm btn-outline-secondary rounded-pill" title="Reset">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Approval Table -->
<div class="card shadow-sm border-0 bg-white">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-custom">
                        <tr>
                            <th class="ps-4">No. Ref & Tanggal</th>
                            <th>Ruangan</th>
                            <th>Peminjam</th>
                            <th>Tujuan & Jadwal</th>
                            <th>Status Saat Ini</th>
                            <th class="text-end pe-4">Aksi Approval</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-semibold text-dark font-monospace">@b.BookingReference</span>
                                    <div class="text-muted small">Diajukan: @b.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@(b.Room?.Name ?? "Ruangan #"+b.RoomId)</div>
                                    <small class="text-muted">@(b.Room?.Building ?? "-") (@(b.Room?.RoomCode ?? "-"))</small>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">@b.BorrowerName</div>
                                    <small class="text-muted">@b.BorrowerEmail</small>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">@b.Purpose</div>
                                    <div class="small text-muted mt-1">
                                        <i class="bi bi-calendar-event text-primary me-1"></i>@b.StartTime.ToString("dd MMM yyyy")
                                        <i class="bi bi-clock text-primary ms-2 me-1"></i>@b.StartTime.ToString("HH:mm") - @b.EndTime.ToString("HH:mm")
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(b.AdminNotes))
                                    {
                                        <div class="mt-1 small text-info-emphasis bg-light p-1 rounded border">
                                            <strong>Catatan:</strong> @b.AdminNotes
                                        </div>
                                    }
                                </td>
                                <td>
                                    @switch (b.Status)
                                    {
                                        case BookingStatus.Pending:
                                            <span class="badge badge-status-pending px-3 py-2 rounded-pill">
                                                <i class="bi bi-hourglass-split me-1"></i> Pending
                                            </span>
                                            break;
                                        case BookingStatus.Approved:
                                            <span class="badge badge-status-approved px-3 py-2 rounded-pill">
                                                <i class="bi bi-check-circle-fill me-1"></i> Approved
                                            </span>
                                            break;
                                        case BookingStatus.Rejected:
                                            <span class="badge badge-status-rejected px-3 py-2 rounded-pill">
                                                <i class="bi bi-x-circle-fill me-1"></i> Rejected
                                            </span>
                                            break;
                                        case BookingStatus.Cancelled:
                                            <span class="badge badge-status-cancelled px-3 py-2 rounded-pill">
                                                <i class="bi bi-slash-circle me-1"></i> Cancelled
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        <!-- Quick Approve Button -->
                                        @if (b.Status != BookingStatus.Approved)
                                        {
                                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@b.Id" />
                                                <input type="hidden" name="status" value="@((int)BookingStatus.Approved)" />
                                                <input type="hidden" name="adminNotes" value="Disetujui oleh Administrator." />
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 shadow-xs"
                                                        onclick="return confirm('Apakah Anda yakin ingin menyetujui peminjaman ini?');">
                                                    <i class="bi bi-check-lg me-1"></i> Setujui
                                                </button>
                                            </form>
                                        }

                                        <!-- Reject with Modal Button -->
                                        @if (b.Status != BookingStatus.Rejected)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                    data-bs-toggle="modal" data-bs-target="#rejectModal-@b.Id">
                                                <i class="bi bi-x-lg me-1"></i> Tolak
                                            </button>
                                        }
                                    </div>

                                    <!-- Reject Modal -->
                                    <div class="modal fade text-start" id="rejectModal-@b.Id" tabindex="-1" aria-labelledby="modalLabel-@b.Id" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content rounded-4 border-0 shadow">
                                                <form asp-action="UpdateStatus" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@b.Id" />
                                                    <input type="hidden" name="status" value="@((int)BookingStatus.Rejected)" />
                                                    
                                                    <div class="modal-header border-0 pb-0">
                                                        <h5 class="modal-title fw-bold text-dark" id="modalLabel-@b.Id">
                                                            <i class="bi bi-x-circle-fill text-danger me-2"></i>Tolak Peminjaman
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>

                                                    <div class="modal-body py-3">
                                                        <p class="text-muted small mb-3">
                                                            Anda akan menolak pengajuan <strong>@b.BookingReference</strong> oleh <strong>@b.BorrowerName</strong>.
                                                        </p>
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-semibold">Alasan Penolakan / Catatan Admin <span class="text-danger">*</span></label>
                                                            <textarea name="adminNotes" rows="3" class="form-control" placeholder="Contoh: Ruangan dialokasikan untuk kegiatan universitas yang mendesak." required></textarea>
                                                        </div>
                                                    </div>

                                                    <div class="modal-footer border-0 pt-0">
                                                        <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Batal</button>
                                                        <button type="submit" class="btn btn-danger rounded-pill px-4">
                                                            Konfirmasi Tolak
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-shield-check text-muted display-4 mb-3 d-block"></i>
                <h6 class="text-dark fw-bold">Semua Bersih! Tidak Ada Peminjaman Tertunda</h6>
                <p class="text-muted small">Semua pengajuan peminjaman telah diproses.</p>
            </div>
        }
    </div>
</div>
