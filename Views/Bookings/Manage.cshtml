@model IEnumerable<SmartRoom.Models.Booking>
@{
    ViewData["Title"] = "Panel Approval Administrator";
}

<div x-data="{ rejectModalOpen: false, rejectBookingId: 0, rejectBookingRef: '', rejectBorrower: '' }">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-6 border-b border-slate-200">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-rose-50 text-rose-700 border border-rose-200">
                    <i data-lucide="shield" class="w-3 h-3 inline mr-1"></i> KHUSUS ADMINISTRATOR
                </span>
                <span class="text-xs text-slate-400 font-mono">&bull;</span>
                <span class="text-xs text-slate-500 font-mono">@Model.Count(b => b.Status == SmartRoom.Models.Enums.BookingStatus.Pending) MENUNGGU TINDAKAN</span>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Panel Persetujuan Peminjaman</h1>
            <p class="text-xs text-slate-500 mt-0.5">Verifikasi, terima atau tolak pengajuan peminjaman ruangan civitas kampus</p>
        </div>

        <a asp-action="Index" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-xs font-semibold text-slate-700 shadow-sm transition-colors">
            <i data-lucide="calendar" class="w-4 h-4"></i>
            <span>Semua Jadwal</span>
        </a>
    </div>

    <!-- Filter Card -->
    <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-sm mb-6">
        <form method="get" asp-action="Manage" class="grid grid-cols-1 sm:grid-cols-3 gap-3 items-end">
            <div>
                <label class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-slate-500 mb-1">Filter Ruangan</label>
                <select name="roomId" class="w-full px-3 py-2 rounded-lg border border-slate-200 bg-white text-xs text-slate-800 focus:ring-2 focus:ring-emerald-500 focus:outline-none" asp-items="ViewBag.Rooms">
                    <option value="">— Semua Ruangan —</option>
                </select>
            </div>
            <div>
                <label class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-slate-500 mb-1">Filter Status</label>
                <select name="status" class="w-full px-3 py-2 rounded-lg border border-slate-200 bg-white text-xs text-slate-800 focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                    <option value="">— Semua Status —</option>
                    <option value="0" selected="@(ViewBag.CurrentStatus?.ToString() == "Pending")">Menunggu Persetujuan (Pending)</option>
                    <option value="1" selected="@(ViewBag.CurrentStatus?.ToString() == "Approved")">Disetujui (Approved)</option>
                    <option value="2" selected="@(ViewBag.CurrentStatus?.ToString() == "Rejected")">Ditolak (Rejected)</option>
                </select>
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" class="flex-1 py-2 px-3 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold transition-colors flex items-center justify-center gap-1.5">
                    <i data-lucide="filter" class="w-3.5 h-3.5"></i>
                    <span>Terapkan</span>
                </button>
                <a asp-action="Manage" class="p-2 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-600 transition-colors" title="Reset Filter">
                    <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Review Queue Table -->
    <div class="rounded-2xl bg-white border border-slate-200/80 shadow-sm overflow-hidden">
        @if (Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50/80 border-b border-slate-200/80 text-[11px] font-mono uppercase tracking-wider text-slate-500">
                            <th class="py-3 px-5">Referensi</th>
                            <th class="py-3 px-5">Ruangan</th>
                            <th class="py-3 px-5">Pemohon</th>
                            <th class="py-3 px-5">Agenda &amp; Jadwal</th>
                            <th class="py-3 px-5">Status</th>
                            <th class="py-3 px-5 text-right">Tindakan Admin</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-xs text-slate-700">
                        @foreach (var b in Model)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors @(b.Status == SmartRoom.Models.Enums.BookingStatus.Pending ? "bg-amber-50/30" : "")">
                                <td class="py-3.5 px-5">
                                    <span class="font-mono font-semibold text-slate-900">@b.BookingReference</span>
                                    <div class="text-[10px] text-slate-400 font-mono">@b.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td class="py-3.5 px-5">
                                    <div class="font-semibold text-slate-900">@(b.Room?.Name ?? $"Ruangan #{b.RoomId}")</div>
                                    <div class="text-[11px] font-mono text-slate-400">@(b.Room?.RoomCode ?? "-") &bull; @(b.Room?.Building ?? "-")</div>
                                </td>
                                <td class="py-3.5 px-5">
                                    <div class="font-medium text-slate-900">@b.BorrowerName</div>
                                    <div class="text-[11px] text-slate-400">@b.BorrowerEmail</div>
                                </td>
                                <td class="py-3.5 px-5">
                                    <div class="font-medium text-slate-900 max-w-xs truncate" title="@b.Purpose">@b.Purpose</div>
                                    <div class="font-mono text-slate-500 text-[11px] mt-0.5">
                                        <i data-lucide="clock" class="w-3 h-3 inline mr-1 text-slate-400"></i>
                                        @b.StartTime.ToString("dd MMM yyyy HH:mm") — @b.EndTime.ToString("HH:mm")
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(b.AdminNotes))
                                    {
                                        <div class="mt-1 p-1 px-2 rounded bg-slate-100 border border-slate-200 text-[11px] text-slate-600 font-mono">
                                            Catatan: @b.AdminNotes
                                        </div>
                                    }
                                </td>
                                <td class="py-3.5 px-5">
                                    @switch (b.Status)
                                    {
                                        case SmartRoom.Models.Enums.BookingStatus.Pending:
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Pending
                                            </span>
                                            break;
                                        case SmartRoom.Models.Enums.BookingStatus.Approved:
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Approved
                                            </span>
                                            break;
                                        case SmartRoom.Models.Enums.BookingStatus.Rejected:
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Rejected
                                            </span>
                                            break;
                                        case SmartRoom.Models.Enums.BookingStatus.Cancelled:
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                                                Cancelled
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="py-3.5 px-5 text-right">
                                    <div class="inline-flex items-center gap-1.5">
                                        @if (b.Status != SmartRoom.Models.Enums.BookingStatus.Approved)
                                        {
                                            <form asp-action="UpdateStatus" method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@b.Id" />
                                                <input type="hidden" name="status" value="@((int)SmartRoom.Models.Enums.BookingStatus.Approved)" />
                                                <input type="hidden" name="adminNotes" value="Disetujui oleh Administrator Fasilitas Kampus." />
                                                <button type="submit" class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-[11px] font-semibold shadow-sm transition-all flex items-center gap-1"
                                                        onclick="return confirm('Setujui pengajuan @b.BookingReference?');">
                                                    <i data-lucide="check" class="w-3.5 h-3.5"></i>
                                                    <span>Setujui</span>
                                                </button>
                                            </form>
                                        }

                                        @if (b.Status != SmartRoom.Models.Enums.BookingStatus.Rejected)
                                        {
                                            <button type="button" x-on:click="rejectModalOpen = true; rejectBookingId = @b.Id; rejectBookingRef = '@b.BookingReference'; rejectBorrower = '@b.BorrowerName';"
                                                    class="px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 text-slate-700 text-[11px] font-semibold transition-colors flex items-center gap-1">
                                                <i data-lucide="x" class="w-3.5 h-3.5"></i>
                                                <span>Tolak</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="py-16 text-center text-slate-400">
                <i data-lucide="shield-check" class="w-10 h-10 mx-auto mb-2 text-emerald-500 opacity-60"></i>
                <div class="text-xs font-semibold text-slate-700">Semua Permohonan Selesai Diproses</div>
                <div class="text-[11px] text-slate-400 mt-0.5">Tidak ada antrean yang membutuhkan persetujuan saat ini.</div>
            </div>
        }
    </div>

    <!-- Reject Modal (Alpine.js Powered) -->
    <div x-show="rejectModalOpen" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm">
        <div x-on:click.outside="rejectModalOpen = false" class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200">
            <form asp-action="UpdateStatus" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" :value="rejectBookingId" />
                <input type="hidden" name="status" value="@((int)SmartRoom.Models.Enums.BookingStatus.Rejected)" />

                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center">
                            <i data-lucide="x-circle" class="w-4 h-4"></i>
                        </div>
                        <h3 class="text-sm font-bold text-slate-900">Tolak Pengajuan Peminjaman</h3>
                    </div>
                    <button type="button" x-on:click="rejectModalOpen = false" class="p-1 rounded text-slate-400 hover:text-slate-600">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>

                <div class="text-xs text-slate-600">
                    Menolak peminjaman <strong class="text-slate-900 font-mono" x-text="rejectBookingRef"></strong> atas nama <strong class="text-slate-900" x-text="rejectBorrower"></strong>.
                </div>

                <div>
                    <label class="block text-xs font-mono uppercase tracking-wider font-semibold text-slate-700 mb-1.5">
                        Alasan Penolakan <span class="text-rose-500">*</span>
                    </label>
                    <textarea name="adminNotes" rows="3" class="w-full px-3 py-2 rounded-lg border border-slate-200 text-xs text-slate-800 focus:ring-2 focus:ring-rose-500 focus:outline-none"
                              placeholder="Contoh: Ruangan dialokasikan untuk kegiatan evaluasi mendesak rektorat." required></textarea>
                </div>

                <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100">
                    <button type="button" x-on:click="rejectModalOpen = false" class="px-3.5 py-2 rounded-lg border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50">
                        Batal
                    </button>
                    <button type="submit" class="px-4 py-2 rounded-lg bg-rose-600 hover:bg-rose-500 text-white text-xs font-semibold shadow-sm transition-colors">
                        Konfirmasi Penolakan
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>lucide.createIcons();</script>
}
