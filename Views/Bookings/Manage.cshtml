@model IEnumerable<SmartRoom.Models.Booking>
@{
    ViewData["Title"] = "Antrean Persetujuan Fasilitas";
    var pendingCount = Model.Count(b => b.Status == SmartRoom.Models.Enums.BookingStatus.Pending);
}

<div class="space-y-7" x-data="{ rejectModalOpen: false, rejectBookingId: 0, rejectBookingRef: '', rejectBorrower: '' }">
    
    <!-- macOS 27 Hero Header -->
    <div class="liquid-glass-header p-6 sm:p-8 flex flex-col sm:flex-row sm:items-end justify-between gap-6">
        <div class="relative z-10">
            <div class="flex items-center gap-2 mb-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-semibold bg-[#FF3B30]/15 text-[#C91E14] border border-[#FF3B30]/30">
                    <span class="w-2 h-2 rounded-full bg-[#FF3B30] animate-pulse"></span>
                    ROLE ADMINISTRATOR
                </span>
                <span class="text-[#86868B]">&bull;</span>
                <span class="text-xs font-mono text-[#515154]">@pendingCount Menunggu Verifikasi</span>
            </div>
            <h1 class="text-3xl font-bold tracking-tight text-[#1D1D1F] sm:text-4xl">
                Antrean Persetujuan Fasilitas
            </h1>
            <p class="text-sm text-[#515154] mt-1.5 max-w-xl leading-relaxed">
                Tinjau pengajuan jadwal ruangan kampus, verifikasi keperluan civitas, dan tentukan status persetujuan atau penolakan dengan catatan resmi.
            </p>
        </div>

        <div class="relative z-10 flex-shrink-0">
            <a asp-action="Index" 
               class="liquid-btn-secondary flex items-center gap-2">
                <i data-lucide="calendar" class="w-4 h-4 text-[#515154]"></i>
                <span>Semua Jadwal</span>
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="liquid-glass-card p-5 sm:p-6">
        <form method="get" asp-action="Manage" class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-end">
            <div>
                <label class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-[#515154] mb-1.5">Filter Ruangan</label>
                <select name="roomId" class="liquid-glass-input w-full px-3.5 py-2 text-xs" asp-items="ViewBag.Rooms">
                    <option value="">— Semua Ruangan —</option>
                </select>
            </div>
            <div>
                <label class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-[#515154] mb-1.5">Status Peminjaman</label>
                <select name="status" class="liquid-glass-input w-full px-3.5 py-2 text-xs">
                    <option value="">— Semua Status —</option>
                    <option value="0" selected="@(ViewBag.CurrentStatus?.ToString() == "Pending")">Menunggu Persetujuan (Pending)</option>
                    <option value="1" selected="@(ViewBag.CurrentStatus?.ToString() == "Approved")">Disetujui (Approved)</option>
                    <option value="2" selected="@(ViewBag.CurrentStatus?.ToString() == "Rejected")">Ditolak (Rejected)</option>
                </select>
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" 
                        class="liquid-btn-primary flex-1 py-2 text-xs flex items-center justify-center gap-2">
                    <i data-lucide="filter" class="w-3.5 h-3.5 text-white"></i>
                    <span>Terapkan Filter</span>
                </button>
                <a asp-action="Manage" class="liquid-glass-pill p-2 hover:bg-white text-[#515154] transition-colors shadow-sm" title="Reset Filter">
                    <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Review Queue Table (macOS 27 Liquid Glass Container) -->
    <div class="liquid-glass-card overflow-hidden">
        @if (Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-white/40 border-b border-black/[0.06] text-[11px] font-mono uppercase tracking-wider text-[#86868B]">
                            <th class="py-3.5 px-6">Referensi</th>
                            <th class="py-3.5 px-6">Ruangan</th>
                            <th class="py-3.5 px-6">Pemohon</th>
                            <th class="py-3.5 px-6">Agenda &amp; Jadwal</th>
                            <th class="py-3.5 px-6">Status</th>
                            <th class="py-3.5 px-6 text-right">Tindakan Admin</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-black/[0.04] text-xs text-[#515154]">
                        @foreach (var b in Model)
                        {
                            var isPending = b.Status == SmartRoom.Models.Enums.BookingStatus.Pending;
                            <tr class="hover:bg-white/50 transition-colors @(isPending ? "bg-[#FF9500]/[0.03]" : "")">
                                <!-- Reference -->
                                <td class="py-4 px-6 font-mono">
                                    <div class="flex items-center gap-1.5">
                                        <span class="font-bold text-[#1D1D1F]">@b.BookingReference</span>
                                        <button type="button" onclick="navigator.clipboard.writeText('@b.BookingReference')" 
                                                class="text-[#86868B] hover:text-[#007AFF] p-0.5 rounded transition-colors" title="Salin ID Referensi">
                                            <i data-lucide="copy" class="w-3 h-3"></i>
                                        </button>
                                    </div>
                                    <div class="text-[10px] text-[#86868B] font-mono mt-0.5">@b.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>

                                <!-- Room -->
                                <td class="py-4 px-6">
                                    <div class="font-bold text-[#1D1D1F]">@(b.Room?.Name ?? $"Ruangan #{b.RoomId}")</div>
                                    <div class="text-[11px] font-mono text-[#86868B] flex items-center gap-1 mt-0.5">
                                        <span class="liquid-glass-pill px-1.5 py-0.2 text-[10px] font-semibold">@(b.Room?.RoomCode ?? "-")</span>
                                        <span>&bull;</span>
                                        <span>@(b.Room?.Building ?? "-")</span>
                                    </div>
                                </td>

                                <!-- Borrower -->
                                <td class="py-4 px-6">
                                    <div class="font-semibold text-[#1D1D1F]">@b.BorrowerName</div>
                                    <div class="text-[11px] text-[#86868B] font-mono">@b.BorrowerEmail</div>
                                </td>

                                <!-- Purpose & Timeslot -->
                                <td class="py-4 px-6">
                                    <div class="font-medium text-[#1D1D1F] max-w-xs truncate" title="@b.Purpose">@b.Purpose</div>
                                    <div class="font-mono text-[#515154] text-[11px] mt-1 flex items-center gap-1.5">
                                        <i data-lucide="clock" class="w-3.5 h-3.5 text-[#007AFF]"></i>
                                        <span>@b.StartTime.ToString("dd MMM yyyy HH:mm") — @b.EndTime.ToString("HH:mm") WIB</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(b.AdminNotes))
                                    {
                                        <div class="mt-1.5 p-1.5 px-2.5 rounded-xl bg-black/[0.04] text-[#515154] text-[10px] font-mono border border-black/[0.05]">
                                            Catatan: @b.AdminNotes
                                        </div>
                                    }
                                </td>

                                <!-- Status Badge -->
                                <td class="py-4 px-6">
                                    @switch (b.Status)
                                    {
                                        case SmartRoom.Models.Enums.BookingStatus.Approved:
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-semibold bg-[#34C759]/15 text-[#116329] border border-[#34C759]/30">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#34C759]"></span> Approved
                                            </span>
                                            break;
                                        case SmartRoom.Models.Enums.BookingStatus.Pending:
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-semibold bg-[#FF9500]/15 text-[#7A4500] border border-[#FF9500]/30">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#FF9500]"></span> Pending
                                            </span>
                                            break;
                                        case SmartRoom.Models.Enums.BookingStatus.Rejected:
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-semibold bg-[#FF3B30]/15 text-[#C91E14] border border-[#FF3B30]/30">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#FF3B30]"></span> Rejected
                                            </span>
                                            break;
                                        default:
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-semibold bg-black/[0.05] text-[#515154] border border-black/[0.07]">
                                                Cancelled
                                            </span>
                                            break;
                                    }
                                </td>

                                <!-- Admin Action Buttons (Apple System Green Pill & System Red Pill) -->
                                <td class="py-4 px-6 text-right font-mono">
                                    <div class="flex items-center justify-end gap-2">
                                        @if (b.Status != SmartRoom.Models.Enums.BookingStatus.Approved)
                                        {
                                            <form asp-action="UpdateStatus" method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@b.Id" />
                                                <input type="hidden" name="status" value="@((int)SmartRoom.Models.Enums.BookingStatus.Approved)" />
                                                <button type="submit" 
                                                        class="liquid-btn-approve">
                                                    <i data-lucide="check" class="w-3.5 h-3.5"></i>
                                                    <span>Setujui</span>
                                                </button>
                                            </form>
                                        }

                                        @if (b.Status != SmartRoom.Models.Enums.BookingStatus.Rejected)
                                        {
                                            <button type="button" 
                                                    x-on:click="rejectModalOpen = true; rejectBookingId = @b.Id; rejectBookingRef = '@b.BookingReference'; rejectBorrower = '@b.BorrowerName';"
                                                    class="liquid-btn-reject">
                                                <i data-lucide="x" class="w-3.5 h-3.5"></i>
                                                <span>Tolak</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="py-16 text-center text-[#86868B]">
                <div class="liquid-squircle-icon bg-[#34C759]/15 text-[#34C759] mx-auto mb-3 !w-12 !h-12">
                    <i data-lucide="shield-check" class="w-6 h-6"></i>
                </div>
                <div class="text-sm font-bold text-[#1D1D1F]">Semua Permohonan Selesai Diproses</div>
                <div class="text-xs text-[#86868B] mt-0.5">Tidak ada antrean yang membutuhkan persetujuan saat ini.</div>
            </div>
        }
    </div>

    <!-- Reject Modal Sheet (macOS 27 Inspector Dialog) -->
    <div x-show="rejectModalOpen" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/30 backdrop-blur-md">
        <div x-on:click.outside="rejectModalOpen = false" 
             class="liquid-glass-elevated max-w-md w-full p-6 sm:p-7 shadow-2xl border border-white/90">
            <form asp-action="UpdateStatus" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" :value="rejectBookingId" />
                <input type="hidden" name="status" value="@((int)SmartRoom.Models.Enums.BookingStatus.Rejected)" />

                <div class="flex items-center justify-between pb-3.5 border-b border-black/[0.06]">
                    <div class="flex items-center gap-3">
                        <div class="liquid-squircle-icon bg-[#FF3B30]/15 text-[#FF3B30] !w-8 !h-8">
                            <i data-lucide="x-circle" class="w-4 h-4"></i>
                        </div>
                        <h3 class="text-base font-bold text-[#1D1D1F]">Tolak Pengajuan Peminjaman</h3>
                    </div>
                    <button type="button" x-on:click="rejectModalOpen = false" class="liquid-glass-pill p-1.5 text-[#86868B] hover:text-[#1D1D1F]">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>

                <div class="text-xs text-[#515154] leading-relaxed">
                    Menolak peminjaman referensi <strong class="text-[#1D1D1F] font-mono" x-text="rejectBookingRef"></strong> oleh <strong class="text-[#1D1D1F]" x-text="rejectBorrower"></strong>.
                </div>

                <div>
                    <label class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-[#515154] mb-1.5">
                        Alasan Penolakan <span class="text-[#FF3B30]">*</span>
                    </label>
                    <textarea name="adminNotes" rows="3" 
                              class="liquid-glass-input w-full px-4 py-2.5 text-xs"
                              placeholder="Contoh: Ruangan dialokasikan untuk kegiatan evaluasi mendesak rektorat." required></textarea>
                </div>

                <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-black/[0.06]">
                    <button type="button" x-on:click="rejectModalOpen = false" 
                            class="liquid-btn-secondary px-4 py-2 text-xs">
                        Batal
                    </button>
                    <button type="submit" 
                            class="px-5 py-2 rounded-full bg-[#FF3B30] hover:bg-[#D70015] text-white text-xs font-semibold shadow-md transition-all active:scale-[0.98]">
                        Konfirmasi Penolakan
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.lucide) {
                window.lucide.createIcons();
            }
        });
    </script>
}
