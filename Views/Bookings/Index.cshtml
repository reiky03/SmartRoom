@model IEnumerable<SmartRoom.Models.Booking>
@{
    ViewData["Title"] = "Arsip Peminjaman Menyeluruh";
}

<div class="space-y-7">

    <!-- macOS 27 Hero Header -->
    <div class="liquid-glass-header p-6 sm:p-8 flex flex-col sm:flex-row sm:items-end justify-between gap-6">
        <div class="relative z-10">
            <div class="flex items-center gap-2 mb-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-semibold bg-[#5856D6]/12 text-[#5856D6] border border-[#5856D6]/25">
                    ARSIP &amp; AGENDA TERJADWAL
                </span>
                <span class="text-[#86868B]">&bull;</span>
                <span class="text-xs font-mono text-[#515154]">@Model.Count() Peminjaman Terdata</span>
            </div>
            <h1 class="text-3xl font-bold tracking-tight text-[#1D1D1F] sm:text-4xl">
                Arsip Peminjaman Menyeluruh
            </h1>
            <p class="text-sm text-[#515154] mt-1.5 max-w-xl leading-relaxed">
                Pantau seluruh rekam jejak agenda peminjaman ruangan yang telah diajukan, status verifikasi persetujuan admin, dan transparansi jadwal operasional.
            </p>
        </div>

        <div class="relative z-10 flex-shrink-0">
            <a asp-action="Create" 
               class="liquid-btn-primary">
                <i data-lucide="plus" class="w-4 h-4 text-white"></i>
                <span>Ajukan Peminjaman</span>
            </a>
        </div>
    </div>

    <!-- Filter Bar Card (macOS 27 Control Shelf) -->
    <div class="liquid-glass-card p-5 sm:p-6">
        <form method="get" asp-action="Index" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
            <div>
                <label class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-[#515154] mb-1.5">Filter Ruangan</label>
                <select name="roomId" class="liquid-glass-input w-full px-3.5 py-2 text-xs" asp-items="ViewBag.Rooms">
                    <option value="">— Semua Ruangan —</option>
                </select>
            </div>

            <div>
                <label class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-[#515154] mb-1.5">Status Peminjaman</label>
                <select name="status" class="liquid-glass-input w-full px-3.5 py-2 text-xs">
                    <option value="">— Semua Status —</option>
                    <option value="0" selected="@(ViewBag.CurrentStatus?.ToString() == "Pending")">Menunggu (Pending)</option>
                    <option value="1" selected="@(ViewBag.CurrentStatus?.ToString() == "Approved")">Disetujui (Approved)</option>
                    <option value="2" selected="@(ViewBag.CurrentStatus?.ToString() == "Rejected")">Ditolak (Rejected)</option>
                    <option value="3" selected="@(ViewBag.CurrentStatus?.ToString() == "Cancelled")">Dibatalkan (Cancelled)</option>
                </select>
            </div>

            <div>
                <label class="block text-[11px] font-mono uppercase tracking-wider font-semibold text-[#515154] mb-1.5">Tanggal Pelaksanaan</label>
                <input type="date" name="date" value="@ViewBag.CurrentDate" 
                       class="liquid-glass-input w-full px-3.5 py-2 text-xs font-mono" />
            </div>

            <div class="flex items-center gap-2">
                <button type="submit" 
                        class="liquid-btn-primary flex-1 py-2 text-xs flex items-center justify-center gap-2">
                    <i data-lucide="filter" class="w-3.5 h-3.5 text-white"></i>
                    <span>Terapkan Filter</span>
                </button>
                <a asp-action="Index" class="liquid-glass-pill p-2 hover:bg-white text-[#515154] transition-colors shadow-sm" title="Reset Filter">
                    <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Bookings Table Card -->
    <div class="liquid-glass-card overflow-hidden">
        @if (Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-white/40 border-b border-black/[0.06] text-[11px] font-mono uppercase tracking-wider text-[#86868B]">
                            <th class="py-3.5 px-6">Referensi</th>
                            <th class="py-3.5 px-6">Ruangan &amp; Gedung</th>
                            <th class="py-3.5 px-6">Pemohon</th>
                            <th class="py-3.5 px-6">Agenda / Keperluan</th>
                            <th class="py-3.5 px-6">Jadwal Penggunaan</th>
                            <th class="py-3.5 px-6">Status</th>
                            <th class="py-3.5 px-6">Catatan Admin</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-black/[0.04] text-xs text-[#515154]">
                        @foreach (var b in Model)
                        {
                            <tr class="hover:bg-white/50 transition-colors">
                                <!-- Reference -->
                                <td class="py-4 px-6 font-mono">
                                    <div class="flex items-center gap-1.5">
                                        <span class="font-bold text-[#1D1D1F]">@b.BookingReference</span>
                                        <button type="button" onclick="navigator.clipboard.writeText('@b.BookingReference')" 
                                                class="text-[#86868B] hover:text-[#007AFF] p-0.5 rounded transition-colors" title="Salin ID Referensi">
                                            <i data-lucide="copy" class="w-3 h-3"></i>
                                        </button>
                                    </div>
                                    <div class="text-[10px] text-[#86868B] font-mono mt-0.5">@b.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>

                                <!-- Room -->
                                <td class="py-4 px-6">
                                    <div class="font-bold text-[#1D1D1F]">@(b.Room?.Name ?? $"Ruangan #{b.RoomId}")</div>
                                    <div class="text-[11px] font-mono text-[#86868B] flex items-center gap-1 mt-0.5">
                                        <span class="liquid-glass-pill px-1.5 py-0.2 text-[10px] font-semibold">@(b.Room?.RoomCode ?? "-")</span>
                                        <span>&bull;</span>
                                        <span>@(b.Room?.Building ?? "-")</span>
                                    </div>
                                </td>

                                <!-- Borrower -->
                                <td class="py-4 px-6">
                                    <div class="font-semibold text-[#1D1D1F]">@b.BorrowerName</div>
                                    <div class="text-[11px] text-[#86868B] font-mono">@b.BorrowerEmail</div>
                                </td>

                                <!-- Purpose -->
                                <td class="py-4 px-6 max-w-xs truncate" title="@b.Purpose">
                                    <span class="text-[#1D1D1F] font-medium">@b.Purpose</span>
                                </td>

                                <!-- Schedule -->
                                <td class="py-4 px-6 font-mono">
                                    <div class="font-bold text-[#1D1D1F]">
                                        @b.StartTime.ToString("dd MMM yyyy")
                                    </div>
                                    <div class="text-[11px] text-[#515154] mt-0.5">
                                        @b.StartTime.ToString("HH:mm") — @b.EndTime.ToString("HH:mm") WIB
                                    </div>
                                </td>

                                <!-- Status Badge -->
                                <td class="py-4 px-6">
                                    @switch (b.Status)
                                    {
                                        case SmartRoom.Models.Enums.BookingStatus.Approved:
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-semibold bg-[#34C759]/15 text-[#116329] border border-[#34C759]/30">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#34C759]"></span> Approved
                                            </span>
                                            break;
                                        case SmartRoom.Models.Enums.BookingStatus.Pending:
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-semibold bg-[#FF9500]/15 text-[#7A4500] border border-[#FF9500]/30">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#FF9500]"></span> Pending
                                            </span>
                                            break;
                                        case SmartRoom.Models.Enums.BookingStatus.Rejected:
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-semibold bg-[#FF3B30]/15 text-[#C91E14] border border-[#FF3B30]/30">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#FF3B30]"></span> Rejected
                                            </span>
                                            break;
                                        default:
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-semibold bg-black/[0.05] text-[#515154] border border-black/[0.07]">
                                                Cancelled
                                            </span>
                                            break;
                                    }
                                </td>

                                <!-- Admin Notes -->
                                <td class="py-4 px-6 text-xs text-[#86868B]">
                                    @if (!string.IsNullOrWhiteSpace(b.AdminNotes))
                                    {
                                        <div class="liquid-glass-subtle p-2 rounded-xl text-[11px] font-mono max-w-[200px] truncate" title="@b.AdminNotes">
                                            @b.AdminNotes
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-[#86868B]/60">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="py-16 text-center text-[#86868B]">
                <i data-lucide="calendar" class="w-12 h-12 mx-auto mb-3 opacity-30 text-[#007AFF]"></i>
                <div class="text-sm font-semibold text-[#1D1D1F]">Tidak Ada Catatan Peminjaman Ditemukan</div>
                <div class="text-xs text-[#86868B] mt-0.5">Coba ubah kriteria filter ruangan atau tanggal di atas.</div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.lucide) {
                window.lucide.createIcons();
            }
        });
    </script>
}
