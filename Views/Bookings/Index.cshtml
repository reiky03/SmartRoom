@model IEnumerable<SmartRoom.Models.Booking>
@{
    ViewData["Title"] = "Daftar Peminjaman Ruangan";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-calendar-check-fill text-primary me-2"></i>Daftar Peminjaman
        </h2>
        <p class="text-muted mb-0">Daftar riwayat dan jadwal peminjaman ruangan yang telah diajukan.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i> Ajukan Peminjaman Baru
        </a>
    </div>
</div>

<!-- Filter Box -->
<div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Pilih Ruangan</label>
                <select name="roomId" class="form-select form-select-sm" asp-items="ViewBag.Rooms">
                    <option value="">-- Semua Ruangan --</option>
                </select>
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label small text-muted mb-1">Status Peminjaman</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">-- Semua Status --</option>
                    <option value="0" selected="@(ViewBag.CurrentStatus?.ToString() == "Pending")">Pending (Menunggu)</option>
                    <option value="1" selected="@(ViewBag.CurrentStatus?.ToString() == "Approved")">Approved (Disetujui)</option>
                    <option value="2" selected="@(ViewBag.CurrentStatus?.ToString() == "Rejected")">Rejected (Ditolak)</option>
                    <option value="3" selected="@(ViewBag.CurrentStatus?.ToString() == "Cancelled")">Cancelled (Dibatalkan)</option>
                </select>
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label small text-muted mb-1">Tanggal</label>
                <input type="date" name="date" value="@ViewBag.CurrentDate" class="form-control form-control-sm" />
            </div>

            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary rounded-pill w-100">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill" title="Reset Filter">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bookings Table -->
<div class="card shadow-sm border-0 bg-white">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-custom">
                        <tr>
                            <th class="ps-4">No. Referensi</th>
                            <th>Ruangan</th>
                            <th>Peminjam</th>
                            <th>Tujuan</th>
                            <th>Jadwal Peminjaman</th>
                            <th>Status</th>
                            <th>Catatan Admin</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-semibold text-dark font-monospace">@b.BookingReference</span>
                                    <div class="text-muted" style="font-size: 0.75rem;">@b.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@(b.Room?.Name ?? "Ruangan #"+b.RoomId)</div>
                                    <small class="text-muted">@(b.Room?.Building ?? "-") (@(b.Room?.RoomCode ?? "-"))</small>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">@b.BorrowerName</div>
                                    <small class="text-muted">@b.BorrowerEmail</small>
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block" style="max-width: 220px;" title="@b.Purpose">
                                        @b.Purpose
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">
                                        <i class="bi bi-calendar3 me-1 text-primary"></i>
                                        @b.StartTime.ToString("dd MMM yyyy")
                                    </div>
                                    <div class="small text-muted">
                                        <i class="bi bi-clock me-1"></i>
                                        @b.StartTime.ToString("HH:mm") - @b.EndTime.ToString("HH:mm")
                                    </div>
                                </td>
                                <td>
                                    @switch (b.Status)
                                    {
                                        case BookingStatus.Pending:
                                            <span class="badge badge-status-pending px-3 py-2 rounded-pill">
                                                <i class="bi bi-hourglass-split me-1"></i> Pending
                                            </span>
                                            break;
                                        case BookingStatus.Approved:
                                            <span class="badge badge-status-approved px-3 py-2 rounded-pill">
                                                <i class="bi bi-check-circle-fill me-1"></i> Approved
                                            </span>
                                            break;
                                        case BookingStatus.Rejected:
                                            <span class="badge badge-status-rejected px-3 py-2 rounded-pill">
                                                <i class="bi bi-x-circle-fill me-1"></i> Rejected
                                            </span>
                                            break;
                                        case BookingStatus.Cancelled:
                                            <span class="badge badge-status-cancelled px-3 py-2 rounded-pill">
                                                <i class="bi bi-slash-circle me-1"></i> Cancelled
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <small class="text-secondary">
                                        @(string.IsNullOrWhiteSpace(b.AdminNotes) ? "-" : b.AdminNotes)
                                    </small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox text-muted display-4 mb-3 d-block"></i>
                <h6 class="text-dark fw-bold">Tidak Ada Data Peminjaman</h6>
                <p class="text-muted small">Tidak ditemukan data peminjaman yang cocok dengan filter yang dipilih.</p>
            </div>
        }
    </div>
</div>
