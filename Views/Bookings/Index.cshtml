@model IEnumerable<SmartRoom.Models.Booking>
@{
    ViewData["Title"] = "Jadwal & Riwayat Peminjaman";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-light text-muted border font-mono" style="font-size: 0.7rem;">KALENDER &amp; AGENDA</span>
            <span class="text-muted small">&bull;</span>
            <span class="text-muted small font-mono">@Model.Count() PENGAJUAN</span>
        </div>
        <h2 class="fw-bold text-dark mb-0 tracking-tight" style="font-size: 1.65rem;">
            Daftar &amp; Riwayat Peminjaman
        </h2>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Create" class="btn btn-minimal-primary d-inline-flex align-items-center gap-1.5">
            <i class="bi bi-calendar-plus"></i>
            <span>Ajukan Peminjaman</span>
        </a>
    </div>
</div>

<!-- Minimal Search / Filter Bar -->
<div class="card-minimal p-3 bg-white mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label font-mono text-muted small mb-1" style="font-size: 0.72rem;">FILTER RUANGAN</label>
            <select name="roomId" class="form-select form-select-sm" asp-items="ViewBag.Rooms">
                <option value="">— Semua Ruangan —</option>
            </select>
        </div>

        <div class="col-12 col-md-3">
            <label class="form-label font-mono text-muted small mb-1" style="font-size: 0.72rem;">STATUS JADWAL</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">— Semua Status —</option>
                <option value="0" selected="@(ViewBag.CurrentStatus?.ToString() == "Pending")">Pending (Menunggu)</option>
                <option value="1" selected="@(ViewBag.CurrentStatus?.ToString() == "Approved")">Approved (Disetujui)</option>
                <option value="2" selected="@(ViewBag.CurrentStatus?.ToString() == "Rejected")">Rejected (Ditolak)</option>
                <option value="3" selected="@(ViewBag.CurrentStatus?.ToString() == "Cancelled")">Cancelled (Dibatalkan)</option>
            </select>
        </div>

        <div class="col-12 col-md-3">
            <label class="form-label font-mono text-muted small mb-1" style="font-size: 0.72rem;">TANGGAL</label>
            <input type="date" name="date" value="@ViewBag.CurrentDate" class="form-control form-control-sm font-mono" />
        </div>

        <div class="col-12 col-md-2 d-flex gap-1.5">
            <button type="submit" class="btn btn-sm btn-minimal-primary w-100 py-1.5">
                <i class="bi bi-funnel me-1"></i> Terapkan
            </button>
            <a asp-action="Index" class="btn btn-sm btn-minimal-secondary py-1.5 px-2.5" title="Reset">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Bookings Table -->
<div class="card-minimal bg-white overflow-hidden">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table-minimal">
                <thead>
                    <tr>
                        <th>No. Referensi</th>
                        <th>Ruangan &amp; Lokasi</th>
                        <th>Peminjam</th>
                        <th>Agenda &amp; Tujuan</th>
                        <th>Jadwal Pelaksanaan</th>
                        <th>Status</th>
                        <th>Catatan Admin</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td>
                                <span class="font-mono fw-semibold text-dark">@b.BookingReference</span>
                                <div class="text-muted font-mono" style="font-size: 0.7rem;">@b.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td>
                                <div class="fw-medium text-dark">@(b.Room?.Name ?? $"Ruangan #{b.RoomId}")</div>
                                <div class="text-muted font-mono" style="font-size: 0.72rem;">@(b.Room?.RoomCode ?? "-") &bull; @(b.Room?.Building ?? "-")</div>
                            </td>
                            <td>
                                <div class="fw-medium text-dark">@b.BorrowerName</div>
                                <div class="text-muted small" style="font-size: 0.75rem;">@b.BorrowerEmail</div>
                            </td>
                            <td>
                                <span class="text-truncate d-inline-block" style="max-width: 220px;" title="@b.Purpose">
                                    @b.Purpose
                                </span>
                            </td>
                            <td>
                                <div class="font-mono text-dark fw-medium">
                                    <i class="bi bi-calendar3 me-1 text-muted"></i>@b.StartTime.ToString("dd MMM yyyy")
                                </div>
                                <div class="text-muted font-mono" style="font-size: 0.72rem;">
                                    <i class="bi bi-clock me-1"></i>@b.StartTime.ToString("HH:mm") — @b.EndTime.ToString("HH:mm")
                                </div>
                            </td>
                            <td>
                                @switch (b.Status)
                                {
                                    case SmartRoom.Models.Enums.BookingStatus.Pending:
                                        <span class="badge-pill-soft badge-soft-pending">
                                            <i class="bi bi-hourglass-split"></i> Pending
                                        </span>
                                        break;
                                    case SmartRoom.Models.Enums.BookingStatus.Approved:
                                        <span class="badge-pill-soft badge-soft-approved">
                                            <i class="bi bi-check2"></i> Approved
                                        </span>
                                        break;
                                    case SmartRoom.Models.Enums.BookingStatus.Rejected:
                                        <span class="badge-pill-soft badge-soft-rejected">
                                            <i class="bi bi-x"></i> Rejected
                                        </span>
                                        break;
                                    case SmartRoom.Models.Enums.BookingStatus.Cancelled:
                                        <span class="badge-pill-soft badge-soft-cancelled">
                                            Cancelled
                                        </span>
                                        break;
                                }
                            </td>
                            <td>
                                <span class="text-secondary small" style="font-size: 0.78rem;">
                                    @(string.IsNullOrWhiteSpace(b.AdminNotes) ? "—" : b.AdminNotes)
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="py-5 text-center text-muted">
            <i class="bi bi-inbox display-6 text-muted mb-2 d-block opacity-25"></i>
            <h6 class="fw-bold text-dark">Tidak Ada Data Peminjaman</h6>
            <p class="text-muted small mb-0">Tidak ditemukan permohonan yang sesuai kriteria pencarian.</p>
        </div>
    }
</div>
